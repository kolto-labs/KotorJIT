     def release_lock(self) -> None:
         if self.lock_path is None:
             return
         info = self._read_lock(self.lock_path)
         if info and info["pid"] == str(os.getpid()):
             try:
                 self.lock_path.unlink()
             except OSError:
                 pass
         self.lock_path = None
