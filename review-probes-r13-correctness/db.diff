+def decode_levels(values, period: int) -> dict:
+    """Rank-decode yavg values into ``period`` brightness levels, split at the ``period - 1`` largest gaps.
+
+    Only the order of the levels is used (a brighter level has a larger yavg), never
+    their luma scale. ``minimum_level_gap`` is the smallest split gap, and
+    ``maximum_within_level_gap`` the largest gap left inside a level.
+    """
+    ordered = sorted(values)
+    if len(ordered) < period:
+        return {"thresholds": None, "centers": None, "minimum_level_gap": None,
+                "maximum_within_level_gap": None, "resolution": None}
+    gaps = [(ordered[index + 1] - ordered[index], index) for index in range(len(ordered) - 1)]
+    chosen = sorted(gaps, key=lambda item: (-item[0], item[1]))[:period - 1]
+    cuts = sorted(index for _, index in chosen)
+    cut_set = set(cuts)
+    thresholds = [(ordered[index] + ordered[index + 1]) / 2 for index in cuts]
+    groups, begin = [], 0
+    for index in cuts:
+        groups.append(ordered[begin:index + 1]); begin = index + 1
+    groups.append(ordered[begin:])
+    centers = [(group[(len(group) - 1) // 2] + group[len(group) // 2]) / 2 for group in groups]
+    level_gap = min(gap for gap, _ in chosen)
+    within = max((gap for gap, index in gaps if index not in cut_set), default=0.0)
+    return {"thresholds": thresholds, "centers": centers, "minimum_level_gap": level_gap,
+            "maximum_within_level_gap": within,
+            "resolution": (level_gap / within) if within > 0 else None}
+
+
+def content_level_sequence(yavg, values, pts, indices, policy) -> dict:
+    """Pattern check: each fresh acceptance frame steps +``level_step`` levels (mod ``level_period``).
+
+    ``yavg`` and ``pts`` cover the acceptance frames; ``values[k]`` is the max DIF of
+    acceptance frame ``k + 1`` against frame ``k``. A frame is fresh when its level
+    steps and a duplicate when the level repeats. Any other step is a violation. So
+    is a clearly fresh difference (at or above floor * separation_factor) without a
+    step, or a clearly duplicate difference (at or below floor / separation_factor)
+    with one. Differences inside the guard band are left to the separation rule.
+    """
+    period, step = policy["level_period"], policy["level_step"]
+    factor = policy["level_resolution_factor"]
+    floor, separation = policy["distinct_noise_floor"], policy["separation_factor"]
+    low, high = floor / separation, floor * separation
+    half = period // 2
+    ladder = decode_levels(yavg, period)
+    ladder["resolved"] = bool(ladder["minimum_level_gap"] is not None and ladder["minimum_level_gap"] > 0
+                              and ladder["minimum_level_gap"] >= factor * ladder["maximum_within_level_gap"])
+    result = {"rule": "every fresh acceptance frame steps +%d levels (mod %d) from the previous frame; "
+                      "a duplicate repeats the level" % (step, period),
+              "method": "yavg-rank-largest-gaps-v1", "period": period, "step": step,
+              "resolution_factor": factor, "ladder": ladder, "level_histogram": None,
+              "steps": 0, "repeats": 0, "violation_count": 0, "violations": [],
+              "status": "failed", "reason": None}
+    if ladder["thresholds"] is None:
+        result["reason"] = ("%d acceptance frames cannot decode %d brightness levels" % (len(yavg), period))
+        return result
+    levels = [sum(1 for threshold in ladder["thresholds"] if value > threshold) - half for value in yavg]
+    result["level_histogram"] = [{"level": level, "count": levels.count(level)}
+                                 for level in range(-half, period - half)]
+    violations = []
+    for position in range(1, len(levels)):
+        delta = (levels[position] - levels[position - 1]) % period
+        difference = values[position - 1]
+        if delta == step and difference > low:
+            result["steps"] += 1
+            continue
+        if delta == 0 and difference < high:
+            result["repeats"] += 1
+            continue
+        kind = ("step" if delta not in (0, step) else
+                "fresh_difference_without_step" if delta == 0 else "duplicate_difference_with_step")
+        violations.append({"index": indices[position], "pts_seconds": pts[position],
+                           "previous_level": levels[position - 1], "level": levels[position],
+                           "step": delta, "difference": difference, "kind": kind})
+    result["violation_count"] = len(violations)
+    result["violations"] = violations[:MAX_RECORDED_LEVEL_VIOLATIONS]
+    if not ladder["resolved"]:
+        result["reason"] = ("acceptance frames do not decode to %d separated brightness levels "
+                            "(level gap / within-level gap %s, need %s)"
+                            % (period, "undefined" if ladder["resolution"] is None
+                               else "%.3f" % ladder["resolution"], factor))
+    elif violations:
+        result["reason"] = ("%d of %d acceptance frames break the +%d level step (mod %d)"
+                            % (len(violations), len(levels) - 1, step, period))
+    else:
+        result["status"] = "passed"
+    return result
+
