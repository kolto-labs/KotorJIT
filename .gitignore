# Build output
/build/
/out/
*.o
*.a
*.dll
*.so
*.exe
*.pdb

# Harness scratch: wine prefixes, game copies, screenshots, logs
/tmp/
/tmp_*.log

# Third-party sources are fetched, not vendored
/third_party/

# Never commit game content or binaries
*.bif
*.key
*.mod
*.rim
*.erf
*.tlk
*.bik

# Ghidra decompile scratch: a project built directly from the game binary
# (full disassembly/decompilation database). Never commit this -- it's a
# working area for agentdecompile-cli, same category as /build/ and /tmp/.
/agentdecompile_projects/

__pycache__/
*.pyc
.venv/

# Local Cursor/MCP session leftovers
uninstalled-mcp-plugins.txt
.claude/
.cursor/
.mission/
.remember/
AGENTS.md
CLAUDE.md
