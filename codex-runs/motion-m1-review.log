     3	// Native adapter: Windows i386 only (the one profile is K1 GOG). Every other
     4	// host gets no adapter, so no engine address is ever called there.
     5	namespace kp::api::motion {
     6	#if defined(_WIN32) && defined(__i386__)
     7	namespace {
     8	class Native final : public Backend {
     9	public:
    10	    model::Reader reader = nullptr; void* context = nullptr;
    11	    Abi abi() const override { return Abi::Win32; }
    12	    unsigned width() const override { return 4; }
    13	    bool read(Address address, void* out, std::size_t size) const override {
    14	        if (!reader || address > std::numeric_limits<std::uintptr_t>::max() ||
    15	            size > std::numeric_limits<std::uintptr_t>::max() - address) return false;
    16	        return reader(address, out, size, context);
    17	    }
    18	    // CServerExoApp::GetPlaceableByGameObjectID: thiscall(this, uint32), ret 4.
    19	    Address placeable(Address f, Address server, std::uint32_t id) override {
    20	        using Call = void*(__attribute__((thiscall)) *)(void*, std::uint32_t);
    21	        void* result = reinterpret_cast<Call>(static_cast<std::uintptr_t>(f))(
    22	            reinterpret_cast<void*>(static_cast<std::uintptr_t>(server)), id);
    23	        return reinterpret_cast<std::uintptr_t>(result);
    24	    }
    25	};
    26	}
    27	#endif
    28	Backend* native_backend(model::Reader read, void* context) {
    29	#if defined(_WIN32) && defined(__i386__)
    30	    static Native native; native.reader = read; native.context = context; return &native;
    31	#else
    32	    (void)read; (void)context; return nullptr;
    33	#endif
    34	}
    35	bool bind_native(const std::string& sha, Address base, model::Reader read, void* context, std::string& error) {
    36	    operations().unbind();
    37	    if (!read) { error = "unsupported: motion binding requires a fallible reader"; return false; }
    38	    Backend* native = native_backend(read, context);
    39	    if (!native) { error = "unsupported: no native motion adapter for host OS/architecture"; return false; }
    40	    return operations().bind(sha, base, native, error);
    41	}
