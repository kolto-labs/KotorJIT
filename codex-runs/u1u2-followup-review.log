   200	// -------------------------------------------------------------- methods ---
   201	
   202	V3 self(lua_State* L, const char* who) {
   203	    if (lua_type(L, 1) != LUA_TTABLE)
   204	        luaL_error(L, "%s: call it as a method, v:%s(...) (got %s for self)", who,
   205	                   who + sizeof("kp.vec:") - 1, luaL_typename(L, 1));
   206	    return read_vec(L, 1, who, "self");
   207	}
   208	
   209	int m_length(lua_State* L) {
   210	    const V3 v = self(L, "kp.vec:length");
   211	    return push_scalar(L, std::sqrt(dot(v, v)), "kp.vec:length");
   212	}
   213	
   214	int m_lengthsq(lua_State* L) {
   215	    const V3 v = self(L, "kp.vec:lengthsq");
   216	    return push_scalar(L, dot(v, v), "kp.vec:lengthsq");
   217	}
   218	
   219	int m_normalize(lua_State* L) {
   220	    const V3 v = self(L, "kp.vec:normalize");
   221	    const lua_Number len = std::sqrt(dot(v, v));
   222	    // An overflowed length would divide every axis to zero, and an underflowed
   223	    // one would read as the zero vector. Both raise; only a true zero vector
   224	    // normalises to zero.
   225	    if (!std::isfinite(len))
   226	        return luaL_error(L, "kp.vec:normalize: length is not finite");
   227	    if (len == 0) {
   228	        if (v.x != 0 || v.y != 0 || v.z != 0)
   229	            return luaL_error(L, "kp.vec:normalize: length underflows to zero");
   230	        return push_vec(L, {0, 0, 0}, "kp.vec:normalize");
   231	    }
   232	    return push_vec(L, {v.x / len, v.y / len, v.z / len}, "kp.vec:normalize");
   233	}
   234	
   235	int m_dot(lua_State* L) {
   236	    const V3 a = self(L, "kp.vec:dot");
   237	    const V3 b = read_vec(L, 2, "kp.vec:dot", "other");
   238	    return push_scalar(L, dot(a, b), "kp.vec:dot");
   239	}
   240	
   241	int m_cross(lua_State* L) {
   242	    const V3 a = self(L, "kp.vec:cross");
   243	    const V3 b = read_vec(L, 2, "kp.vec:cross", "other");
   244	    return push_vec(L, {a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x},
   245	                    "kp.vec:cross");
   246	}
   247	
   248	int m_distancesq(lua_State* L) {
   249	    const V3 a = self(L, "kp.vec:distancesq");
   250	    const V3 b = read_vec(L, 2, "kp.vec:distancesq", "other");
   251	    const V3 d{a.x - b.x, a.y - b.y, a.z - b.z};
   252	    return push_scalar(L, dot(d, d), "kp.vec:distancesq");
   253	}
   254	
   255	int m_distance(lua_State* L) {
   256	    const V3 a = self(L, "kp.vec:distance");
   257	    const V3 b = read_vec(L, 2, "kp.vec:distance", "other");
   258	    const V3 d{a.x - b.x, a.y - b.y, a.z - b.z};
   259	    return push_scalar(L, std::sqrt(dot(d, d)), "kp.vec:distance");
   260	}
   261	
   262	// a + (b - a) * t, written so t = 0 and t = 1 return the endpoints exactly.
   263	int m_lerp(lua_State* L) {
   264	    const V3 a = self(L, "kp.vec:lerp");
   265	    const V3 b = read_vec(L, 2, "kp.vec:lerp", "other");
   266	    const lua_Number t = read_scalar(L, 3, "kp.vec:lerp", "t");
   267	    const lua_Number s = 1 - t;
   268	    return push_vec(L, {a.x * s + b.x * t, a.y * s + b.y * t, a.z * s + b.z * t},
   269	                    "kp.vec:lerp");
   270	}
