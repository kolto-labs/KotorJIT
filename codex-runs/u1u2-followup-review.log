   311	void register_vector(lua_State* L) {
   312	    // Once per state. A second call (the runtime and the console both calling
   313	    // a shared initialiser) reuses the metatable rather than splitting vecs
   314	    // made before and after it into two incompatible kinds.
   315	    if (luaL_newmetatable(L, kMeta)) {
   316	        luaL_register(L, nullptr, kOperators);
   317	        lua_createtable(L, 0, int(sizeof kMethods / sizeof kMethods[0]) - 1);
   318	        luaL_register(L, nullptr, kMethods);
   319	        lua_setfield(L, -2, "__index");
   320	        lua_pushstring(L, kProtect);
   321	        lua_setfield(L, -2, "__metatable");
   322	    }
   323	    lua_pop(L, 1);
   324	
   325	    push_kp_table(L);
   326	    lua_pushcfunction(L, l_vec);
   327	    lua_setfield(L, -2, "vec");
   328	    lua_pop(L, 1);
   329	}
