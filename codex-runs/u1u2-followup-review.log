   189	    // the stack the call keeps it alive, whatever the callback does to its
   190	    // own timer. A name is looked up now, as it always was, but inside a
   191	    // protected call: _G's __index is script code and may raise.
   192	    if (fn_ref != LUA_NOREF) {
   193	        lua_rawgeti(L, LUA_REGISTRYINDEX, fn_ref);
   194	    } else {
   195	        lua_pushcfunction(L, lookup_global);
   196	        lua_pushstring(L, callback.c_str());
   197	        g_firing_id = id;              // removetimer(id) from __index raises,
   198	        g_firing_state = L;            // as it would from the callback itself
   199	        const int lrc = lua_pcall(L, 1, 1, base + 1);
   200	        g_firing_id = 0;
   201	        g_firing_state = nullptr;
   202	        if (lrc != 0) {
   203	            // Charged like a throw from the callback; the callback never ran,
   204	            // so this is not counted as a firing.
   205	            report_error(L, callback, lua_tostring(L, -1), game_tick);
   206	            lua_settop(L, base);
   207	            cancel_timer(id);
   208	            return false;
   209	        }
   210	    }
   211	    // __index may have registered or cancelled timers. Re-read the entry
   212	    // rather than trust anything taken from it before the lookup.
   213	    auto live = g_timers.find(id);
   214	    if (live == g_timers.end()) { lua_settop(L, base); return false; }
   215	    const int ud_ref = live->second.userdata_ref;
   216	    if (!lua_isfunction(L, -1)) {
   217	        lua_settop(L, base);
   218	        // Phasor resolves the name at fire time too, so a typo is invisible
   219	        // until the timer expires. Kept, because the alternative is refusing to
   220	        // register a callback a script has not defined yet -- which is the
   221	        // normal case when the chunk registers timers before defining them.
   222	        report_error(L, callback, "callback is not a global function", game_tick);
   223	        cancel_timer(id);
   224	        return false;
   225	    }
   226	
   227	    lua_pushnumber(L, lua_Number(id));
   228	    lua_pushnumber(L, lua_Number(count));
   229	    if (ud_ref == LUA_NOREF) lua_pushnil(L);
   230	    else                     lua_rawgeti(L, LUA_REGISTRYINDEX, ud_ref);
   231	
   232	    g_firing_id = id;
   233	    g_firing_state = L;
   234	    const int rc = lua_pcall(L, 3, 1, base + 1);
   235	    g_firing_id = 0;
   236	    g_firing_state = nullptr;
   237	
   238	    if (rc != 0) {
   239	        const char* msg = lua_tostring(L, -1);
   240	        report_error(L, callback, msg, game_tick);
   241	        lua_settop(L, base);
   242	        cancel_timer(id);
   243	        return true;
   244	    }
   245	
   246	    // Renewal follows the same rule as an event result in src/lua/value.cpp:
   247	    // a boolean is itself, a number is compared against 1. Returning 2 stops
   248	    // the timer. Widening that would make the two places disagree about what
   249	    // "true" means, which is worse than the surprise.
   250	    bool renew = false;
   251	    if (lua_isboolean(L, -1))     renew = lua_toboolean(L, -1) != 0;
   252	    else if (lua_isnumber(L, -1)) renew = lua_tonumber(L, -1) == 1;
   253	    lua_settop(L, base);
   254	
   255	    auto again = g_timers.find(id);
   256	    if (again == g_timers.end()) return true;
   257	    if (renew) again->second.due_ms = now + again->second.delay_ms;
   258	    else       cancel_timer(id);
   259	    return true;
   260	}
   261	
   262	// ------------------------------------------------------------ lua surface ---
   263	
   264	int l_registertimer(lua_State* L) {
   265	    const int argc = lua_gettop(L);
   266	    if (argc < 2)
   267	        return luaL_error(L, "kp.registertimer expects at least 2 arguments (got %d)", argc);
   268	    if (argc > 3)
   269	        return luaL_error(L, "kp.registertimer expects at most 3 arguments (got %d)", argc);
   270	
   271	    // Finite, and no more than 2^32 - 1 ms (about 49.7 days). NaN would never
   272	    // come due; infinity and anything past 2^64 are undefined behaviour in the
   273	    // conversion below and in practice fired at once. The cap keeps the cast
   274	    // defined and clock() + delay far from overflow.
   275	    const lua_Number delay = luaL_checknumber(L, 1);
   276	    if (!std::isfinite(delay) || !(delay >= 0) || delay > lua_Number(timers::kMaxDelayMs))
   277	        return luaL_argerror(L, 1, "delay must be a finite number of milliseconds "
   278	                                   "from 0 to 4294967295");
   279	    const int cb_type = lua_type(L, 2);
   280	    if (cb_type != LUA_TSTRING && cb_type != LUA_TFUNCTION)
   281	        return luaL_argerror(L, 2, lua_pushfstring(L, "expected string or function, got %s",
   282	                                                   luaL_typename(L, 2)));
   283	    if (Sentinel* s = sentinel_of(L); s != nullptr && s->closing)
   284	        return luaL_error(L, "kp.registertimer: this script's state is closing");
   285	
   286	    // A function is labelled by where it was defined. The label is what an
   287	    // error is charged to, so every timer made from one closure definition
   288	    // shares one error budget, exactly as every timer naming one global does.
   289	    // Built before anything C++ is constructed: lua_pushfstring can raise.
   290	    // A C function has no source line (every one is "[C]:-1"), so it is
   291	    // labelled by its address instead: one C function, one budget.
   292	    const char* name = nullptr;
   293	    if (cb_type == LUA_TFUNCTION) {
   294	        if (lua_iscfunction(L, 2)) {
   295	            name = lua_pushfstring(L, "function [C] %p", lua_topointer(L, 2));
   296	        } else {
   297	            lua_Debug ar;
   298	            lua_pushvalue(L, 2);             // ">S" pops the function it reads
   299	            lua_getinfo(L, ">S", &ar);
   300	            name = lua_pushfstring(L, "function %s:%d", ar.short_src, ar.linedefined);
   301	        }
   302	    } else {
   303	        name = lua_tostring(L, 2);
   304	    }
   305	
   306	    // Argument checks are done. What can still raise is the two luaL_ref
   307	    // calls below, and only on out-of-memory; if the second one does, the
   308	    // first reference is held until the state closes. No C++ object with a
   309	    // destructor exists until after them, so a longjmp here leaks nothing else.
   310	    lua_State*  owner = owner_state(L);
   311	
   312	    // Exactly one userdata value, held as a registry reference so a table
   313	    // survives until the timer fires. nil in the slot is the same as omitting
   314	    // it, which is what makes registertimer(ms, name, maybe_nil) safe to write.
   315	    int ref = LUA_NOREF;
   316	    if (argc == 3 && !lua_isnil(L, 3)) {
   317	        lua_pushvalue(L, 3);
   318	        ref = luaL_ref(L, LUA_REGISTRYINDEX);
   319	    }
   320	    int fn_ref = LUA_NOREF;
   321	    if (cb_type == LUA_TFUNCTION) {
   322	        lua_pushvalue(L, 2);
   323	        fn_ref = luaL_ref(L, LUA_REGISTRYINDEX);
   324	    }
   325	
   326	    const std::uint64_t id = g_next_id++;
   327	    Timer t;
   328	    t.id = id;
   329	    t.L = owner;
   330	    t.callback = name;
   331	    t.delay_ms = std::uint64_t(delay);
   332	    t.due_ms = timers::clock() + t.delay_ms;
   333	    t.userdata_ref = ref;
   334	    t.callback_ref = fn_ref;
   335	    g_timers.emplace(id, std::move(t));
   336	
   337	    lua_pushnumber(L, lua_Number(id));
   338	    return 1;
   339	}
   340	
   341	int l_removetimer(lua_State* L) {
   342	    const int argc = lua_gettop(L);
   343	    if (argc > 1)
   344	        return luaL_error(L, "kp.removetimer expects at most 1 argument (got %d)", argc);
   345	
   346	    // Deliberately forgiving, matching Phasor: no argument, nil, a non-number,
   347	    // an unknown id and another script's id are all ignored. Cancelling a timer
   348	    // that has already fired is the normal case, not an error.
   349	    if (argc == 0 || lua_isnil(L, 1) || !lua_isnumber(L, 1)) return 0;
   350	    const lua_Number raw = lua_tonumber(L, 1);
   351	    if (!(raw >= 0) || !(raw < 18446744073709551616.0)) return 0;   // cast stays defined
   352	    const auto id = std::uint64_t(raw);
   353	
   354	    auto it = g_timers.find(id);
   355	    if (it == g_timers.end() || it->second.L != owner_state(L)) return 0;
   356	
   357	    // The one case that is an error rather than a no-op. Cancelling the timer
   358	    // whose callback is on the stack would free the entry the fire path is
   359	    // about to reschedule, and the script already has a way to say this:
   360	    // return false.
     1	#include "api/vector.hpp"
     2	
     3	#include <cmath>
     4	#include <cstdio>
     5	
     6	#include "api/output.hpp"
