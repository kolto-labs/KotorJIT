        raises("not finite", big.lengthsq, big)
        raises("not finite", big.dot, big, big)
        raises("not finite", big.distance, big, kp.vec(0, 0, 0))
        raises("not finite", big.distancesq, big, kp.vec(0, 0, 0))
        raises("not finite", big.normalize, big)
        raises("not finite", function() return kp.vec(1e308, 1e308, 0):length() end)
        raises("underflow", function() return kp.vec(1e-200, 0, 0):normalize() end)
        -- Vec results overflow the same way (finite inputs, inf outputs).
        raises("not finite", function() return kp.vec(1e308, 0, 0) * 10 end)
        raises("not finite", function() return kp.vec(1e308, 0, 0) - kp.vec(-1e308, 0, 0) end)
        raises("not finite", function() return kp.vec(1e308, 0, 0) + kp.vec(1e308, 0, 0) end)
        raises("not finite", function() return kp.vec(0, 1e200, 0):cross(kp.vec(0, 0, 1e200)) end)
        raises("not finite", function() return kp.vec(1e308, 0, 0):lerp(kp.vec(-1e308, 0, 0), 3) end)
        raises("not finite", function() return kp.vec(1e308, 0, 0) / 1e-10 end)
        -- Control: large but representable still works.
