        local n = v:normalize()
        assert(near(n:length(), 1) and same(n, 0.6, 0.8, 0), "normalize")
        assert(same(v, 3, 4, 0), "normalize does not modify its receiver")
        -- Zero has no direction. It normalises to a fresh zero, not NaN.
