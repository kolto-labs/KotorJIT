   108	// ---------------------------------------------------------- constructor ---
   109	
   110	int l_vec(lua_State* L) {
   111	    const int argc = lua_gettop(L);
   112	    if (argc == 1 && lua_type(L, 1) == LUA_TTABLE)
   113	        return push_vec(L, read_vec(L, 1, "kp.vec", ""), "kp.vec");
   114	    if (argc == 3) {
   115	        V3 v;
   116	        lua_Number* out[3] = {&v.x, &v.y, &v.z};
   117	        for (int i = 0; i < 3; ++i) *out[i] = read_scalar(L, i + 1, "kp.vec", kAxis[i]);
   118	        return push_vec(L, v, "kp.vec");
   119	    }
   120	    if (argc == 1)
   121	        return luaL_error(L, "kp.vec expects 3 numbers or one table with x, y, z (got %s)",
   122	                          luaL_typename(L, 1));
   123	    return luaL_error(L, "kp.vec expects 3 numbers or one table with x, y, z (got %d arguments)",
   124	                      argc);
   125	}
   126	
   127	// ------------------------------------------------------------ operators ---
   128	
   129	int m_add(lua_State* L) {
   130	    const V3 a = read_vec(L, 1, "kp.vec +", "left operand");
   131	    const V3 b = read_vec(L, 2, "kp.vec +", "right operand");
   132	    return push_vec(L, {a.x + b.x, a.y + b.y, a.z + b.z}, "kp.vec +");
   133	}
   134	
   135	int m_sub(lua_State* L) {
   136	    const V3 a = read_vec(L, 1, "kp.vec -", "left operand");
   137	    const V3 b = read_vec(L, 2, "kp.vec -", "right operand");
   138	    return push_vec(L, {a.x - b.x, a.y - b.y, a.z - b.z}, "kp.vec -");
   139	}
   140	
   141	// vec * number or number * vec. vec * vec has two reasonable meanings (dot,
   142	// cross) and neither is the obvious one, so it is an error.
   143	int m_mul(lua_State* L) {
   144	    const bool left_vec = lua_type(L, 1) == LUA_TTABLE;
   145	    const bool right_vec = lua_type(L, 2) == LUA_TTABLE;
   146	    if (left_vec == right_vec)
   147	        return luaL_error(L, "kp.vec *: expects a vec and a number (got %s and %s); "
   148	                             "use dot or cross for two vecs",
   149	                          luaL_typename(L, 1), luaL_typename(L, 2));
   150	    const int vi = left_vec ? 1 : 2;
   151	    const V3 v = read_vec(L, vi, "kp.vec *", "vec operand");
   152	    const lua_Number k = read_scalar(L, 3 - vi, "kp.vec *", "number operand");
   153	    return push_vec(L, {v.x * k, v.y * k, v.z * k}, "kp.vec *");
   154	}
   155	
   156	int m_div(lua_State* L) {
   157	    if (lua_type(L, 1) != LUA_TTABLE)
   158	        return luaL_error(L, "kp.vec /: only vec / number is defined (got %s / vec)",
   159	                          luaL_typename(L, 1));
   160	    const V3 v = read_vec(L, 1, "kp.vec /", "vec operand");
   161	    const lua_Number k = read_scalar(L, 2, "kp.vec /", "number operand");
   162	    if (k == 0) return luaL_error(L, "kp.vec /: division by zero");
   163	    return push_vec(L, {v.x / k, v.y / k, v.z / k}, "kp.vec /");
   164	}
   165	
   166	int m_unm(lua_State* L) {
   167	    const V3 v = read_vec(L, 1, "kp.vec unary -", "operand");
   168	    return push_vec(L, {-v.x, -v.y, -v.z}, "kp.vec unary -");
   169	}
   170	
   171	// Exact, and never raises: == on a vec whose fields were overwritten with
   172	// junk answers false rather than throwing out of a comparison.
   173	int m_eq(lua_State* L) {
   174	    bool eq = true;
   175	    for (int i = 0; i < 3 && eq; ++i) {
   176	        lua_getfield(L, 1, kAxis[i]);
   177	        lua_getfield(L, 2, kAxis[i]);
   178	        eq = lua_type(L, -1) == LUA_TNUMBER && lua_type(L, -2) == LUA_TNUMBER
   179	          && lua_tonumber(L, -1) == lua_tonumber(L, -2);
   180	        lua_pop(L, 2);
   181	    }
   182	    lua_pushboolean(L, eq);
   183	    return 1;
   184	}
   185	
   186	int m_tostring(lua_State* L) {
   187	    char buf[3][32];
   188	    for (int i = 0; i < 3; ++i) {
   189	        lua_getfield(L, 1, kAxis[i]);
   190	        if (lua_type(L, -1) == LUA_TNUMBER)
   191	            std::snprintf(buf[i], sizeof buf[i], "%.14g", double(lua_tonumber(L, -1)));
   192	        else
   193	            std::snprintf(buf[i], sizeof buf[i], "<%s>", luaL_typename(L, -1));
   194	        lua_pop(L, 1);
   195	    }
   196	    lua_pushfstring(L, "vec(%s, %s, %s)", buf[0], buf[1], buf[2]);
   197	    return 1;
   198	}
