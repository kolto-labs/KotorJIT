### Residual

- Other writers are editing the same shared worktree, so the tree cannot show which edits are mine. The six files above are the only ones this round wrote.
- The reviewer's scratch probe (`kp_reviewprobe strictg` / `hugedelay`) was not re-run. The in-tree regressions reproduce both.
- `docs/lua-api.md` and `data/hostapi.toml` (`delay_ms`, "delay must be zero or more") do not state the new upper bound. That is docs drift for the integrator, outside this round's files.
- The C-function label holds a pointer, so it is stable within one process and state, but not across runs.
#include "api/timers.hpp"

#include <algorithm>
#include <chrono>
#include <cmath>
#include <map>
#include <string>
#include <utility>
#include <vector>

#include "api/output.hpp"
#include "lua/host.hpp"
#include "platform/platform.hpp"

extern "C" {
#include "lua.h"
#include "lauxlib.h"
}

namespace kp::api {

namespace {

struct Timer {
    std::uint64_t id = 0;
    lua_State*    L = nullptr;
    std::string   callback;                  // global name, or a label for a function
    int           callback_ref = LUA_NOREF;  // registry ref to the function, if one was passed
    std::uint64_t delay_ms = 0;
    std::uint64_t due_ms = 0;
    unsigned      call_count = 0;
    int           userdata_ref = LUA_NOREF;
};

// Ordered by id so a pump with several timers due at the same millisecond
// fires them in registration order. Deterministic ordering is not a nicety
// here: two timers due on the same frame that touch the same game state need a
// defined winner, and "whatever the container iterated" is not one.
std::map<std::uint64_t, Timer> g_timers;
std::uint64_t g_next_id = 1;

// The timer currently inside its callback. Single-threaded on purpose: pump()
// is called from the game's main loop, which is the only thread that runs Lua.
std::uint64_t g_firing_id = 0;
lua_State*    g_firing_state = nullptr;

unsigned g_budget = 8;   // matches HostConfig::error_budget

// The scheduler's clock. One value, written by pump() and read by
// registertimer, so a timer's due time is always expressed in the same units
// the pump compares it against.
std::uint64_t g_clock = 0;
bool          g_clock_set = false;

// A private registry key. Its address is the key, so a script cannot collide
// with it by writing to the registry.
const char kSentinelKey = 0;

// The finalised object that ties a state's timers to the state's lifetime.
// It holds the state it was installed on so the finaliser does not have to
// trust the lua_State it is called with -- during a normal collection that can
// be a coroutine, and dropping the coroutine's timers would drop nothing.
//
// `closing` is set by the finaliser. lua_close runs every finaliser before it
// frees anything, and a script's own __gc can run AFTER this one and call
// kp.registertimer. Without the flag that timer would outlive the state and
// the next pump would dereference freed memory; with it, registration refuses.
struct Sentinel {
    lua_State* owner;
    bool       closing;
};

int sentinel_gc(lua_State* L) {
    auto* s = static_cast<Sentinel*>(lua_touserdata(L, 1));
    if (s == nullptr) return 0;
    s->closing = true;
    if (s->owner != nullptr) timers::forget_state(s->owner);
    return 0;
}

void install_sentinel(lua_State* L) {
    lua_pushlightuserdata(L, const_cast<char*>(&kSentinelKey));
    lua_rawget(L, LUA_REGISTRYINDEX);
    const bool already = !lua_isnil(L, -1);
    lua_pop(L, 1);
    if (already) return;

    lua_pushlightuserdata(L, const_cast<char*>(&kSentinelKey));
    auto* s = static_cast<Sentinel*>(lua_newuserdata(L, sizeof(Sentinel)));
    s->owner = L;
    s->closing = false;

    lua_createtable(L, 0, 1);
    lua_pushcfunction(L, sentinel_gc);
    lua_setfield(L, -2, "__gc");
    lua_setmetatable(L, -2);

    lua_rawset(L, LUA_REGISTRYINDEX);
}

// Which state owns the timers for this one. Coroutines share a registry with
// the state that spawned them, so a timer registered from inside a coroutine
// belongs to the script, not to the coroutine -- which will usually be dead
// long before the timer fires.
Sentinel* sentinel_of(lua_State* L) {
    lua_pushlightuserdata(L, const_cast<char*>(&kSentinelKey));
    lua_rawget(L, LUA_REGISTRYINDEX);
    auto* s = static_cast<Sentinel*>(lua_touserdata(L, -1));
    lua_pop(L, 1);
    return s;
}

lua_State* owner_state(lua_State* L) {
    Sentinel* s = sentinel_of(L);
    return s != nullptr ? s->owner : L;
}

// Same handler as the host's dispatch loop uses. Without it a timer error is
// "attempt to call a nil value" with no line number, and the author has no way
// to tell which of their timers is broken.
int traceback_handler(lua_State* L) {
    const char* msg = lua_tostring(L, 1);
    luaL_traceback(L, L, msg != nullptr ? msg : "(non-string error)", 1);
    return 1;
}

// Looks up a callback name, as a protected call. The lookup is ordinary
// global access, so a strict-globals __index on _G runs here and may raise;
// outside a pcall that error has nowhere to go but the panic handler, which
// ends the process.
int lookup_global(lua_State* L) {
    lua_getglobal(L, lua_tostring(L, 1));
    return 1;
}

// The only place a live timer's registry references are released, and the
// entry is erased in the same step, so each reference is released exactly once
// whichever way the timer ends: completion, removetimer, or a throw. A state
// that closes takes its references with it (forget_state erases without
// unref-ing, because the registry is being torn down).
void cancel_timer(std::uint64_t id) {
    auto it = g_timers.find(id);
    if (it == g_timers.end()) return;
    if (it->second.userdata_ref != LUA_NOREF)
        luaL_unref(it->second.L, LUA_REGISTRYINDEX, it->second.userdata_ref);
    if (it->second.callback_ref != LUA_NOREF)
        luaL_unref(it->second.L, LUA_REGISTRYINDEX, it->second.callback_ref);
    g_timers.erase(it);
}

// A timer that throws is charged to its script's error budget under the
// callback's own name, so `n` failures of one timer quarantine the script on
// exactly the same rule as `n` failures of OnTick. The alternative is the
// failure mode the host exists to prevent: a broken timer that renews itself
// and prints the same traceback forever.
void report_error(lua_State* L, const std::string& callback,
                  const char* message, std::uint64_t game_tick) {
    const char* msg = message != nullptr ? message : "(no message)";
    platform::log(platform::LogLevel::Error, "timer '%s': %s", callback.c_str(), msg);
    if (lua::Script* s = lua::Script::owner(L); s != nullptr)
        s->record_error(callback, msg, game_tick, g_budget);
}

// Run one timer, if it is still there and still due. Returns whether a callback
// actually ran, which is what pump() counts.
bool fire_one(std::uint64_t id, std::uint64_t now, std::uint64_t game_tick) {
    auto it = g_timers.find(id);
    if (it == g_timers.end()) return false;      // an earlier callback cancelled it
    if (it->second.due_ms > now) return false;   // or rescheduled it past this pump

    lua_State* L = it->second.L;

    // A quarantined, unloaded or failed script keeps its timers until its state
    // closes, but does not run them. Phasor does the same, and the reason is
    // the same: quarantine that a timer can drive straight through is not
    // quarantine.
    if (lua::Script* s = lua::Script::owner(L);
        s != nullptr && s->state() != lua::ScriptState::Loaded) {
        return false;
    }

    const std::string  callback = it->second.callback;   // copied: the map is about
    const int          fn_ref   = it->second.callback_ref;  // to be reachable from Lua
    const unsigned     count    = ++it->second.call_count;

    const int base = lua_gettop(L);
    lua_pushcfunction(L, traceback_handler);
    // A function value is pushed from its registry reference. Once it is on
    // the stack the call keeps it alive, whatever the callback does to its
    // own timer. A name is looked up now, as it always was, but inside a
    // protected call: _G's __index is script code and may raise.
    if (fn_ref != LUA_NOREF) {
        lua_rawgeti(L, LUA_REGISTRYINDEX, fn_ref);
    } else {
        lua_pushcfunction(L, lookup_global);
        lua_pushstring(L, callback.c_str());
        g_firing_id = id;              // removetimer(id) from __index raises,
        g_firing_state = L;            // as it would from the callback itself
        const int lrc = lua_pcall(L, 1, 1, base + 1);
        g_firing_id = 0;
        g_firing_state = nullptr;
        if (lrc != 0) {
            // Charged like a throw from the callback; the callback never ran,
            // so this is not counted as a firing.
            report_error(L, callback, lua_tostring(L, -1), game_tick);
            lua_settop(L, base);
            cancel_timer(id);
            return false;
        }
    }
    // __index may have registered or cancelled timers. Re-read the entry
    // rather than trust anything taken from it before the lookup.
    auto live = g_timers.find(id);
    if (live == g_timers.end()) { lua_settop(L, base); return false; }
    const int ud_ref = live->second.userdata_ref;
    if (!lua_isfunction(L, -1)) {
        lua_settop(L, base);
        // Phasor resolves the name at fire time too, so a typo is invisible
        // until the timer expires. Kept, because the alternative is refusing to
        // register a callback a script has not defined yet -- which is the
        // normal case when the chunk registers timers before defining them.
        report_error(L, callback, "callback is not a global function", game_tick);
        cancel_timer(id);
        return false;
    }

    lua_pushnumber(L, lua_Number(id));
    lua_pushnumber(L, lua_Number(count));
    if (ud_ref == LUA_NOREF) lua_pushnil(L);
    else                     lua_rawgeti(L, LUA_REGISTRYINDEX, ud_ref);

    g_firing_id = id;
    g_firing_state = L;
    const int rc = lua_pcall(L, 3, 1, base + 1);
    g_firing_id = 0;
    g_firing_state = nullptr;

    if (rc != 0) {
        const char* msg = lua_tostring(L, -1);
        report_error(L, callback, msg, game_tick);
        lua_settop(L, base);
        cancel_timer(id);
        return true;
    }

    // Renewal follows the same rule as an event result in src/lua/value.cpp:
    // a boolean is itself, a number is compared against 1. Returning 2 stops
    // the timer. Widening that would make the two places disagree about what
    // "true" means, which is worse than the surprise.
    bool renew = false;
    if (lua_isboolean(L, -1))     renew = lua_toboolean(L, -1) != 0;
    else if (lua_isnumber(L, -1)) renew = lua_tonumber(L, -1) == 1;
    lua_settop(L, base);

    auto again = g_timers.find(id);
    if (again == g_timers.end()) return true;
    if (renew) again->second.due_ms = now + again->second.delay_ms;
    else       cancel_timer(id);
    return true;
}

// ------------------------------------------------------------ lua surface ---

int l_registertimer(lua_State* L) {
    const int argc = lua_gettop(L);
    if (argc < 2)
        return luaL_error(L, "kp.registertimer expects at least 2 arguments (got %d)", argc);
    if (argc > 3)
        return luaL_error(L, "kp.registertimer expects at most 3 arguments (got %d)", argc);

    // Finite, and no more than 2^32 - 1 ms (about 49.7 days). NaN would never
    // come due; infinity and anything past 2^64 are undefined behaviour in the
    // conversion below and in practice fired at once. The cap keeps the cast
    // defined and clock() + delay far from overflow.
    const lua_Number delay = luaL_checknumber(L, 1);
    if (!std::isfinite(delay) || !(delay >= 0) || delay > lua_Number(timers::kMaxDelayMs))
        return luaL_argerror(L, 1, "delay must be a finite number of milliseconds "
                                   "from 0 to 4294967295");
    const int cb_type = lua_type(L, 2);
    if (cb_type != LUA_TSTRING && cb_type != LUA_TFUNCTION)
        return luaL_argerror(L, 2, lua_pushfstring(L, "expected string or function, got %s",
                                                   luaL_typename(L, 2)));
    if (Sentinel* s = sentinel_of(L); s != nullptr && s->closing)
        return luaL_error(L, "kp.registertimer: this script's state is closing");

    // A function is labelled by where it was defined. The label is what an
    // error is charged to, so every timer made from one closure definition
    // shares one error budget, exactly as every timer naming one global does.
    // Built before anything C++ is constructed: lua_pushfstring can raise.
    // A C function has no source line (every one is "[C]:-1"), so it is
    // labelled by its address instead: one C function, one budget.
    const char* name = nullptr;
    if (cb_type == LUA_TFUNCTION) {
        if (lua_iscfunction(L, 2)) {
            name = lua_pushfstring(L, "function [C] %p", lua_topointer(L, 2));
        } else {
            lua_Debug ar;
            lua_pushvalue(L, 2);             // ">S" pops the function it reads
            lua_getinfo(L, ">S", &ar);
            name = lua_pushfstring(L, "function %s:%d", ar.short_src, ar.linedefined);
        }
    } else {
        name = lua_tostring(L, 2);
    }

    // Argument checks are done. What can still raise is the two luaL_ref
    // calls below, and only on out-of-memory; if the second one does, the
    // first reference is held until the state closes. No C++ object with a
    // destructor exists until after them, so a longjmp here leaks nothing else.
    lua_State*  owner = owner_state(L);

    // Exactly one userdata value, held as a registry reference so a table
    // survives until the timer fires. nil in the slot is the same as omitting
    // it, which is what makes registertimer(ms, name, maybe_nil) safe to write.
    int ref = LUA_NOREF;
    if (argc == 3 && !lua_isnil(L, 3)) {
        lua_pushvalue(L, 3);
        ref = luaL_ref(L, LUA_REGISTRYINDEX);
    }
    int fn_ref = LUA_NOREF;
    if (cb_type == LUA_TFUNCTION) {
        lua_pushvalue(L, 2);
        fn_ref = luaL_ref(L, LUA_REGISTRYINDEX);
    }

    const std::uint64_t id = g_next_id++;
    Timer t;
    t.id = id;
    t.L = owner;
    t.callback = name;
    t.delay_ms = std::uint64_t(delay);
    t.due_ms = timers::clock() + t.delay_ms;
    t.userdata_ref = ref;
    t.callback_ref = fn_ref;
    g_timers.emplace(id, std::move(t));

    lua_pushnumber(L, lua_Number(id));
    return 1;
}

#include "api/vector.hpp"

#include <cmath>
#include <cstdio>

#include "api/output.hpp"

extern "C" {
#include "lua.h"
#include "lauxlib.h"
}

namespace kp::api {

namespace {

// Registry key of the shared metatable. luaL_newmetatable's string key, so the
// same name finds it from every function in this file.
const char kMeta[] = "kp.vec.meta";

// What getmetatable(v) returns. A string, so the answer is informative and the
// table itself is out of a script's reach.
const char kProtect[] = "kp.vec";

struct V3 {
    lua_Number x, y, z;
};

const char* const kAxis[3] = {"x", "y", "z"};

// Read one coordinate. `who` names the operation and `what` the operand, so a
// bad field reads "kp.vec:dot: other.y must be a finite number (got string)".
lua_Number read_axis(lua_State* L, int idx, int axis, const char* who, const char* what) {
    lua_getfield(L, idx, kAxis[axis]);
    const int t = lua_type(L, -1);
    if (t != LUA_TNUMBER) {
        luaL_error(L, "%s: %s%s%s must be a finite number (got %s)", who,
                   what, *what ? "." : "", kAxis[axis], lua_typename(L, t));
    }
    const lua_Number n = lua_tonumber(L, -1);
    lua_pop(L, 1);
    if (!std::isfinite(n)) {
        luaL_error(L, "%s: %s%s%s must be a finite number (got %s)", who,
                   what, *what ? "." : "", kAxis[axis], std::isnan(n) ? "nan" : "inf");
    }
    return n;
}

// Any table with finite numeric x, y, z: a vec, or a routine's plain result.
V3 read_vec(lua_State* L, int idx, const char* who, const char* what) {
    if (lua_type(L, idx) != LUA_TTABLE) {
        luaL_error(L, "%s: %s must be a vec or a table with x, y, z (got %s)",
                   who, what, luaL_typename(L, idx));
    }
    V3 v;
    v.x = read_axis(L, idx, 0, who, what);
    v.y = read_axis(L, idx, 1, who, what);
    v.z = read_axis(L, idx, 2, who, what);
    return v;
}

lua_Number read_scalar(lua_State* L, int idx, const char* who, const char* what) {
    if (lua_type(L, idx) != LUA_TNUMBER) {
        luaL_error(L, "%s: %s must be a finite number (got %s)", who, what,
                   luaL_typename(L, idx));
    }
    const lua_Number n = lua_tonumber(L, idx);
    if (!std::isfinite(n))
        luaL_error(L, "%s: %s must be a finite number (got %s)", who, what,
                   std::isnan(n) ? "nan" : "inf");
    return n;
}

// A fresh vec. The result is checked too: finite inputs can still overflow.
int push_vec(lua_State* L, const V3& v, const char* who) {
    if (!std::isfinite(v.x) || !std::isfinite(v.y) || !std::isfinite(v.z))
        return luaL_error(L, "%s: result is not finite", who);
    lua_createtable(L, 0, 3);
    lua_pushnumber(L, v.x); lua_setfield(L, -2, "x");
    lua_pushnumber(L, v.y); lua_setfield(L, -2, "y");
    lua_pushnumber(L, v.z); lua_setfield(L, -2, "z");
    luaL_getmetatable(L, kMeta);
    lua_setmetatable(L, -2);
    return 1;
}

// A scalar result, checked the same way. 1e155 is a finite coordinate whose
// square is not, so length, dot and distance can overflow from good inputs.
//
// Both helpers round through a volatile double. The 32-bit build does its
// floating point on the x87, whose 80-bit registers hold 1e310 comfortably:
// without the store, the check can pass on a value that becomes inf the
// moment it lands in a Lua number, and length() of the same vector would
// answer differently depending on what the optimiser kept in a register.
int push_scalar(lua_State* L, lua_Number n, const char* who) {
    const volatile lua_Number stored = n;
    const lua_Number r = stored;
    if (!std::isfinite(r)) return luaL_error(L, "%s: result is not finite", who);
    lua_pushnumber(L, r);
    return 1;
}

lua_Number dot(const V3& a, const V3& b) {
    const volatile lua_Number r = a.x * b.x + a.y * b.y + a.z * b.z;
    return r;
}

// ---------------------------------------------------------- constructor ---

int l_vec(lua_State* L) {
    const int argc = lua_gettop(L);
    if (argc == 1 && lua_type(L, 1) == LUA_TTABLE)
        return push_vec(L, read_vec(L, 1, "kp.vec", ""), "kp.vec");
    if (argc == 3) {
        V3 v;
        lua_Number* out[3] = {&v.x, &v.y, &v.z};
        for (int i = 0; i < 3; ++i) *out[i] = read_scalar(L, i + 1, "kp.vec", kAxis[i]);
        return push_vec(L, v, "kp.vec");
    }
    if (argc == 1)
        return luaL_error(L, "kp.vec expects 3 numbers or one table with x, y, z (got %s)",
                          luaL_typename(L, 1));
    return luaL_error(L, "kp.vec expects 3 numbers or one table with x, y, z (got %d arguments)",
                      argc);
}

// ------------------------------------------------------------ operators ---

int m_add(lua_State* L) {
    const V3 a = read_vec(L, 1, "kp.vec +", "left operand");
    const V3 b = read_vec(L, 2, "kp.vec +", "right operand");
    return push_vec(L, {a.x + b.x, a.y + b.y, a.z + b.z}, "kp.vec +");
}

int m_sub(lua_State* L) {
    const V3 a = read_vec(L, 1, "kp.vec -", "left operand");
    const V3 b = read_vec(L, 2, "kp.vec -", "right operand");
    return push_vec(L, {a.x - b.x, a.y - b.y, a.z - b.z}, "kp.vec -");
}

// vec * number or number * vec. vec * vec has two reasonable meanings (dot,
// cross) and neither is the obvious one, so it is an error.
int m_mul(lua_State* L) {
    const bool left_vec = lua_type(L, 1) == LUA_TTABLE;
    const bool right_vec = lua_type(L, 2) == LUA_TTABLE;
    if (left_vec == right_vec)
        return luaL_error(L, "kp.vec *: expects a vec and a number (got %s and %s); "
                             "use dot or cross for two vecs",
                          luaL_typename(L, 1), luaL_typename(L, 2));
    const int vi = left_vec ? 1 : 2;
    const V3 v = read_vec(L, vi, "kp.vec *", "vec operand");
    const lua_Number k = read_scalar(L, 3 - vi, "kp.vec *", "number operand");
    return push_vec(L, {v.x * k, v.y * k, v.z * k}, "kp.vec *");
}

int m_div(lua_State* L) {
    if (lua_type(L, 1) != LUA_TTABLE)
        return luaL_error(L, "kp.vec /: only vec / number is defined (got %s / vec)",
                          luaL_typename(L, 1));
    const V3 v = read_vec(L, 1, "kp.vec /", "vec operand");
    const lua_Number k = read_scalar(L, 2, "kp.vec /", "number operand");
    if (k == 0) return luaL_error(L, "kp.vec /: division by zero");
    return push_vec(L, {v.x / k, v.y / k, v.z / k}, "kp.vec /");
}

int m_unm(lua_State* L) {
    const V3 v = read_vec(L, 1, "kp.vec unary -", "operand");
    return push_vec(L, {-v.x, -v.y, -v.z}, "kp.vec unary -");
}

// Exact, and never raises: == on a vec whose fields were overwritten with
// junk answers false rather than throwing out of a comparison.
int m_eq(lua_State* L) {
    bool eq = true;
    for (int i = 0; i < 3 && eq; ++i) {
        lua_getfield(L, 1, kAxis[i]);
        lua_getfield(L, 2, kAxis[i]);
        eq = lua_type(L, -1) == LUA_TNUMBER && lua_type(L, -2) == LUA_TNUMBER
          && lua_tonumber(L, -1) == lua_tonumber(L, -2);
        lua_pop(L, 2);
    }
    lua_pushboolean(L, eq);
    return 1;
}

int m_tostring(lua_State* L) {
    char buf[3][32];
    for (int i = 0; i < 3; ++i) {
        lua_getfield(L, 1, kAxis[i]);
        if (lua_type(L, -1) == LUA_TNUMBER)
            std::snprintf(buf[i], sizeof buf[i], "%.14g", double(lua_tonumber(L, -1)));
        else
            std::snprintf(buf[i], sizeof buf[i], "<%s>", luaL_typename(L, -1));
        lua_pop(L, 1);
    }
    lua_pushfstring(L, "vec(%s, %s, %s)", buf[0], buf[1], buf[2]);
    return 1;
}

// -------------------------------------------------------------- methods ---

V3 self(lua_State* L, const char* who) {
    if (lua_type(L, 1) != LUA_TTABLE)
        luaL_error(L, "%s: call it as a method, v:%s(...) (got %s for self)", who,
                   who + sizeof("kp.vec:") - 1, luaL_typename(L, 1));
    return read_vec(L, 1, who, "self");
}

int m_length(lua_State* L) {
    const V3 v = self(L, "kp.vec:length");
    return push_scalar(L, std::sqrt(dot(v, v)), "kp.vec:length");
}

int m_lengthsq(lua_State* L) {
    const V3 v = self(L, "kp.vec:lengthsq");
    return push_scalar(L, dot(v, v), "kp.vec:lengthsq");
}

int m_normalize(lua_State* L) {
    const V3 v = self(L, "kp.vec:normalize");
    const lua_Number len = std::sqrt(dot(v, v));
    // An overflowed length would divide every axis to zero, and an underflowed
    // one would read as the zero vector. Both raise; only a true zero vector
    // normalises to zero.
    if (!std::isfinite(len))
        return luaL_error(L, "kp.vec:normalize: length is not finite");
    if (len == 0) {
        if (v.x != 0 || v.y != 0 || v.z != 0)
            return luaL_error(L, "kp.vec:normalize: length underflows to zero");
        return push_vec(L, {0, 0, 0}, "kp.vec:normalize");
    }
    return push_vec(L, {v.x / len, v.y / len, v.z / len}, "kp.vec:normalize");
}

int m_dot(lua_State* L) {
    const V3 a = self(L, "kp.vec:dot");
    const V3 b = read_vec(L, 2, "kp.vec:dot", "other");
    return push_scalar(L, dot(a, b), "kp.vec:dot");
}

int m_cross(lua_State* L) {
    const V3 a = self(L, "kp.vec:cross");
    const V3 b = read_vec(L, 2, "kp.vec:cross", "other");
    return push_vec(L, {a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x},
                    "kp.vec:cross");
}

int m_distancesq(lua_State* L) {
    const V3 a = self(L, "kp.vec:distancesq");
    const V3 b = read_vec(L, 2, "kp.vec:distancesq", "other");
    const V3 d{a.x - b.x, a.y - b.y, a.z - b.z};
    return push_scalar(L, dot(d, d), "kp.vec:distancesq");
}

int m_distance(lua_State* L) {
    const V3 a = self(L, "kp.vec:distance");
    const V3 b = read_vec(L, 2, "kp.vec:distance", "other");
    const V3 d{a.x - b.x, a.y - b.y, a.z - b.z};
    return push_scalar(L, std::sqrt(dot(d, d)), "kp.vec:distance");
}

// a + (b - a) * t, written so t = 0 and t = 1 return the endpoints exactly.
int m_lerp(lua_State* L) {
    const V3 a = self(L, "kp.vec:lerp");
    const V3 b = read_vec(L, 2, "kp.vec:lerp", "other");
    const lua_Number t = read_scalar(L, 3, "kp.vec:lerp", "t");
    const lua_Number s = 1 - t;
    return push_vec(L, {a.x * s + b.x * t, a.y * s + b.y * t, a.z * s + b.z * t},
                    "kp.vec:lerp");
}

int m_copy(lua_State* L) {
    return push_vec(L, self(L, "kp.vec:copy"), "kp.vec:copy");
}

int m_unpack(lua_State* L) {
    const V3 v = self(L, "kp.vec:unpack");
    lua_pushnumber(L, v.x);
    lua_pushnumber(L, v.y);
    lua_pushnumber(L, v.z);
// Exercises the support module -- output, timers, strings -- without the game.
//
// Everything in this module is either a pure function over a string or a
// scheduler driven by a clock, so both are checkable offline. What is NOT
// checkable offline is where the text ends up: the console surface needs the
// console.do_console detour and the feedback surface needs the VM bound. This
// tool proves the routing decision instead -- that feedback finds the routine
// by name when it is there and falls back to the log when it is not -- by
// installing a stand-in nwscript.call from Lua.
//
// The timer cases run against the real lua::Host, not a stub state, because the
// interesting behaviour is quarantine and quarantine belongs to Script.
//
// The scripts are written to a scratch directory at startup and removed at the
// end. luaL_loadfile needs files, and the repository's example scripts are not
// this tool's to add to.
//
// Usage:
//   kp_supporttest [scratch-dir]

#include <cstdio>
#include <filesystem>
#include <fstream>
#include <string>
#include <vector>

#include <sys/wait.h>
#include <unistd.h>

#include "api/output.hpp"
#include "api/strings.hpp"
#include "api/timers.hpp"
#include "lua/host.hpp"
#include "platform/platform.hpp"

extern "C" {
#include "lua.h"
#include "lauxlib.h"
}

namespace fs = std::filesystem;
using namespace kp;

namespace {

unsigned g_failures = 0;

struct LogRecord {
    platform::LogLevel level;
    std::string message;
};

std::vector<LogRecord> g_log_records;

void check(bool condition, const char* what) {
    std::printf("  %-68s %s\n", what, condition ? "ok" : "FAIL");
    if (!condition) ++g_failures;
}

// The log sink the runtime would install. Here it prints to stdout so the log
// lines and the script's own print() land in one readable stream; in the game
// this is what appends to kotorphasor.log.
void tool_log_sink(platform::LogLevel level, const char* message, void*) {
    g_log_records.push_back({level, message != nullptr ? message : ""});
    std::printf("  [log:%s] %s\n", platform::to_string(level), message);
}

void check_only_info_log(const char* expected, const char* what) {
    const bool exact = g_log_records.size() == 1
                    && g_log_records[0].level == platform::LogLevel::Info
                    && g_log_records[0].message == expected;
    if (!exact) {
        std::printf("    expected one info log '%s'; captured %zu record(s)\n",
                    expected, g_log_records.size());
        for (const LogRecord& record : g_log_records)
            std::printf("      [%s] %s\n", platform::to_string(record.level),
                        record.message.c_str());
    }
    check(exact, what);
}

// The console writer the console.do_console detour would supply.
void tool_console_writer(const char* line, void*) {
    std::printf("  [console] %s\n", line);
}

void rule(const char* title) {
    const std::size_t len = std::string(title).size();
    std::printf("\n=== %s %s\n", title, std::string(len < 60 ? 60 - len : 3, '=').c_str());
}

const char* state_name(lua::ScriptState s) {
    switch (s) {
    case lua::ScriptState::Loaded:       return "loaded";
    case lua::ScriptState::FailedToLoad: return "failed";
    case lua::ScriptState::Quarantined:  return "QUARANTINED";
    case lua::ScriptState::Unloaded:     return "unloaded";
    }
    return "?";
}

// ------------------------------------------------------------- tokenising ---

void show_tokens(const char* what, const std::vector<std::string>& tokens) {
    std::printf("  %-34s -> %zu:", what, tokens.size());
    for (const std::string& t : tokens) std::printf(" [%s]", t.c_str());
    std::printf("\n");
}

void tokenising_cases() {
    rule("strings");

    std::printf("tokenizestring(str, delims) -- empty fields dropped\n");
    show_tokens("(\"a,b,c\", \",\")",        api::tokenize("a,b,c", ","));
    show_tokens("(\"a,,b\", \",\")",         api::tokenize("a,,b", ","));
    show_tokens("(\",,a,,\", \",\")",        api::tokenize(",,a,,", ","));
    show_tokens("(\"a:b,c\", \",:\")",       api::tokenize("a:b,c", ",:"));
    show_tokens("(\"10.1.2.3/24\", \"/\")",  api::tokenize("10.1.2.3/24", "/"));
    show_tokens("(\"\", \",\")",             api::tokenize("", ","));
    show_tokens("(\",,,\", \",\")",          api::tokenize(",,,", ","));
    show_tokens("(\"abc\", \"\")",           api::tokenize("abc", ""));

    std::printf("\ntokenizecmdstring(line) -- quotes hold a token together\n");
    show_tokens("give \"plot armour\" 1",    api::tokenize_command("give \"plot armour\" 1"));
    show_tokens("  spaced   out  ",          api::tokenize_command("  spaced   out  "));
    show_tokens("say \"\" done",             api::tokenize_command("say \"\" done"));
    show_tokens("say \"a  b\" \"c\"",        api::tokenize_command("say \"a  b\" \"c\""));
    show_tokens("open \"unterminated",       api::tokenize_command("open \"unterminated"));
    show_tokens("say a\"b",                  api::tokenize_command("say a\"b"));
    show_tokens("(empty line)",              api::tokenize_command(""));
    show_tokens("tab\\tseparated",           api::tokenize_command("tab\tseparated"));
}

// ----------------------------------------------------------- the scripts ----

struct ScriptFile {
    const char* name;
    const char* body;
};

const ScriptFile kScripts[] = {
{"10_timers.lua", R"LUA(
-- Firing, userdata, renewal, and removal before the timer ever comes due.
function start()
    local once = kp.registertimer(100, "on_once", { tag = "payload" })
    local rep  = kp.registertimer(250, "on_repeat")
    local doomed = kp.registertimer(300, "on_never")
    kp.removetimer(doomed)
    print(("  [10_timers] ids once=%d repeat=%d removed=%d"):format(once, rep, doomed))
end

function on_once(id, count, data)
    print(("  [10_timers] on_once     count=%d data.tag=%s"):format(count, tostring(data.tag)))
    return false
end

function on_repeat(id, count)
    print(("  [10_timers] on_repeat   count=%d (renews while count < 3)"):format(count))
    return count < 3
end

function on_never(id, count)
    print("  [10_timers] on_never     THIS SHOULD NOT PRINT")
end
)LUA"},

{"20_remove_inside.lua", R"LUA(
-- Everything removetimer ignores, and the one case that raises.
function start()
    kp.removetimer()        -- no argument
    kp.removetimer(nil)     -- nil
    kp.removetimer(99999)   -- an id nobody owns
    kp.removetimer(1)       -- id 1 is 10_timers' on_once, and stays alive
    print("  [20_remove_inside] four ignored removes: none, nil, unknown, another script's id")
    kp.registertimer(150, "on_self")
end

function on_self(id, count)
    kp.removetimer(id)
    print("  [20_remove_inside] THIS SHOULD NOT PRINT")
end
)LUA"},

{"30_throws.lua", R"LUA(
-- Four timers on one broken callback, against an error budget of 3.
