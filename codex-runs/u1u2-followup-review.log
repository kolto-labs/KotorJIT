    13	namespace kp::api {
    14	
    15	namespace {
    16	
    17	// Registry key of the shared metatable. luaL_newmetatable's string key, so the
    18	// same name finds it from every function in this file.
    19	const char kMeta[] = "kp.vec.meta";
    20	
    21	// What getmetatable(v) returns. A string, so the answer is informative and the
    22	// table itself is out of a script's reach.
    23	const char kProtect[] = "kp.vec";
    24	
    25	struct V3 {
    26	    lua_Number x, y, z;
    27	};
    28	
    29	const char* const kAxis[3] = {"x", "y", "z"};
    30	
    31	// Read one coordinate. `who` names the operation and `what` the operand, so a
    32	// bad field reads "kp.vec:dot: other.y must be a finite number (got string)".
    33	lua_Number read_axis(lua_State* L, int idx, int axis, const char* who, const char* what) {
    34	    lua_getfield(L, idx, kAxis[axis]);
    35	    const int t = lua_type(L, -1);
    36	    if (t != LUA_TNUMBER) {
    37	        luaL_error(L, "%s: %s%s%s must be a finite number (got %s)", who,
    38	                   what, *what ? "." : "", kAxis[axis], lua_typename(L, t));
    39	    }
    40	    const lua_Number n = lua_tonumber(L, -1);
    41	    lua_pop(L, 1);
    42	    if (!std::isfinite(n)) {
    43	        luaL_error(L, "%s: %s%s%s must be a finite number (got %s)", who,
    44	                   what, *what ? "." : "", kAxis[axis], std::isnan(n) ? "nan" : "inf");
    45	    }
    46	    return n;
    47	}
    48	
    49	// Any table with finite numeric x, y, z: a vec, or a routine's plain result.
    50	V3 read_vec(lua_State* L, int idx, const char* who, const char* what) {
    51	    if (lua_type(L, idx) != LUA_TTABLE) {
    52	        luaL_error(L, "%s: %s must be a vec or a table with x, y, z (got %s)",
    53	                   who, what, luaL_typename(L, idx));
    54	    }
    55	    V3 v;
    56	    v.x = read_axis(L, idx, 0, who, what);
    57	    v.y = read_axis(L, idx, 1, who, what);
    58	    v.z = read_axis(L, idx, 2, who, what);
    59	    return v;
    60	}
    61	
    62	lua_Number read_scalar(lua_State* L, int idx, const char* who, const char* what) {
    63	    if (lua_type(L, idx) != LUA_TNUMBER) {
    64	        luaL_error(L, "%s: %s must be a finite number (got %s)", who, what,
    65	                   luaL_typename(L, idx));
    66	    }
    67	    const lua_Number n = lua_tonumber(L, idx);
    68	    if (!std::isfinite(n))
    69	        luaL_error(L, "%s: %s must be a finite number (got %s)", who, what,
    70	                   std::isnan(n) ? "nan" : "inf");
    71	    return n;
    72	}
    73	
    74	// A fresh vec. The result is checked too: finite inputs can still overflow.
    75	int push_vec(lua_State* L, const V3& v, const char* who) {
    76	    if (!std::isfinite(v.x) || !std::isfinite(v.y) || !std::isfinite(v.z))
    77	        return luaL_error(L, "%s: result is not finite", who);
    78	    lua_createtable(L, 0, 3);
    79	    lua_pushnumber(L, v.x); lua_setfield(L, -2, "x");
    80	    lua_pushnumber(L, v.y); lua_setfield(L, -2, "y");
    81	    lua_pushnumber(L, v.z); lua_setfield(L, -2, "z");
    82	    luaL_getmetatable(L, kMeta);
    83	    lua_setmetatable(L, -2);
    84	    return 1;
    85	}
    86	
    87	// A scalar result, checked the same way. 1e155 is a finite coordinate whose
    88	// square is not, so length, dot and distance can overflow from good inputs.
    89	//
    90	// Both helpers round through a volatile double. The 32-bit build does its
    91	// floating point on the x87, whose 80-bit registers hold 1e310 comfortably:
    92	// without the store, the check can pass on a value that becomes inf the
    93	// moment it lands in a Lua number, and length() of the same vector would
    94	// answer differently depending on what the optimiser kept in a register.
    95	int push_scalar(lua_State* L, lua_Number n, const char* who) {
    96	    const volatile lua_Number stored = n;
    97	    const lua_Number r = stored;
    98	    if (!std::isfinite(r)) return luaL_error(L, "%s: result is not finite", who);
    99	    lua_pushnumber(L, r);
   100	    return 1;
   101	}
   102	
   103	lua_Number dot(const V3& a, const V3& b) {
   104	    const volatile lua_Number r = a.x * b.x + a.y * b.y + a.z * b.z;
   105	    return r;
   106	}
