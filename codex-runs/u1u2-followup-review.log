        assert(same(y:cross(x), 0, 0, -1), "y cross x is -z")
        assert(kp.vec(1, 2, 3):dot({ x = 1, y = 1, z = 1 }) == 6, "dot with plain table")
        raises("x", function() return x:dot(5) end)
