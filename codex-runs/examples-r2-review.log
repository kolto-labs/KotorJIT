 succeeded in 19248ms:
-- Chain reaction: every corpse is a thermal detonator.
--
-- When anything dies it explodes. Everything within the blast radius takes
-- damage; anything that dies from that explodes too, so one kill in a
-- crowded room cascades. Party members are in the blast as well (a third of
-- the damage, and never below 1 HP), because a demo where the player is
-- safe is not cursed.
--
-- Mechanism: death scripts run ON the corpse, so OnRunScript + the death
-- resref is the trigger (OnCreatureDeath is never dispatched). The blast
-- visual is the thermal detonator VFX applied at the corpse; the damage is
-- EffectDamage on every creature in range, which runs the victims' own
-- death scripts and re-enters this hook. Recursion is bounded because a
-- corpse only detonates once.
--
-- Party protection: before a party member's first blast, the script reads
-- its GetMinOneHP flag, then sets it. SETTLE_MS after the latest blast, and
-- on a module load, area enter or script unload, the script puts each flag
-- back to the value it read. It does not trust object IDs from before a
-- transition: the PC is looked up again with GetFirstPC, and a party member
-- by its tag through the party roster (GetPartyMemberByIndex), then
-- GetObjectByTag. A guarded creature that cannot be found is logged
-- ("restore pending") and tried again at the next settle, area enter or
-- module load; everyone who can be found is restored in the same pass. If a
-- blast reaches that creature first, it keeps the prior flag it had.
-- A member whose flag cannot be read (an error or a false answer) is left
-- out of the blast. Not covered: a save written inside the SETTLE_MS window
-- keeps the flag set, and loading it in a new session starts with no record
-- of what to restore.
--
-- VFX_FRAG marks a blast set off while another blast is still applying its
-- damage (depth > 0). That happens only if a victim's death script runs
-- inside the bridge call. The tests show both cases. A live chained kill
-- decides which one the engine does; the header note below says deaths
-- arrive a frame later, which gives thermal only.
--
-- Oracle lines: "[cursed:boom] <name> detonated: k hit (#n)"
-- Counter: local number 7 on the PC == detonations so far; local number 6 ==
-- total damage requested against party members (not a measurement).
-- (Deaths caused by a blast show up as their own detonation a frame later,
-- when their death script runs; the effect has not resolved by the time
-- this hook returns.)
priority = 30

local RADIUS = 7.0
local DAMAGE = 40
local PARTY_DIVISOR = 3
local VFX_THERMAL = 3005
local VFX_FRAG = 3003
local DAMAGE_TYPE_FIRE = 256
local COUNTER_SLOT = 7
local SETTLE_MS = 3000

local function q(name, ...)
  if not nwscript or type(nwscript.call) ~= "function" then return nil end
  local ok, v = pcall(nwscript.call, name, ...)
  return ok and v or nil
end
local function yes(v) return v == 1 or v == true end
local function call(name, ...)
  if not nwscript or type(nwscript.call) ~= "function" then return false end
  return (pcall(nwscript.call, name, ...))
end

local function norm(s) return type(s) == "string" and s:gsub("%z+$", "") or "" end
local function tag_of(o) return norm(q("GetTag", o)) end
local function valid(o) return o ~= nil and yes(q("GetIsObjectValid", o)) end

-- guarded[id] == { prior = the min-one-HP flag before our first SetMinOneHP,
-- tag = GetTag then, pc = it was GetFirstPC then }. settle_gen ignores
-- timers that a later blast superseded.
local guarded = {}
local settle_gen = 0
-- The object an entry refers to now, or nil. Object IDs can change across a
-- module load, so a stale ID is looked up again: the PC through GetFirstPC,
-- a party member by tag through the party roster, then GetObjectByTag.
local function current(id, entry)
  if entry.pc then
    local pc = q("GetFirstPC")
    return valid(pc) and pc or nil
  end
  if valid(id) and (entry.tag == "" or tag_of(id) == entry.tag) then return id end
  if entry.tag == "" then return nil end
  local n = tonumber(q("GetPartyMemberCount")) or 0
  for i = 0, n - 1 do
    local m = q("GetPartyMemberByIndex", i)
    if valid(m) and tag_of(m) == entry.tag then return m end
  end
  local m = q("GetObjectByTag", entry.tag, 0)
  if valid(m) and yes(q("IsObjectPartyMember", m)) then return m end
  return nil
end
local function guard(member)
  if guarded[member] ~= nil then return true end
  -- A creature whose restore is still pending keeps its first prior; reading
  -- the flag now would record our own 1.
  local old
  for id, entry in pairs(guarded) do
    if current(id, entry) == member then old = id; break end
  end
  if old then
    if not call("SetMinOneHP", member, 1) then return false end
    guarded[member], guarded[old] = guarded[old], nil
    return true
  end
  local prior = q("GetMinOneHP", member)
  if prior == nil then return false end
  prior = yes(prior) and 1 or 0
  if not call("SetMinOneHP", member, 1) then return false end
  guarded[member] = { prior = prior, tag = tag_of(member), pc = q("GetFirstPC") == member }
  return true
end
local function restore_guards()
  local done = {}
  for id, entry in pairs(guarded) do
    local now = current(id, entry)
    if now == nil then
      kp.print(("[cursed:boom] min-one-HP restore pending: %s not found")
            :format(entry.pc and "PC" or (entry.tag ~= "" and entry.tag or tostring(id))))
    elseif call("SetMinOneHP", now, entry.prior) then
      done[#done + 1] = id
    end
  end
  for _, id in ipairs(done) do guarded[id] = nil end
end
function chain_settle(timer_id, fired, data)
  if type(data) == "table" and data.gen == settle_gen then restore_guards() end
  return false
end
-- Distance from positions: GetDistanceBetween answered 99/oversized inside
-- hooks (the big shout and the airstrike found 0-1 targets in a ring of 6).
local function dist(a, b)
  local pa, pb = q("GetPosition", a), q("GetPosition", b)
  if type(pa) ~= "table" or type(pb) ~= "table" then return 99 end
  local dx, dy, dz = pa.x - pb.x, pa.y - pb.y, pa.z - pb.z
  return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Arming: nothing fires until ARM_TICKS frames after a module/area load and
-- never while the player is in a conversation. Effects applied from a hook
-- during a load or a cutscene bark hung the client (verified 2026-09-16:
-- the client loop stopped at 100 frames with disguises applied during
-- Trask's tutorial bark). PC local number 5 == 1 publishes "armed".
local ARM_TICKS = 200
local armed_flag = false
local tick_count = 0
local function armed()
  if not armed_flag then return false end
  local pc = q("GetFirstPC")
  if not pc then return false end
  if yes(q("GetIsInConversation", pc)) then return false end
  return true
end
function OnTick(tick, relevant)
  if armed_flag then return end
  tick_count = tick_count + 1
  if tick_count >= ARM_TICKS then
    armed_flag = true
    local pc = q("GetFirstPC")
    if pc then q("SetLocalNumber", pc, 5, 1) end
    kp.print("[cursed] armed")
  end
end
local function disarm()
  restore_guards()
  armed_flag = false; tick_count = 0
  local pc = q("GetFirstPC")
  if pc then q("SetLocalNumber", pc, 5, 0) end
end
function OnModuleLoad(relevant) disarm() end
function OnAreaEnter(area, entering, relevant) disarm() end
function OnScriptUnload(relevant) restore_guards() end

local exploded = {}
local count = 0
local depth = 0
local party_damage = 0   -- published in local number 6 (requested, not measured)

local function is_death_script(s)
  return s == "k_def_death01" or s:find("death", 1, true) ~= nil or s:find("dead", 1, true) ~= nil
end

local function detonate(corpse)
  if exploded[corpse] then return end
  local pc = q("GetFirstPC")
  if not pc then return end
  exploded[corpse] = true
  local boom = q("EffectVisualEffect", depth > 0 and VFX_FRAG or VFX_THERMAL)
  if boom then q("ApplyEffectToObject", 0, boom, corpse, 0.0) end
  q("SetGlobalFadeOut", 0.0, 0.05, 1.0, 0.6, 0.1)
  q("SetGlobalFadeIn", 0.05, 0.4, 0.0, 0.0, 0.0)

  local hit, killed = 0, 0
  local area = q("GetArea", corpse)
  local victims = {}
  local o = q("GetFirstObjectInArea", area, 1)
  while o and yes(q("GetIsObjectValid", o)) do
    if o ~= corpse and not yes(q("GetIsDead", o))
       and dist(corpse, o) <= RADIUS then
      victims[#victims + 1] = o
    end
    o = q("GetNextObjectInArea", area, 1)
  end
  depth = depth + 1
  for _, v in ipairs(victims) do
    local party = yes(q("IsObjectPartyMember", v))
    if not party or guard(v) then
      local amount = party and math.floor(DAMAGE / PARTY_DIVISOR) or DAMAGE
      local dmg = q("EffectDamage", amount, DAMAGE_TYPE_FIRE, 0)
      if dmg then q("ApplyEffectToObject", 0, dmg, v, 0.0) end
      if party then
        party_damage = party_damage + amount
        q("SetLocalNumber", pc, 6, party_damage)
      end
      hit = hit + 1
    end
  end
  depth = depth - 1
  settle_gen = settle_gen + 1
  if kp and type(kp.registertimer) == "function" then
    kp.registertimer(SETTLE_MS, "chain_settle", { gen = settle_gen })
  end
  count = count + 1
  q("SetLocalNumber", pc, COUNTER_SLOT, count)
  kp.print(("[cursed:boom] %s detonated: %d hit (#%d)")
        :format(norm(q("GetName", corpse)), hit, count))
end

function OnRunScript(script_name, object_id, has_object, relevant)
  if not armed() then return end
  local s = norm(script_name)
  if not is_death_script(s) then return end
  local pc = q("GetFirstPC")
  if not pc or object_id == pc then return end
  if not yes(q("GetIsObjectValid", object_id)) then return end
  if yes(q("IsObjectPartyMember", object_id)) then return end
  detonate(object_id)
end
# Cursed KotOR

Eight retained Lua scripts that rewrite the rules of a fight from inside the engine, each
tied to an engine event. They are demos of what the event layer plus the full
NWScript routine table can do, not gameplay mods. Every one is a single file
with no dependencies, so drop any of them into `kotorphasor/scripts/` and play.

| Script | Trigger | What happens |
|---|---|---|
| `10_rancor_roulette.lua` | enemy perceives you (`k_def_percept01` via OnRunScript) | requests a humanoid disguise: Malak, Bastila, Canderous, Carth, Jolee or Juhani; applied from a 50ms timer |
| `20_fus_ro_dah.lua` | you hit something (OnCreatureAttacked) | the target is Force-pushed with a force-wave burst and a white flash; every fifth hit requests a sweep within 10m |
| `30_necromancer.lua` | an enemy's death script runs (OnRunScript) | 800ms later it rises as Darth Malak, full health, hostile, wreathed in lightning; once per corpse |
| `40_chain_reaction.lua` | any death script (OnRunScript) | the corpse is a thermal detonator; everyone in 7m takes fire damage; deaths from the blast detonate too. Party members take a third and keep at least 1 HP. A member whose min-one-HP flag cannot be read is left out of the blast. The script puts back each flag it set 3s after the last blast, or on an area enter, module load or script unload. It does not trust the old object IDs: it finds the PC again with `GetFirstPC`, and keeps a party member's old ID only while that ID is valid and has the same tag, otherwise it looks the member up by tag. A creature it cannot find is logged and tried again at the next settle or transition; everyone it can find is restored. A save written inside the 3s window keeps the flag set, and loading it in a new session cannot restore it |
| `70_doppelganger.lua` | the first time you attack a living non-party creature (OnCreatureAttacked with you as the attacker; with you as the victim it was not seen firing, verified 2026-09-16) | you become Malak, and each creature you attack takes the look you had before. Once you have been in combat, 40 ticks out of combat remove only the script's own disguises. An area enter or module load starts the same cleanup. A creature that is dead or gone by then keeps its disguise; the log says so, and the next area enter or module load stops trying. If a removal fails, the script retries it on later ticks and starts no new copies until cleanup ends. It re-arms 200 ticks after cleanup ends. Nothing happens during a conversation |
| `80_loot_pinata.lua` | enemy death script (OnRunScript) | a ring of credit piles around the corpse; every second corpse releases a hostile gizka |
| `90_bullet_time.lua` | HP drops to at most 70% (OnTick, every fifth tick) | `kp.game_speed(0.25)` for 2.5s, blue tint, haste aura on you; a timer restores speed |
| `100_item_airstrike.lua` | you acquire any item (OnModuleAcquireItem); level up (OnModulePlayerLevelUp, not yet seen firing live) | space laser + 60 damage on every living non-party creature in 20m that `GetIsEnemy` marks hostile to you; neutrals are spared. On level-up you ascend as Revan |

Chaos roulette and rave were removed from the public tree on 2026-09-22.
Their unchanged regression sources are under
`tools/tests/examples/fixtures/legacy/cursed/`. This retained collection is
not a featured gallery or a blanket live/visual pass; the separate
[native scene catalog](../../demos/catalog.json) records candidates explicitly.

## How they are built

These retained scripts use an event-driven skeleton:

- `priority = 30` so they answer before the negative-priority passive probes.
- `q(name, ...)`: every engine call goes through a pcall by name. The
  engine bridge may be unbound, and a routine can be missing on
  another build; the guard makes the script inert instead of faulting.
- `yes(v)`: NWScript TRUE arrives as `1` or `true` depending on the marshaller.
- A `kp.print("[cursed:<tag>] ...")` oracle line per firing, so
  the log records the Lua decision and requested operation. It does not prove
  that an effect landed, an action completed, or the displayed model changed.
- A counter in **local number 7 on the PC** (`SetLocalNumber(pc, 7, n)`), which
  is how the route's `assert_lua` gates read progress from a different Lua
  state. Harness `lua` steps run in their own state; script globals are not
  visible to them, engine state is.

Things the event layer forced (see `docs/user/api-status.md`):

- `OnCreatureDeath`, `OnCreatureEndCombatRound`, `OnCreatureSpawn` are dead
  names. Death and end-of-round are caught with `OnRunScript` by script name
  (`k_def_death01` / `*dead*` / `*death*` and `k_def_combend01`); the script
  runs on the corpse, so `object_id` is the creature.
- `DelayCommand` and `AssignCommand` are not bound. Delays are
  `kp.registertimer(ms, "global_callback_name", data)` (return `true` to
  repeat); acting as another creature is `nwscript.with_caller(obj, function() ... end)`.
- Screen flashes are `SetGlobalFadeOut(0, 0.08, r, g, b)` then
  `SetGlobalFadeIn(hold, 0.35)`. There is no other full-screen tint routine.
- `EffectDisguise(row)` takes an `appearance.2da` row. Useful rows: 21 Malak,
  22 Revan, 80 rancor, 77 krayt dragon, 69 gizka.
- `CreateObject(OBJECT_TYPE_ITEM=2, "g_i_credits00N", loc)` puts an item on
  the floor; global creature templates like `g_gizka01` come from
  `templates.bif`, so they spawn in any module.

## Routes and recordings

`scripts/harness/scenarios/cursed/<name>.toml` drives each demo as a
state-gated route from the `endar_room3` checkpoint at 1x: load, reset the
counter, `clear_room`, then `assert_lua ... poll = true` gates on the counter
and on visible engine state (appearance rows, items on the floor, no hostiles
left). `scripts/harness/record_cursed.sh <name|all>` deploys the script,
runs the route, records the Xvfb display with x11grab, cuts a gif from the
first curse, and writes `tmp/demos/cursed/<name>.{mp4,gif,oracle.txt,report.json}`.

Current-byte host and live statuses are tracked in [example validation](../../../docs/example-validation.md). Retained recordings without source hashes are historical evidence only. Death matching deliberately accepts `*dead*` and `*death*`, including broad substring matches. The retired rave fixture still tests a polling timer across temporarily absent/dead PCs.
return function(test)
local specs={
 {'10_rancor_roulette.lua','k_def_percept01','roulette'},
 {'30_necromancer.lua','k_def_death01','necro'},
 {'40_chain_reaction.lua','k_def_death01','boom'},
 {'80_loot_pinata.lua','k_def_death01','pinata'},
}
for _,s in ipairs(specs) do
 test('cursed/'..s[1],'arming, eligible target, requests and duplicate guard',function(F,p)
  local f=F.new(p):load(); f.env.OnRunScript(s[2],20); assert(#f.timers==0 and f:count('ApplyEffectToObject')==0)
  f:arm(); f.env.OnRunScript('unrelated',20); f.env.OnRunScript(s[2],2); assert(#f.timers==0 and f:count('ApplyEffectToObject')==0)
  f.env.OnRunScript(s[2]..'\0',20); f.env.OnRunScript(s[2],20)
  if s[3]=='roulette' then
   assert(#f.timers==1 and f.timers[1].ms==50); assert(f:fire(1)==false)
   assert(f:last('EffectDisguise').args[1]==21); assert(f:last('SpeakString').caller==20)
  elseif s[3]=='necro' then
   assert(#f.timers==1 and f.timers[1].ms==800); f:fire(1)
   local c=f:last('CreateObject'); assert(c.args[1]==1 and c.args[2]=='g_sithtroop01')
   assert(f:last('DestroyObject').args[1]==20 and f:last('ActionAttack').caller==100)
   assert(f:fire(2)==false); assert(f:has('verify 100: valid=1'))
   f.env.OnRunScript(s[2],100); assert(#f.timers==2)
  elseif s[3]=='boom' then
   assert(f:last('SetMinOneHP').args[1]==2 and f:last('SetMinOneHP').args[2]==1)
   assert(f.locals[6]>0 and f:count('EffectDamage')==2)
  else
   assert(f:count('CreateObject')==5 and f:has('5 piles'))
   f.env.OnRunScript(s[2],21); assert(f:last('CreateObject').args[2]=='g_gizka01')
   assert(f:last('ActionAttack').caller==100)
  end
  assert(f.locals[7]==(s[3]=='pinata' and 2 or 1)); assert(f:has('[cursed:'..s[3]..']'))
 end)
 test('cursed/'..s[1],'conversation invalid and distant or party exclusions',function(F,p)
  local f=F.new(p):load(); f:arm(); f.overrides.GetIsInConversation=function() return 1 end
  f.env.OnRunScript(s[2],20); assert(#f.timers==0 and f:count('ApplyEffectToObject')==0)
  f.overrides.GetIsInConversation=function() return 0 end
  f.env.OnRunScript(s[2],F.INVALID); f.env.OnRunScript(s[2],1); f.env.OnRunScript(s[2],2)
  assert(#f.timers==0 and f:count('ApplyEffectToObject')==0)
 end)
end
test('cursed/20_fus_ro_dah.lua','five hits sweep eligible creatures and duplicate second',function(F,p)
 local f=F.new(p):load(); f.env.OnCreatureAttacked(20,1); assert(f:count('ApplyEffectToObject')==0); f:arm()
 f.env.OnCreatureAttacked(20,21); assert(f:count('ApplyEffectToObject')==0)
 for i=1,5 do f.second=i; f.env.OnCreatureAttacked(20,1); local n=f:count('EffectForcePushed'); f.env.OnCreatureAttacked(20,1); assert(f:count('EffectForcePushed')==n) end
 assert(f.locals[7]==5 and f:count('EffectForcePushed')==6)
 assert(f:has('FUS RO DAH: 1 flung') and f:last('SpeakString').caller==1)
end)
local wheel={'EffectWhirlWind','EffectChoke','EffectHorrified','EffectDisguise','EffectBeam','EffectHaste','EffectDamageShield','EffectHeal','EffectStunned','JumpToLocation'}
for i,name in ipairs(wheel) do test('cursed/50_chaos_roulette.lua','wheel branch '..i,function(F,p)
 local f=F.new(p):load(); f:arm(); f.random=i
 f.env.OnRunScript('unrelated',20); assert(f:count(name)==0)
 f.env.OnRunScript('k_def_combend01',20); assert(f:count(name)==1 and f.locals[7]==1)
 assert(f:last('SpeakString').caller==20)
 if i==10 then assert(f:last(name).caller==20) else assert(f:last('ApplyEffectToObject').args[3]==20) end
 f.objects[20].dead=1; f.env.OnRunScript('k_def_combend01',20); assert(f.locals[7]==1)
end) end
test('cursed/60_rave.lua','one repeating timer, dance scope, fourth beat plasma',function(F,p)
 local f=F.new(p):load(); f.env.OnTick(1); f.env.OnTick(2); assert(#f.timers==1 and f.timers[1].ms==700)
 for i=1,4 do assert(f:fire(1)==true) end
 assert(f.locals[7]==4 and f:count('MusicBattlePlay')==1 and f:count('ActionPlayAnimation')==3)
 assert(f:last('ActionPlayAnimation').caller==20 and f:last('EffectVisualEffect').args[1]==3010)
