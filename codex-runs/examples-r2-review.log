test('cursed/40_chain_reaction.lua','module load re-resolves a guarded party member whose object ID changed',function(F,p)
 local f=F.new(p):load(); f:arm()
 f.env.OnRunScript('k_def_death01',20); assert(f.objects[2].min_one_hp==1)
 f.objects[5]={tag='bastila',party=1,x=1,min_one_hp=f.objects[2].min_one_hp}; f.objects[2]=nil; f.party={1,5}
 f.env.OnModuleLoad()
 assert(f.objects[5].min_one_hp==0, 'party member re-created under a new ID kept min-one-HP=1')
end)
test('cursed/40_chain_reaction.lua','module load re-resolves the guarded PC through GetFirstPC when its object ID changed',function(F,p)
 local f=F.new(p):load(); f.objects[1].tag=''; f.area_objects={20,21,2,1}; f:arm()
 f.env.OnRunScript('k_def_death01',20); assert(f.objects[1].min_one_hp==1 and f.objects[2].min_one_hp==1)
 f.objects[7]={tag='',party=1,x=0,min_one_hp=1}; f.objects[1]=nil; f.party={7,2}
 f.overrides.GetFirstPC=function() return 7 end
 f.env.OnModuleLoad()
 assert(f.objects[7].min_one_hp==0, 'PC re-created under a new ID left immortal')
 assert(f.objects[2].min_one_hp==0)
end)
test('cursed/40_chain_reaction.lua','a member that cannot be re-resolved is recorded and retried; every resolvable guard is still cleared',function(F,p)
 local f=F.new(p):load(); f.objects[1].tag=''; f.area_objects={20,21,2,1}; f:arm()
 f.env.OnRunScript('k_def_death01',20)
 f.objects[7]={tag='',party=1,x=0,min_one_hp=1}; f.objects[1]=nil; f.objects[2]=nil; f.party={7}
 f.overrides.GetFirstPC=function() return 7 end
 f.env.OnModuleLoad()
 assert(f.objects[7].min_one_hp==0, 'PC not cleared while another member was missing')
 assert(f:has('min-one-HP restore pending: bastila'), 'missing member not recorded')
 -- The member comes back under a new ID and is caught in a blast before any
 -- restore: its prior must be the original 0, not the stuck 1.
 f:arm(); f.objects[9]={tag='bastila',party=1,x=1,min_one_hp=1}; f.party={7,9}
 f.objects[22]={tag='sith3',x=3}; f.area_objects={22,9}
 f.env.OnRunScript('k_def_death01',22); assert(f.objects[9].min_one_hp==1)
 assert(f:fire(#f.timers)==false)
 assert(f.objects[9].min_one_hp==0, 'stale guard entry made the stuck flag the new prior')
end)
local function vfx_rows(f) local rows={} for _,c in ipairs(f.calls) do if c.name=='EffectVisualEffect' then rows[#rows+1]=c.args[1] end end return rows end
test('cursed/40_chain_reaction.lua','frag VFX is unreachable when blast deaths arrive after the hook returns',function(F,p)
 local f=F.new(p):load(); f:arm()
 f.env.OnRunScript('k_def_death01',20); f.env.OnRunScript('k_def_death01',21)
 local rows=vfx_rows(f); assert(#rows==2 and rows[1]==3005 and rows[2]==3005, 'deferred chain uses thermal only')
 assert(f.locals[7]==2)
end)
test('cursed/40_chain_reaction.lua','frag VFX is reached only if a death script re-enters during the damage call',function(F,p)
 local f=F.new(p):load(); f:arm(); local reentered=false
 f.overrides.ApplyEffectToObject=function(duration,effect,id,seconds)
  f.apply_effect(id,effect,duration,seconds)
  if type(effect)=='table' and effect.effect=='EffectDamage' and id==21 and not reentered then reentered=true; f.env.OnRunScript('k_def_death01',21) end
 end
 f.env.OnRunScript('k_def_death01',20)
 local rows=vfx_rows(f); assert(#rows==2 and rows[1]==3005 and rows[2]==3003, 'synchronous re-entry uses frag')
 assert(f.locals[7]==2)
end)
test('cursed/100_item_airstrike.lua','strikes only hostile non-party creatures by GetIsEnemy against the PC',function(F,p)
 local f=F.new(p):load(); f.objects[22]={tag='neutral',x=4,appearance=6}; f.area_objects={20,21,2,22}
 f.overrides.GetIsEnemy=function(target,source) assert(source==1,'hostility is judged against the PC'); return (target==20 or target==21) and 1 or 0 end
 f:arm(); f.env.OnModuleAcquireItem(40)
 local struck={}
 for _,c in ipairs(f.calls) do if c.name=='ApplyEffectToObject' and type(c.args[2])=='table' and c.args[2].effect=='EffectDamage' then struck[c.args[3]]=true end end
 assert(struck[20] and struck[21] and not struck[22] and not struck[2], 'neutral and party excluded')
 assert(f.locals[6]==2 and f.locals[7]==1)
 local asked=false; for _,c in ipairs(f.calls) do if c.name=='GetIsEnemy' and c.args[1]==22 and c.args[2]==1 then asked=true end end; assert(asked)
end)

