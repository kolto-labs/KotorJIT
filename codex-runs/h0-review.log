   428	                    close_sock(a);
   429	                } else {
   430	                    int one = 1;
   431	                    ::setsockopt(a, IPPROTO_TCP, TCP_NODELAY,
   432	                                 reinterpret_cast<const char*>(&one), sizeof one);
   433	                    client_sock_ = static_cast<std::intptr_t>(a);
   434	                    inbuf_.clear();
   435	                    outbuf_.clear();
   436	                    outbuf_pending_.store(0, std::memory_order_release);
   437	                    overflow_.store(false, std::memory_order_release);
   438	                    subscribed_.store(false, std::memory_order_release);
   439	                    client_gen_.store(next_gen_++, std::memory_order_release);
   440	                    accepted_.fetch_add(1, std::memory_order_acq_rel);
   441	                    platform::log(platform::LogLevel::Info, "harness: client connected");
   442	                    continue;   // re-select with the new socket in the set
   443	                }
   444	            }
   445	        }
   446	
   447	        if (!have_client) continue;
   448	
   449	        if (FD_ISSET(cs, &readable)) {
   450	            char buf[4096];
   451	            const int got = ::recv(cs, buf, sizeof buf, 0);
   452	            if (got == 0 || (got < 0 && !would_block(last_error()))) {
   453	                platform::log(platform::LogLevel::Info, "harness: client disconnected");
   454	                close_client();
   455	                continue;
   456	            }
   457	            if (got > 0) {
   458	                inbuf_.append(buf, static_cast<std::size_t>(got));
   459	                const std::uint64_t gen = client_gen_.load(std::memory_order_acquire);
   460	                std::size_t start = 0;
   461	                bool too_many = false;
   462	                while (true) {
   463	                    const std::size_t nl = inbuf_.find('\n', start);
   464	                    if (nl == std::string::npos) break;
   465	                    std::size_t end = nl;
   466	                    if (end > start && inbuf_[end - 1] == '\r') --end;
   467	                    if (end > start) {
   468	                        std::lock_guard<std::mutex> lock(mutex_);
   469	                        // A client that sends faster than the drain answers is
   470	                        // dropped at the ceiling rather than queued forever.
   471	                        if (requests_.size() >= kMaxQueuedRequests ||
   472	                            request_bytes_ + (end - start) > kMaxQueuedBytes) {
   473	                            too_many = true;
   474	                            break;
   475	                        }
   476	                        request_bytes_ += end - start;
   477	                        requests_.push_back({gen, inbuf_.substr(start, end - start)});
   478	                    }
   479	                    start = nl + 1;
   480	                }
   481	                inbuf_.erase(0, start);
   482	                if (too_many) {
   483	                    platform::log(platform::LogLevel::Warn,
   484	                                  "harness: request queue over %zu lines or %zu bytes; client dropped",
   485	                                  kMaxQueuedRequests, kMaxQueuedBytes);
   486	                    close_client();
   487	                    continue;
   488	                }
   489	                if (inbuf_.size() > kMaxLine) {
   490	                    ::send(cs, kTooLongLine, static_cast<int>(sizeof kTooLongLine - 1), kSendFlags);
   491	                    platform::log(platform::LogLevel::Warn,
   492	                                  "harness: line over %zu bytes; client dropped", kMaxLine);
   493	                    close_client();
   494	                    continue;
   495	                }
   496	            }
   497	        }
   498	
   499	        if (FD_ISSET(cs, &writable) && !outbuf_.empty()) {
   500	            const int sent = ::send(cs, outbuf_.data(), static_cast<int>(outbuf_.size()), kSendFlags);
   501	            if (sent > 0) {
   502	                outbuf_.erase(0, static_cast<std::size_t>(sent));
   503	                outbuf_pending_.store(outbuf_.size(), std::memory_order_release);
   504	            } else if (sent < 0 && !would_block(last_error())) {
   505	                platform::log(platform::LogLevel::Info, "harness: client write failed; dropped");
   506	                close_client();
   507	            }
   508	        }
   509	    }
