  1240	// One raw line to one reply line. Empty when the reply is deferred.
  1241	//
  1242	// Parse and serialise are the two guarded regions. A local written inside a
  1243	// guarded region is indeterminate after a claimed fault, so each fallback
  1244	// re-states the flag that the code after it reads.
  1245	//
  1246	// `condemn` comes back true when the line is not a JSON object: an HTTP
  1247	// request line, a header, garbage. That line gets its error reply and the
  1248	// connection is done; see Channel::condemn.
  1249	std::string execute_line(const std::string& raw, std::uint64_t client, bool& condemn) {
  1250	    const LineShape shape = screen_request_line(raw);
  1251	    condemn = shape != LineShape::Ok;
  1252	    Json req;
  1253	    std::string parse_error;
  1254	    bool parsed = false;
  1255	    // parse_error is written inside the guarded region, so after a claimed
  1256	    // fault its contents are indeterminate -- reading it, or even clearing it,
  1257	    // is not sound. `have_error` is the fallback's own flag: it says whether
  1258	    // the string is a message the parser wrote or memory nobody owns.
  1259	    bool have_error = false;
  1260	    KP_HOOK_GUARD_BEGIN("harness.drain", g_poison, { parsed = false; have_error = false; })
  1261	    parsed = Json::parse(raw, req, parse_error);
  1262	    have_error = true;
  1263	    KP_HOOK_GUARD_END
  1264	
  1265	    Json id = Json::null();
  1266	    Json reply;
  1267	    if (condemn) {
  1268	        reply = err_reply(id, shape == LineShape::Http
  1269	                                  ? std::string("HTTP is not spoken here; connection closed")
  1270	                                  : std::string("request must be a JSON object; connection closed"));
  1271	    } else if (!parsed) {
  1272	        condemn = true;
  1273	        reply = err_reply(id, (!have_error || parse_error.empty())
  1274	                                  ? std::string("fault while parsing; harness site poisoned")
  1275	                                  : parse_error);
  1276	    } else if (!req.is_object()) {
  1277	        condemn = true;
  1278	        reply = err_reply(id, "request must be a JSON object");
  1279	    } else {
  1280	        id = id_of(req);
  1281	        const Json* cmd = req.get("cmd");
  1282	        if (cmd == nullptr || !cmd->is_string()) {
  1283	            reply = err_reply(id, "request needs a string `cmd`");
  1284	        } else {
  1285	            Outcome out;
  1286	            dispatch(cmd->as_string(), req, out, client);
  1287	            if (out.deferred) return std::string();
  1288	            reply = out.ok ? ok_reply(id, std::move(out.result)) : err_reply(id, std::move(out.error));
  1289	        }
  1290	    }
  1291	
  1292	    std::string line;
  1293	    bool dumped = false;
  1294	    KP_HOOK_GUARD_BEGIN("harness.drain", g_poison, { dumped = false; })
  1295	    line = reply.dump();
  1296	    dumped = true;
  1297	    KP_HOOK_GUARD_END
  1298	    if (!dumped) {
  1299	        const std::string fallback = err_reply(id, "fault while serialising; harness site poisoned").dump();
  1300	        return fallback;
  1301	    }
  1302	    return line;
  1303	}
