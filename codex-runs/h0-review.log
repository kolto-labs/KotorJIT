  1430	void drain() {
  1431	    // Trivially destructible, so this stays native TLS: the DLL is loaded
  1432	    // with LoadLibrary and the simpler the thread-local, the better.
  1433	    static thread_local bool draining = false;
  1434	    if (draining) return;
  1435	    if (g_poison.load(std::memory_order_acquire)) return;
  1436	    if (g_lua_reload_requested.exchange(false, std::memory_order_acq_rel)) {
  1437	        Outcome reload;
  1438	        cmd_reload(Json::object(), reload);
  1439	        if (!reload.ok) Runtime::instance().log("harness Lua reload: %s", reload.error.c_str());
  1440	        else {
  1441	            Runtime::instance().log("harness Lua reload completed");
  1442	            if (const Json* errors = reload.result.get("errors"); errors != nullptr && errors->is_array()) {
  1443	                for (const Json& error : errors->elements())
  1444	                    Runtime::instance().log("harness Lua reload: %s", error.as_string().c_str());
  1445	            }
  1446	        }
  1447	    }
  1448	    Channel* ch = channel();
  1449	    if (ch == nullptr || !ch->running()) return;
  1450	
  1451	    struct Draining {
  1452	        bool& flag;
  1453	        explicit Draining(bool& f) : flag(f) { flag = true; }
  1454	        ~Draining() { flag = false; }
  1455	    } scoped(draining);
  1456	
  1457	    // The batch leaves the channel's queue before any guard is armed.
  1458	    std::vector<Request> batch;
  1459	    ch->take_requests(kMaxPerTick, batch);
  1460	
  1461	    std::vector<std::pair<std::uint64_t, std::string>> replies;
  1462	    replies.reserve(batch.size());
  1463	    // Condemned inside this batch. Kept local until the replies are pushed:
  1464	    // the listener closes on condemn(), and the error reply has to be queued
  1465	    // before it looks.
  1466	    std::uint64_t condemned = 0;
  1467	    for (std::size_t n = 0; n < batch.size(); ++n) {
  1468	        const Request& rq = batch[n];
  1469	        // A request from a client that left, or one that already sent a line
  1470	        // that is not a request, does not run and is not answered.
  1471	        if (rq.client == condemned || !ch->admit(rq.client)) continue;
