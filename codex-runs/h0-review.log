   198	// FNV-1a over a byte sequence. 64-bit, printed as 16 hex digits.
   199	struct Fnv {
   200	    std::uint64_t h = 1469598103934665603ull;
   201	    void add(const char* s) {
   202	        if (s == nullptr) return;
   203	        for (; *s != '\0'; ++s) add_byte(static_cast<unsigned char>(*s));
   204	        add_byte(0);
   205	    }
   206	    void add_int(std::int64_t v) {
   207	        for (int i = 0; i < 8; ++i) add_byte(static_cast<unsigned char>(v >> (8 * i)));
   208	    }
   209	    void add_byte(unsigned char b) {
   210	        h ^= b;
   211	        h *= 1099511628211ull;
   212	    }
   213	    std::string hex() const {
   214	        char buf[24];
   215	        std::snprintf(buf, sizeof buf, "%016llx", static_cast<unsigned long long>(h));
   216	        return buf;
   217	    }
   218	};
