   157	// A JSON number as an argument the command can use. A finite number outside
   158	// the target range is refused rather than converted: converting it is
   159	// undefined behaviour, and `1e20` is a line a client can send.
   160	bool as_int_arg(const Json& v, int& out) {
   161	    if (!v.is_number()) return false;
   162	    const double d = v.as_number();
   163	    if (std::isnan(d) || std::isinf(d)) return false;
   164	    const double t = std::trunc(d);
   165	    if (t < -2147483648.0 || t > 2147483647.0) return false;
   166	    out = static_cast<int>(t);
   167	    return true;
   168	}
   169	
   170	// The same for a count or a cursor: negative and out of range both refuse.
   171	bool as_uint_arg(const Json& v, std::uint64_t& out) {
   172	    if (!v.is_number()) return false;
   173	    const double d = v.as_number();
   174	    if (std::isnan(d) || std::isinf(d)) return false;
   175	    const double t = std::trunc(d);
   176	    if (t < 0.0 || t > 9007199254740992.0) return false;
   177	    out = static_cast<std::uint64_t>(t);
   178	    return true;
   179	}
   180	
   181	// Engine work runs in an unarmed hook-body frame: the fault guard knows we
   182	// are inside our own code (so a nested armed frame still claims correctly)
   183	// but claims nothing at this depth. See the header. HookBodyScope leaves the
   184	// frame on every exit, so an allocation failure inside fn cannot leave the
   185	// thread's depth counter raised and its fault-frame state poisoned.
   186	template <typename Fn>
   187	auto engine(Fn&& fn) -> decltype(fn()) {
   188	    HookBodyScope scope;
   189	    return fn();
   190	}
