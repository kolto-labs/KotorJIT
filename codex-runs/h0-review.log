   260	        request_bytes_ -= request_bytes_ < bytes ? request_bytes_ : bytes;
   261	        out.push_back(std::move(requests_[i]));
   262	    }
   263	    requests_.erase(requests_.begin(), requests_.begin() + static_cast<std::ptrdiff_t>(n));
   264	    return n;
   265	}
   266	
   267	void Channel::push_reply(std::uint64_t client, std::string line) {
   268	    if (client == 0 || client != current_client()) return;
   269	    std::lock_guard<std::mutex> lock(mutex_);
   270	    // Over the ceiling the reply is refused rather than queued: the client is
   271	    // not reading, and the listener closes the connection on the flag.
   272	    if (replies_.size() >= kMaxQueuedReplies || reply_bytes_ + line.size() > kMaxQueuedBytes) {
   273	        overflow_.store(true, std::memory_order_release);
   274	        return;
   275	    }
   276	    reply_bytes_ += line.size();
   277	    replies_.push_back({client, std::move(line)});
   278	}
   279	
   280	std::size_t Channel::pending_requests() {
   281	    std::lock_guard<std::mutex> lock(mutex_);
   282	    return requests_.size();
   283	}
   284	
   285	std::size_t Channel::pending_replies() {
   286	    std::lock_guard<std::mutex> lock(mutex_);
   287	    return replies_.size();
   288	}
   289	
   290	bool Channel::wait_flushed(unsigned timeout_ms) {
   291	    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
   292	    while (std::chrono::steady_clock::now() < deadline) {
   293	        if (!client_connected() || !running()) return true;
   294	        bool empty;
   295	        {
   296	            std::lock_guard<std::mutex> lock(mutex_);
   297	            empty = replies_.empty();
   298	        }
   299	        // Both halves have to be empty. The reply queue drains into outbuf_
   300	        // before the socket is even selected, so a queue that has just gone
   301	        // empty says nothing about whether the bytes left: the listener
   302	        // publishes outbuf_'s size after every append and every send, and that
   303	        // is the half this reads. outbuf_ itself stays the listener's own.
   304	        empty = empty && outbuf_pending_.load(std::memory_order_acquire) == 0;
   305	        if (empty) {
   306	            std::this_thread::sleep_for(std::chrono::microseconds(2 * kSelectWaitUs));
   307	            return true;
   308	        }
   309	        std::this_thread::sleep_for(std::chrono::milliseconds(1));
   310	    }
   311	    return false;
   312	}
   313	
   314	void Channel::run() {
   315	    // Nothing that fails inside the loop may leave this thread: an allocation
   316	    // or a logging failure escaping run() would call std::terminate and take
   317	    // the game with it. A failure here costs the connection, never the process.
   318	    try {
   319	        run_loop();
   320	    } catch (...) {
   321	        close_client();
   322	        try {
   323	            platform::log(platform::LogLevel::Warn,
   324	                          "harness: listener hit an allocation or I/O failure; client dropped");
   325	        } catch (...) {
   326	        }
   327	    }
   328	}
   329	
   330	void Channel::run_loop() {
   331	    const sock_t ls = static_cast<sock_t>(listen_sock_);
   332	
   333	    while (!stop_.load(std::memory_order_acquire)) {
   334	        const sock_t cs = static_cast<sock_t>(client_sock_);
   335	        const bool have_client = cs != kInvalidSock && client_sock_ != -1;
   336	
   337	        if (have_client && overflow_.load(std::memory_order_acquire)) {
   338	            platform::log(platform::LogLevel::Warn,
   339	                          "harness: reply queue over %zu lines or %zu bytes; client dropped",
   340	                          kMaxQueuedReplies, kMaxQueuedBytes);
   341	            close_client();
   342	            continue;
   343	        }
   344	
   345	        // Read before the reply pull. The main thread condemns a client only
   346	        // after pushing its error reply, so a condemnation seen here means
   347	        // the pull below already holds that reply.
   348	        const bool doomed = have_client &&
   349	                            condemned_gen_.load(std::memory_order_acquire) ==
   350	                                client_gen_.load(std::memory_order_acquire);
   351	
   352	        // Pull queued replies into the write buffer before selecting, so a
   353	        // reply queued while we waited goes out on this round.
   354	        if (have_client) {
   355	            std::lock_guard<std::mutex> lock(mutex_);
   356	            const std::uint64_t gen = client_gen_.load(std::memory_order_acquire);
   357	            for (Reply& r : replies_) {
   358	                if (r.client != gen) continue;
   359	                outbuf_ += r.line;
   360	                outbuf_.push_back('\n');
   361	            }
   362	            replies_.clear();
   363	            reply_bytes_ = 0;
   364	            outbuf_pending_.store(outbuf_.size(), std::memory_order_release);
   365	        }
   366	
   367	        // A condemned client gets what was queued for it, in one non-blocking
   368	        // write, and is closed. Nothing it sent after the bad line runs: the
   369	        // drain's admit() refuses the generation, and close_client() drops
   370	        // whatever the listener still held.
   371	        if (doomed) {
   372	            if (!outbuf_.empty())
   373	                ::send(cs, outbuf_.data(), static_cast<int>(outbuf_.size()), kSendFlags);
   374	            platform::log(platform::LogLevel::Warn,
   375	                          "harness: client sent a line that is not a JSON request; client dropped");
   376	            close_client();
   377	            continue;
   378	        }
   379	
   380	        if (have_client && outbuf_.size() > kMaxOutBytes) {
   381	            platform::log(platform::LogLevel::Warn,
   382	                          "harness: unsent replies over %zu bytes; client dropped", kMaxOutBytes);
   383	            close_client();
   384	            continue;
   385	        }
   386	
   387	        fd_set readable;
   388	        fd_set writable;
   389	        FD_ZERO(&readable);
   390	        FD_ZERO(&writable);
   391	        FD_SET(ls, &readable);
   392	        int maxfd = static_cast<int>(ls);
   393	        if (have_client) {
   394	            FD_SET(cs, &readable);
   395	            if (!outbuf_.empty()) FD_SET(cs, &writable);
   396	            if (static_cast<int>(cs) > maxfd) maxfd = static_cast<int>(cs);
   397	        }
   398	
   399	        timeval tv{};
   400	        tv.tv_sec = 0;
   401	        tv.tv_usec = kSelectWaitUs;
   402	        const int n = ::select(maxfd + 1, &readable, &writable, nullptr, &tv);
   403	        if (n <= 0) continue;
   404	
   405	        if (FD_ISSET(ls, &readable)) {
   406	            sockaddr_in peer{};
   407	            socklen_t plen = sizeof peer;
   408	            const sock_t a = ::accept(ls, reinterpret_cast<sockaddr*>(&peer), &plen);
   409	            if (a != kInvalidSock) {
   410	                if (have_client || !fd_in_select_range(a)) {
   411	                    const bool no_room = !fd_in_select_range(a);
   412	                    // Refused, not queued: a driver that connects twice must
   413	                    // learn it at once, not when the first session ends. The
   414	                    // socket is put in non-blocking mode first, so a peer that
   415	                    // never reads cannot hold the listener in send(); one
   416	                    // partial write is all this line is worth.
   417	                    if (no_room)
   418	                        platform::log(platform::LogLevel::Warn,
   419	                                      "harness: refusing a descriptor at or above FD_SETSIZE");
   420	                    set_nonblocking(a);
   421	                    const char* line = no_room ? kNoRoomLine : kBusyLine;
   422	                    const std::size_t len = no_room ? sizeof kNoRoomLine - 1 : sizeof kBusyLine - 1;
   423	                    ::send(a, line, static_cast<int>(len), kSendFlags);
   424	                    close_sock(a);
   425	                } else if (!set_nonblocking(a)) {
   426	                    platform::log(platform::LogLevel::Warn,
   427	                                  "harness: cannot put the client socket in non-blocking mode; refused");
   428	                    close_sock(a);
   429	                } else {
   430	                    int one = 1;
   431	                    ::setsockopt(a, IPPROTO_TCP, TCP_NODELAY,
   432	                                 reinterpret_cast<const char*>(&one), sizeof one);
   433	                    client_sock_ = static_cast<std::intptr_t>(a);
   434	                    inbuf_.clear();
   435	                    outbuf_.clear();
   436	                    outbuf_pending_.store(0, std::memory_order_release);
   437	                    overflow_.store(false, std::memory_order_release);
   438	                    subscribed_.store(false, std::memory_order_release);
   439	                    client_gen_.store(next_gen_++, std::memory_order_release);
   440	                    accepted_.fetch_add(1, std::memory_order_acq_rel);
   441	                    platform::log(platform::LogLevel::Info, "harness: client connected");
   442	                    continue;   // re-select with the new socket in the set
   443	                }
   444	            }
   445	        }
   446	
   447	        if (!have_client) continue;
   448	
   449	        if (FD_ISSET(cs, &readable)) {
   450	            char buf[4096];
   451	            const int got = ::recv(cs, buf, sizeof buf, 0);
   452	            if (got == 0 || (got < 0 && !would_block(last_error()))) {
   453	                platform::log(platform::LogLevel::Info, "harness: client disconnected");
   454	                close_client();
   455	                continue;
   456	            }
   457	            if (got > 0) {
   458	                inbuf_.append(buf, static_cast<std::size_t>(got));
   459	                const std::uint64_t gen = client_gen_.load(std::memory_order_acquire);
   460	                std::size_t start = 0;
   461	                bool too_many = false;
   462	                while (true) {
   463	                    const std::size_t nl = inbuf_.find('\n', start);
   464	                    if (nl == std::string::npos) break;
   465	                    std::size_t end = nl;
   466	                    if (end > start && inbuf_[end - 1] == '\r') --end;
   467	                    if (end > start) {
   468	                        std::lock_guard<std::mutex> lock(mutex_);
   469	                        // A client that sends faster than the drain answers is
   470	                        // dropped at the ceiling rather than queued forever.
   471	                        if (requests_.size() >= kMaxQueuedRequests ||
   472	                            request_bytes_ + (end - start) > kMaxQueuedBytes) {
   473	                            too_many = true;
   474	                            break;
   475	                        }
   476	                        request_bytes_ += end - start;
   477	                        requests_.push_back({gen, inbuf_.substr(start, end - start)});
   478	                    }
   479	                    start = nl + 1;
   480	                }
   481	                inbuf_.erase(0, start);
   482	                if (too_many) {
   483	                    platform::log(platform::LogLevel::Warn,
   484	                                  "harness: request queue over %zu lines or %zu bytes; client dropped",
   485	                                  kMaxQueuedRequests, kMaxQueuedBytes);
   486	                    close_client();
   487	                    continue;
   488	                }
   489	                if (inbuf_.size() > kMaxLine) {
   490	                    ::send(cs, kTooLongLine, static_cast<int>(sizeof kTooLongLine - 1), kSendFlags);
   491	                    platform::log(platform::LogLevel::Warn,
   492	                                  "harness: line over %zu bytes; client dropped", kMaxLine);
   493	                    close_client();
   494	                    continue;
   495	                }
   496	            }
   497	        }
   498	
   499	        if (FD_ISSET(cs, &writable) && !outbuf_.empty()) {
   500	            const int sent = ::send(cs, outbuf_.data(), static_cast<int>(outbuf_.size()), kSendFlags);
   501	            if (sent > 0) {
   502	                outbuf_.erase(0, static_cast<std::size_t>(sent));
   503	                outbuf_pending_.store(outbuf_.size(), std::memory_order_release);
   504	            } else if (sent < 0 && !would_block(last_error())) {
   505	                platform::log(platform::LogLevel::Info, "harness: client write failed; dropped");
   506	                close_client();
   507	            }
   508	        }
   509	    }
   510	}
