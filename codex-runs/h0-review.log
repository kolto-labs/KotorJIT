   221	
   222	// A state of the harness's own, with the same API every script and the
   223	// console get. Not a script's state: a harness typo must not quarantine a
   224	// loaded script, and `reload` closes and rebuilds this one along with theirs.
   225	lua_State*  g_L = nullptr;
   226	std::string g_lua_output;
   227	
   228	int harness_print(lua_State* L) {
   229	    const int n = lua_gettop(L);
   230	    for (int i = 1; i <= n; ++i) {
   231	        if (i > 1) g_lua_output += "\t";
   232	        const char* s = lua_tostring(L, i);
   233	        g_lua_output += (s != nullptr) ? s : luaL_typename(L, i);
   234	    }
   235	    g_lua_output += "\n";
   236	    return 0;
   237	}
   238	
   239	lua_State* harness_state() {
   240	    if (g_L != nullptr) return g_L;
   241	    g_L = luaL_newstate();
   242	    if (g_L == nullptr) return nullptr;
   243	    luaL_openlibs(g_L);
   244	    runtime::init_lua_state(g_L);
   245	    api::push_kp_table(g_L);
   246	    lua_pushcfunction(g_L, harness_print);
   247	    lua_setfield(g_L, -2, "print");
   248	    lua_pop(g_L, 1);
   249	    return g_L;
   250	}
   251	
   252	void close_harness_state() {
   253	    if (g_L != nullptr) { lua_close(g_L); g_L = nullptr; }
   254	}
   255	
   256	// Lua value -> JSON. Tables nest to a small depth; anything else that has no
   257	// JSON spelling becomes its type name so the driver sees what it got.
   258	constexpr int kLuaDepth = 4;
   259	
   260	Json lua_to_json(lua_State* L, int idx, int depth) {
   261	    // LuaJIT has no lua_absindex; a relative index must be made absolute by
   262	    // hand before lua_next pushes over it.
   263	    if (idx < 0) idx = lua_gettop(L) + idx + 1;
   264	    switch (lua_type(L, idx)) {
   265	    case LUA_TNIL:     return Json::null();
   266	    case LUA_TBOOLEAN: return Json::boolean(lua_toboolean(L, idx) != 0);
   267	    case LUA_TNUMBER:  return Json::number(lua_tonumber(L, idx));
   268	    case LUA_TSTRING: {
   269	        std::size_t len = 0;
   270	        const char* s = lua_tolstring(L, idx, &len);
   271	        return Json::string(std::string(s, len));
   272	    }
   273	    case LUA_TTABLE: {
   274	        if (depth >= kLuaDepth) return Json::string("table");
   275	        // Array iff every key is an integer 1..n.
   276	        std::size_t entries = 0;
   277	        bool array = true;
   278	        lua_pushnil(L);
   279	        while (lua_next(L, idx) != 0) {
   280	            ++entries;
   281	            if (lua_type(L, -2) != LUA_TNUMBER) array = false;
   282	            else {
   283	                const lua_Number k = lua_tonumber(L, -2);
   284	                if (k < 1 || k != static_cast<lua_Number>(static_cast<long long>(k))) array = false;
   285	            }
   286	            lua_pop(L, 1);
   287	        }
   288	        const std::size_t n = lua_objlen(L, idx);
   289	        if (array && entries == n) {
   290	            Json a = Json::array();
   291	            for (std::size_t i = 1; i <= n; ++i) {
   292	                lua_rawgeti(L, idx, static_cast<int>(i));
   293	                a.push(lua_to_json(L, -1, depth + 1));
   294	                lua_pop(L, 1);
   295	            }
   296	            return a;
   297	        }
   298	        Json o = Json::object();
   299	        lua_pushnil(L);
   300	        while (lua_next(L, idx) != 0) {
   301	            std::string key;
   302	            if (lua_type(L, -2) == LUA_TSTRING) {
   303	                key = lua_tostring(L, -2);
   304	            } else if (lua_type(L, -2) == LUA_TNUMBER) {
   305	                char buf[32];
   306	                std::snprintf(buf, sizeof buf, "%.17g", lua_tonumber(L, -2));
   307	                key = buf;
   308	            } else {
   309	                key = luaL_typename(L, -2);
   310	            }
   311	            o.set(std::move(key), lua_to_json(L, -1, depth + 1));
   312	            lua_pop(L, 1);
   313	        }
   314	        return o;
   315	    }
   316	    default: {
   317	        char buf[64];
   318	        std::snprintf(buf, sizeof buf, "%s: %p", luaL_typename(L, idx), lua_topointer(L, idx));
   319	        return Json::string(buf);
   320	    }
   321	    }
   322	}
   323	
   324	// Run `code` in the harness state. Returns false with `error` on a parse or
   325	// runtime error; on success `values` holds the chunk's returns and `output`
   326	// whatever it printed. Not guarded here: the caller arms the guard, because
   327	// the fallback has to re-state the caller's own locals.
   328	bool run_lua(const std::string& code, const char* chunk_name, Json& values,
   329	             std::string& output, std::string& error) {
   330	    lua_State* L = harness_state();
   331	    if (L == nullptr) { error = "cannot create the harness lua state"; return false; }
   332	    g_lua_output.clear();
   333	    const int base = lua_gettop(L);
   334	
   335	    // An expression first, so `return` is optional the way it is on the
   336	    // console, then the text as a statement.
   337	    const std::string as_expr = "return " + code;
   338	    if (luaL_loadbuffer(L, as_expr.c_str(), as_expr.size(), chunk_name) != 0) {
   339	        lua_pop(L, 1);
   340	        if (luaL_loadbuffer(L, code.c_str(), code.size(), chunk_name) != 0) {
   341	            const char* msg = lua_tostring(L, -1);
   342	            error = msg != nullptr ? msg : "parse failed";
   343	            lua_settop(L, base);
   344	            return false;
   345	        }
   346	    }
   347	    if (lua_pcall(L, 0, LUA_MULTRET, 0) != 0) {
   348	        const char* msg = lua_tostring(L, -1);
   349	        error = msg != nullptr ? msg : "error";
   350	        output = g_lua_output;
   351	        lua_settop(L, base);
   352	        return false;
   353	    }
   354	    const int nres = lua_gettop(L) - base;
   355	    values = Json::array();
   356	    for (int i = 1; i <= nres; ++i) values.push(lua_to_json(L, base + i, 0));
   357	    output = g_lua_output;
   358	    lua_settop(L, base);
   359	    return true;
   360	}
