   119	Json err_reply(const Json& id, std::string error) {
   120	    Json r = Json::object();
   121	    r.set("id", id);
   122	    r.set("ok", Json::boolean(false));
   123	    r.set("error", Json::string(std::move(error)));
   124	    return r;
   125	}
