  1305	// After `subscribe`, every new ring record goes out as a frame. Bounded per
  1306	// frame so a burst of scripts cannot turn one client frame into a flood.
  1307	constexpr std::size_t kStreamPerTick = 256;
  1308	
  1309	void stream_events(Channel& ch) {
  1310	    if (!ch.subscribed()) return;
  1311	    const std::uint64_t client = ch.current_client();
  1312	    if (client == 0 || client != g_stream_client) return;
  1313	
  1314	    const std::uint64_t oldest = ring().oldest_seq();
  1315	    if (oldest != 0 && g_stream_cursor + 1 < oldest) {
  1316	        // The ring wrapped past the cursor: say so rather than pretend the
  1317	        // missing records never happened.
  1318	        Json gap = Json::object();
  1319	        gap.set("event", Json::string("harness.gap"));
  1320	        gap.set("tick", Json::unsigned_(server_tick()));
  1321	        gap.set("seq", Json::unsigned_(oldest));
  1322	        gap.set("dropped", Json::unsigned_(oldest - g_stream_cursor - 1));
  1323	        ch.push_reply(client, gap.dump());
  1324	        g_stream_cursor = oldest - 1;
  1325	    }
  1326	
  1327	    std::vector<EventRecord> records;
  1328	    ring().read_since(g_stream_cursor, kStreamPerTick, records);
  1329	    for (const EventRecord& rec : records) {
  1330	        ch.push_reply(client, record_json(rec).dump());
  1331	        g_stream_cursor = rec.seq;
  1332	    }
  1333	}
