   362	// ----------------------------------------------------------- screenshot -----
   363	//
   364	// GL entry points resolved by name at first use, never linked: the DLL must
   365	// load in a process that has not yet loaded opengl32, and the native build
   366	// must not drag libGL into a link that otherwise needs none.
   367	
   368	#if defined(_WIN32)
   369	#define KP_GLAPI __attribute__((stdcall))
   370	#else
   371	#define KP_GLAPI
   372	#endif
   373	
   374	using GlGetIntegerv = void (KP_GLAPI*)(unsigned, int*);
   375	using GlReadBuffer  = void (KP_GLAPI*)(unsigned);
   376	using GlPixelStorei = void (KP_GLAPI*)(unsigned, int);
   377	using GlReadPixels  = void (KP_GLAPI*)(int, int, int, int, unsigned, unsigned, void*);
   378	using GlGetError    = unsigned (KP_GLAPI*)();
   379	
   380	constexpr unsigned kGlViewport      = 0x0BA2;
   381	constexpr unsigned kGlFront         = 0x0404;
   382	constexpr unsigned kGlPackAlignment = 0x0D05;
   383	constexpr unsigned kGlRgb           = 0x1907;
   384	constexpr unsigned kGlUnsignedByte  = 0x1401;
   385	
   386	struct Gl {
   387	    bool          resolved = false;
   388	    GlGetIntegerv get_integerv = nullptr;
   389	    GlReadBuffer  read_buffer = nullptr;
   390	    GlPixelStorei pixel_storei = nullptr;
   391	    GlReadPixels  read_pixels = nullptr;
   392	    GlGetError    get_error = nullptr;
   393	};
   394	Gl g_gl;
   395	
   396	void* gl_symbol(const char* name) {
   397	#if defined(_WIN32)
   398	    HMODULE m = GetModuleHandleA("opengl32.dll");
   399	    if (m == nullptr) return nullptr;
   400	    return reinterpret_cast<void*>(GetProcAddress(m, name));
   401	#else
   402	    return ::dlsym(RTLD_DEFAULT, name);
   403	#endif
   404	}
   405	
   406	bool resolve_gl(std::string& error) {
   407	    if (g_gl.resolved) return true;
   408	    g_gl.get_integerv = reinterpret_cast<GlGetIntegerv>(gl_symbol("glGetIntegerv"));
   409	    g_gl.read_buffer  = reinterpret_cast<GlReadBuffer>(gl_symbol("glReadBuffer"));
   410	    g_gl.pixel_storei = reinterpret_cast<GlPixelStorei>(gl_symbol("glPixelStorei"));
   411	    g_gl.read_pixels  = reinterpret_cast<GlReadPixels>(gl_symbol("glReadPixels"));
   412	    g_gl.get_error    = reinterpret_cast<GlGetError>(gl_symbol("glGetError"));
   413	    if (g_gl.get_integerv == nullptr || g_gl.read_buffer == nullptr ||
   414	        g_gl.pixel_storei == nullptr || g_gl.read_pixels == nullptr) {
   415	        error = "GL entry points not found; is a GL context loaded in this process?";
   416	        return false;
   417	    }
   418	    g_gl.resolved = true;
   419	    return true;
   420	}
   421	
   422	// Front buffer to a binary PPM at `path`. Runs after orig(self) returned in
   423	// the client-loop detour, on the render thread, so the context is current.
   424	bool write_screenshot(const std::string& path, int& width, int& height, std::string& error) {
   425	    if (!resolve_gl(error)) return false;
   426	
   427	    int viewport[4] = {0, 0, 0, 0};
   428	    g_gl.get_integerv(kGlViewport, viewport);
   429	    width = viewport[2];
   430	    height = viewport[3];
   431	    if (width <= 0 || height <= 0 || width > 16384 || height > 16384) {
   432	        error = "viewport is empty; no frame to read";
   433	        return false;
   434	    }
   435	
   436	    std::vector<unsigned char> pixels(static_cast<std::size_t>(width) * height * 3);
   437	    if (g_gl.get_error != nullptr) g_gl.get_error();   // clear anything stale
   438	    g_gl.read_buffer(kGlFront);
   439	    g_gl.pixel_storei(kGlPackAlignment, 1);
   440	    g_gl.read_pixels(0, 0, width, height, kGlRgb, kGlUnsignedByte, pixels.data());
   441	    if (g_gl.get_error != nullptr) {
   442	        const unsigned e = g_gl.get_error();
   443	        if (e != 0) {
   444	            char buf[64];
   445	            std::snprintf(buf, sizeof buf, "glReadPixels failed: GL error 0x%x", e);
   446	            error = buf;
   447	            return false;
   448	        }
   449	    }
   450	
   451	    std::FILE* f = std::fopen(path.c_str(), "wb");
   452	    if (f == nullptr) { error = "cannot open " + path + " for writing"; return false; }
   453	    // Every write is checked. A full disk used to be reported as a successful
   454	    // screenshot, and the driver then compared a truncated file; the partial
   455	    // file is removed so nothing downstream reads half a frame.
   456	    bool wrote = std::fprintf(f, "P6\n%d %d\n255\n", width, height) > 0;
   457	    // GL rows run bottom-up; PPM runs top-down.
   458	    const std::size_t stride = static_cast<std::size_t>(width) * 3;
   459	    for (int y = height - 1; wrote && y >= 0; --y)
   460	        wrote = std::fwrite(pixels.data() + static_cast<std::size_t>(y) * stride, 1, stride, f) == stride;
   461	    if (std::fclose(f) != 0) wrote = false;
   462	    if (!wrote) {
   463	        std::remove(path.c_str());
   464	        error = "cannot write " + path + " (disk full or path not writable)";
   465	        return false;
   466	    }
   467	    return true;
   468	}
