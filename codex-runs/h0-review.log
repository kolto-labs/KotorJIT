  1480	                if (batch[i].client != condemned)
  1481	                    replies.emplace_back(batch[i].client,
  1482	                                         err_reply(Json::null(), "harness site poisoned").dump());
  1483	            break;
  1484	        }
  1485	    }
  1486	    for (auto& r : replies) ch->push_reply(r.first, std::move(r.second));
  1487	    if (condemned != 0) ch->condemn(condemned);
  1488	
  1489	    stream_events(*ch);
  1490	}
