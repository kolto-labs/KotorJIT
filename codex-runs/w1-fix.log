#!/usr/bin/env python3
"""Schema and contract test for native-Windows KotorPhasor receipts.

A receipt is what closes a native platform cell (plan: fan-out F section 3):
OS/build, CPU/translation, container+slice sha, DLL/proxy sha, log hash and
the physical F12 result. Wine never closes a native cell, so a receipt whose
runtime log line says wine=yes is rejected as a native receipt, whatever its
top-level fields claim.

Everything here is offline and synthetic: fixtures in
tools/fixtures/platform-receipts/ carry no retail bytes (exe shas are the
public BuildRecord identities; DLL and log shas are filler).

Since CI has no Windows PowerShell, the test also pins the text contracts the
PowerShell scripts depend on: the receipt script emits every key the validator
requires, its log regexes match the lines the C++ actually formats, and the
installer's exe allowlist names only BuildRecord shas.

    python3 tools/platform_receipt_test.py                  # run tests
    python3 tools/platform_receipt_test.py --validate r.json   # check one receipt
    python3 tools/platform_receipt_test.py --validate r.json --log kotorphasor.log

The installer and parser-parity tests run the real PowerShell under pwsh and
skip without it. From a container, set KP_PWSH="host-cmd pwsh"; KP_SCRATCH
picks where their synthetic game folders go.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
FIXTURES = ROOT / "tools/fixtures/platform-receipts"
RECEIPT_PS1 = ROOT / "scripts/receipts/windows-native-receipt.ps1"
INSTALL_PS1 = ROOT / "scripts/install/windows/Install-KotorPhasor.ps1"
HEX64 = re.compile(r"^[0-9a-f]{64}$")

SCHEMA = "kotorphasor.native-receipt/v1"
REQUIRED = {
    "os": ["family", "product", "version", "build"],
    "cpu": ["arch", "translation"],
    "host": ["wine", "wine_version", "log_os", "overlays", "wine_registry"],
    "game": ["exe_name", "exe_sha256", "container_sha256", "slice_sha256"],
    "runtime": ["kphasor_dll_sha256", "proxy_binkw32_sha256", "real_binkw32_sha256"],
    "gl": ["vendor", "renderer", "version"],
    "log": ["sha256", "bytes", "session_start_line", "session_id", "host_line", "gl_line",
            "session_marker_lines", "host_like_lines", "gl_like_lines", "problems"],
    "f12": ["result", "method", "attested_by"],
}
SHA_FIELDS = [("game", "exe_sha256"), ("game", "container_sha256"), ("game", "slice_sha256"),
              ("runtime", "kphasor_dll_sha256"), ("runtime", "proxy_binkw32_sha256"),
              ("runtime", "real_binkw32_sha256"), ("log", "sha256")]

# kotorphasor.log line shapes. Every line is "[<phase>] <body>" (Runtime::log).
# Lines that come through the platform sink, which is everything a Lua script
# can log (print, kp.diagnostic), read "[<phase>] <level>: <body>". The
# kp-session lines are written by overlay.cpp straight to Runtime::log, so they
# have no level token. The patterns match a whole line (fullmatch here,
# ^...$ with -cmatch in the PS1); test_receipt_regexes_match_python pins them.
BANNER_RE = r"\[[a-z-]+\] KotorPhasor \S+ starting \([a-z-]+ role\)"
SESSION_RE = r"\[[a-z-]+\] kp-session=([0-9a-f]{32}) start"
HOST_RE = (r"\[[a-z-]+\] kp-session=([0-9a-f]{32}) host: wine=(yes|no) wine_version=(\S+)"
           r" os=(\d+)\.(\d+)\.(\d+) overlays=(\S+)")
GL_RE = r'\[[a-z-]+\] kp-session=([0-9a-f]{32}) gl: vendor="([^"]*)" renderer="([^"]*)" version="([^"]*)"'
# Substrings that make a line count as a claim of each kind, anchored or not.
# A script that prints "host: wine=no" adds a second host-like line to the
# session, and a session with more than one is refused.
MARKER, HOST_LIKE, GL_LIKE = "kp-session=", "host: wine=", "gl: vendor="
# A VM without GPU passthrough is not acceptance (plan section 3).
SOFTWARE_RENDERERS = ("llvmpipe", "softpipe", "lavapipe", "microsoft basic render driver",
                      "gdi generic", "swiftshader")
# GL vendor/renderer text that native Windows drivers do not report: Mesa and
# its Linux drivers (what Wine passes through on Linux), Wine itself, macOS
# GL, and VM adapters. The version string is not checked: Microsoft's OpenGL
# compatibility layer on ARM64 Windows is Mesa-based and says so there.
NON_NATIVE_GL = ("mesa", "radeonsi", "r600", "zink", "virgl", "nouveau", "crocus", "gallium",
                 "panfrost", "freedreno", "asahi", "svga3d", "vmware", "virtualbox", "wine",
                 "opengl engine", "apple")
LINUX_DRM = re.compile(r"\bdrm \d")    # "(..., DRM 3.57, 6.10.6)" in Mesa renderers


def split_log_lines(text: str) -> list[str]:
    """Lines as PowerShell Get-Content yields them: split on CRLF, CR or LF."""
    lines = re.split(r"\r\n|\r|\n", text)
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def session_evidence(lines: list[str]) -> dict:
    """What windows-native-receipt.ps1 Get-SessionEvidence records under log.

    The current session is everything after the last runtime start banner.
    Inside it there must be exactly one kp-session start line, one host-like
    line and one gl-like line; every kp-session line must be one of the three
    anchored shapes and carry the start line's id; start comes first. A line
    is only reported when those rules hold, so a spoofed, doubled or stale
    line leaves host_line or gl_line null.
    """
    ev = {"session_start_line": None, "session_id": None, "host_line": None, "gl_line": None,
          "session_marker_lines": 0, "host_like_lines": 0, "gl_like_lines": 0, "problems": []}
    problems = ev["problems"]
    start = None
    for i, line in enumerate(lines):
        if re.fullmatch(BANNER_RE, line):
            start = i
    if start is None:
        problems.append("no KotorPhasor start banner in the log")
        return ev
    ev["session_start_line"] = lines[start]
    session = lines[start + 1:]
    starts, hosts, gls, ids = [], [], [], set()
    for i, line in enumerate(session):
        if MARKER in line:
            ev["session_marker_lines"] += 1
            m = (re.fullmatch(SESSION_RE, line) or re.fullmatch(HOST_RE, line)
                 or re.fullmatch(GL_RE, line))
            if m is None:
                problems.append(f"session line {i + 1} mentions kp-session= but is not a runtime line")
            else:
                ids.add(m.group(1))
            if re.fullmatch(SESSION_RE, line):
                starts.append((i, line))
        if HOST_LIKE in line:
            ev["host_like_lines"] += 1
            hosts.append((i, line))
        if GL_LIKE in line:
            ev["gl_like_lines"] += 1
            gls.append((i, line))
    if len(starts) != 1:
        problems.append(f"{len(starts)} kp-session start lines in the current session, want 1")
    if len(ids) > 1:
        problems.append(f"{len(ids)} different session ids in the current session")
    if len(hosts) != 1:
        problems.append(f"{len(hosts)} host lines in the current session, want 1")
    if len(gls) != 1:
        problems.append(f"{len(gls)} gl lines in the current session, want 1")
    if problems:
        return ev
    (s_i, s_line), (h_i, h_line), (g_i, g_line) = starts[0], hosts[0], gls[0]
    if not re.fullmatch(HOST_RE, h_line):
        problems.append("the host line is not in the runtime's anchored format")
    if not re.fullmatch(GL_RE, g_line):
        problems.append("the gl line is not in the runtime's anchored format")
    if not (s_i < h_i and s_i < g_i):
        problems.append("host or gl line comes before the session start line")
    if problems:
        return ev
    ev["session_id"] = re.fullmatch(SESSION_RE, s_line).group(1)
    ev["host_line"], ev["gl_line"] = h_line, g_line
    return ev


def build_record_shas() -> dict[str, str]:
    text = (ROOT / "src/generated/builds.inc").read_text()
    body = text.split("static const BuildRecord kBuilds[] = {", 1)[1]
    return {sha: alias for alias, sha in
            re.findall(r'\{\s*"(\w+)",\s*"([0-9a-f]{64})",', body)}


def validate(r: dict, records: dict[str, str] | None = None, log_bytes: bytes | None = None) -> list[str]:
    """Reasons this is not a valid native-Windows receipt; empty when valid.

    With log_bytes (the kotorphasor.log the receipt names), the log section is
    re-derived from the log itself and must match; without it the validator
    can only check the receipt against the lines it quotes.
    """
    records = build_record_shas() if records is None else records
    errs: list[str] = []
    if r.get("schema") != SCHEMA:
        errs.append(f"schema is {r.get('schema')!r}, want {SCHEMA!r}")
    if r.get("kind") != "windows-native":
        errs.append(f"kind is {r.get('kind')!r}, want 'windows-native'")
    for section, keys in REQUIRED.items():
        sec = r.get(section)
        if not isinstance(sec, dict):
            errs.append(f"missing section {section}")
            continue
        for k in keys:
            if k not in sec:
                errs.append(f"missing {section}.{k}")
    if errs:
        return errs

    for section, k in SHA_FIELDS:
        v = r[section][k]
        if not isinstance(v, str) or not HEX64.match(v):
            errs.append(f"{section}.{k} is not a lowercase sha256: {v!r}")

    if r["os"]["family"] != "windows":
        errs.append(f"os.family is {r['os']['family']!r}")

    log, host, gl = r["log"], r["host"], r["gl"]
    if log_bytes is not None:
        if hashlib.sha256(log_bytes).hexdigest() != log["sha256"]:
            errs.append("log.sha256 does not match the log given")
        if len(log_bytes) != log["bytes"]:
            errs.append(f"log.bytes {log['bytes']} does not match the log given ({len(log_bytes)})")
        derived = session_evidence(split_log_lines(log_bytes.decode("utf-8", "replace")))
        for k, v in derived.items():
            if log.get(k) != v:
                errs.append(f"log.{k} {log.get(k)!r} does not match the log, which gives {v!r}")

    # The current session: one start, one host, one gl line, one id.
    if log["problems"]:
        for p in log["problems"]:
            errs.append(f"log: {p}")
    for k, want in (("session_marker_lines", 3), ("host_like_lines", 1), ("gl_like_lines", 1)):
        if log[k] != want:
            errs.append(f"log.{k} is {log[k]!r}, want {want}: a line was added, doubled or lost")
    sid = log["session_id"]
    if not (isinstance(sid, str) and re.fullmatch(r"[0-9a-f]{32}", sid)):
        errs.append(f"log.session_id {sid!r} is not a 32-hex runtime session id")
    if not (isinstance(log["session_start_line"], str) and re.fullmatch(BANNER_RE, log["session_start_line"])):
        errs.append("log.session_start_line is not the runtime start banner")

    # Wine: every derived field must equal the anchored runtime line it came from.
    line = log["host_line"]
    m = re.fullmatch(HOST_RE, line) if isinstance(line, str) else None
    if m is None:
        errs.append("log.host_line missing or not in the runtime's anchored format; runtime never reported its host")
    else:
        if m.group(1) != sid:
            errs.append(f"log.host_line session {m.group(1)} is not log.session_id")
        if m.group(2) != "no":
            errs.append("runtime log says wine=yes: a Wine run never closes a native cell")
        if host["wine"] != m.group(2):
            errs.append(f"host.wine={host['wine']!r} disagrees with log line wine={m.group(2)}")
        if host["wine_version"] != m.group(3):
            errs.append(f"host.wine_version {host['wine_version']!r} disagrees with log line {m.group(3)!r}")
        log_os = f"{m.group(4)}.{m.group(5)}.{m.group(6)}"
        if host["log_os"] != log_os:
            errs.append(f"host.log_os {host['log_os']!r} disagrees with log line os={log_os}")
        if host["overlays"] != m.group(7):
            errs.append(f"host.overlays {host['overlays']!r} disagrees with log line overlays={m.group(7)}")
        if str(r["os"]["build"]) != m.group(6):
            errs.append(f"os.build {r['os']['build']} disagrees with RtlGetVersion build {m.group(6)} in log")
        if m.group(2) == "no" and m.group(3) != "-":
            errs.append(f"log line says wine=no but wine_version={m.group(3)}")
        if m.group(7).startswith("snapshot-failed"):
            errs.append(f"overlay scan failed ({m.group(7)}); the module list is unknown, run again")
    if host["wine"] != "no":
        errs.append(f"host.wine is {host['wine']!r}, a native receipt needs 'no'")
    if host["wine_registry"] == "yes":
        errs.append("HKLM\\Software\\Wine exists: the receipt ran inside a Wine prefix")

    g = r["game"]
    if g["exe_sha256"] not in records:
        errs.append(f"game.exe_sha256 {g['exe_sha256']} is not a BuildRecord")
    elif g.get("build") not in (None, records[g["exe_sha256"]]):
        errs.append(f"game.build {g['build']!r} disagrees with BuildRecord {records[g['exe_sha256']]!r}")
    # A PE is one image: container and slice are the exe.
    if not (g["container_sha256"] == g["slice_sha256"] == g["exe_sha256"]):
        errs.append("PE container/slice sha must equal exe sha")

    # GL: the fields must equal the anchored line, and the line must look native.
    gm = re.fullmatch(GL_RE, log["gl_line"]) if isinstance(log["gl_line"], str) else None
    if gm is None:
        errs.append("log.gl_line missing or not in the runtime's anchored format; the overlay never initialised")
    else:
        if gm.group(1) != sid:
            errs.append(f"log.gl_line session {gm.group(1)} is not log.session_id")
        for i, k in enumerate(("vendor", "renderer", "version"), start=2):
            if gl[k] != gm.group(i):
                errs.append(f"gl.{k} {gl[k]!r} disagrees with log line {gm.group(i)!r}")
        vendor, renderer = gm.group(2).lower(), gm.group(3).lower()
        if not renderer:
            errs.append("gl renderer empty; the overlay never initialised")
        elif any(s in renderer for s in SOFTWARE_RENDERERS):
            errs.append(f"software renderer {gm.group(3)!r}: not a real GPU run")
        for field, text in (("vendor", vendor), ("renderer", renderer)):
<#
.SYNOPSIS
Install KotorPhasor into a native Windows game folder, or take it back out.

.DESCRIPTION
The Windows twin of scripts/install_to_game.sh, with stricter rules because a
native install has no Wine prefix to throw away.

Install refuses unless the game executable is on the exe allowlist and the
game's binkw32.dll is on the Bink allowlist. It copies the original Bink to a
backup and to binkw32_real.dll, then drops in the proxy, kphasor.dll and the
address tables. Every file it writes is recorded in
kotorphasor\install-manifest.json with its hash. If any step fails, the steps
already done are undone in reverse order.

Uninstall reads that manifest. Before it touches anything, it checks every path
in it: no rooted path, no '.' or '..' segment, nothing that resolves outside the
game folder, only the file names this script writes, and a backup folder named
exactly kotorphasor\backup\<timestamp>. A manifest that fails any check is
refused and nothing is removed. It removes a file only when the file still has
the hash we wrote. It restores binkw32.dll from the backup, or from
binkw32_real.dll if the backup is gone, and only when that copy's hash matches
the recorded original. Scripts, logs and anything else you added stay put.

Targets Windows PowerShell 5.1, which every supported Windows ships.

RUNNING IT
Windows blocks unsigned scripts by default, and marks downloaded files as
coming from the internet. Allow this one PowerShell window to run scripts, then
unblock the downloaded files:

    Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
    Get-ChildItem -Recurse .\scripts, .\build | Unblock-File

-Scope Process lasts only until you close that window. It changes no system
setting. Install into Program Files needs an elevated window ("Run as
administrator"). See docs\user\windows-native-install.md.

.EXAMPLE
.\Install-KotorPhasor.ps1 -GameDir 'C:\GOG Games\Star Wars - KotOR' -SourceDir .\build
.\Install-KotorPhasor.ps1 -GameDir 'C:\GOG Games\Star Wars - KotOR' -Action Uninstall
.\Install-KotorPhasor.ps1 -GameDir 'C:\GOG Games\Star Wars - KotOR' -Action Status
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)][string]$GameDir,
    [ValidateSet('Install', 'Uninstall', 'Status')][string]$Action = 'Install',
    # Folder holding kphasor.dll and the proxy binkw32.dll.
    [string]$SourceDir = '',
    # Folder holding the per-build address tables (data\addresses in the repo).
    [string]$AddressDir = '',
    # A Bink hash you vouch for that is not on the allowlist (K2's Bink is not
    # recorded yet). Must be the exact SHA-256; it is written to the manifest.
    [string]$TrustBinkSha256 = ''
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$ManifestSchema = 'kotorphasor.install-manifest/v1'

# Game executables KotorPhasor has an installable address table for. Values are
# BuildRecord aliases from src\generated\builds.inc; the Python contract test
# (tools\platform_receipt_test.py) fails if a hash here is not a BuildRecord.
# k1_steam_103_unpacked is a harness artifact, not something a player runs.
# k2_steam_aspyr is left out: its builds.inc note and its address table
# disagree about whether it is installable.
$ExeAllowlist = @{
    '9c10e0450a6eeca417e036e3cde7474fed1f0a92aab018446d156944dea91435' = 'k1_gog_103'
    '34e6d971c034222a417995d8e1e8fdd9f8781795c9c289bd86c499a439f34c88' = 'k1_steam_103'
    '777bee235a9e8bdd9863f6741bc3ac54bb6a113b62b1d2e4d12bbe6db963a914' = 'k2_gog_aspyr'
}

# Original RAD Game Tools binkw32.dll builds, by where they were hashed. The
# one entry today is the K1 Steam install's original (tmp/k1_harness). The GOG
# K1 and K2 Bink builds have not been hashed; if they differ, install refuses
# and names the -TrustBinkSha256 value to pass.
$BinkAllowlist = @{
    '2d0ae23a6175dc7b635c402a5e7e9542e923c0d1c376a8c5ef876ca0d5959d23' = 'K1 Steam original binkw32.dll (375808 bytes)'
}

function Get-Sha256([string]$Path) {
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
}

function Test-OurProxy([string]$Path) {
    # Our proxy is small and names kphasor.dll; the real Bink is ~370 KB of codec.
    $item = Get-Item -LiteralPath $Path
    if ($item.Length -ge 200000) { return $false }
    $bytes = [System.IO.File]::ReadAllBytes($Path)
    $text = [System.Text.Encoding]::ASCII.GetString($bytes)
    return $text.Contains('kphasor.dll')
}

function Test-KnownBink([string]$Sha) {
    if ($BinkAllowlist.ContainsKey($Sha)) { return $true }
    if ($TrustBinkSha256 -and ($Sha -eq $TrustBinkSha256.ToLowerInvariant())) { return $true }
    return $false
}

function Find-GameExe([string]$Dir) {
    foreach ($name in @('swkotor.exe', 'swkotor2.exe')) {
        $p = Join-Path $Dir $name
        if (Test-Path -LiteralPath $p -PathType Leaf) { return $p }
    }
    return $null
}

function Get-Field($Object, [string]$Name) {
    # StrictMode 2 throws on a missing property; a manifest may lack one.
    if ($null -eq $Object) { return $null }
    $prop = $Object.PSObject.Properties[$Name]
    if ($null -eq $prop) { return $null }
    return $prop.Value
}

# The backup folder this script creates, and nothing else.
$BackupDirPattern = '^kotorphasor[\\/]backup[\\/][0-9]{8}T[0-9]{6}Z$'
# The files this script creates. A manifest naming anything else is not ours.
$CreatedPattern = '^(binkw32_real\.dll|kphasor\.dll|kotorphasor[\\/]addresses[\\/][A-Za-z0-9_-]+\.json)$'

function Resolve-Owned([object]$Rel, [string]$What) {
    # One manifest path to one absolute path strictly inside the game folder,
    # or a throw. Checked on both separators: '..\x' is one file name to
    # PowerShell on Linux but a traversal on Windows.
    if (($null -eq $Rel) -or -not ($Rel -is [string]) -or ($Rel.Length -eq 0)) {
        throw "manifest $What is null or empty"
    }
    if (($Rel -match '^[\\/]') -or ($Rel -match ':')) {
        throw "manifest $What '$Rel' is rooted or names a drive or stream"
    }
    foreach ($seg in ($Rel -split '[\\/]')) {
        # Windows drops trailing dots and spaces from a name, so '.. ' is '..'.
        if (($seg.Trim() -eq '') -or ($seg -match '^[. ]+$') -or ($seg -match '[. ]$')) {
            throw "manifest $What '$Rel' has an empty, '.' or '..' segment"
        }
    }
    $full = [System.IO.Path]::GetFullPath([System.IO.Path]::Combine($GameDir, $Rel))
    if (-not $full.StartsWith($GameRoot, [System.StringComparison]::OrdinalIgnoreCase)) {
        throw "manifest $What '$Rel' resolves outside the game folder"
    }
    return $full
}

function Assert-Manifest($m) {
    # Every path in the manifest, checked before anything is read or removed.
    $bd = Get-Field $m 'backup_dir'
    if (($null -eq $bd) -or -not ($bd -is [string]) -or ($bd -notmatch $BackupDirPattern)) {
        throw "manifest backup_dir '$bd' is not kotorphasor\backup\<yyyyMMddTHHmmssZ>; refusing, nothing removed"
    }
    [void](Resolve-Owned $bd 'backup_dir')
    $files = @(Get-Field $m 'files')
    if ($files.Count -eq 0) { throw 'manifest lists no files; refusing, nothing removed' }
    $replaced = 0
    foreach ($f in $files) {
        $path = Get-Field $f 'path'
        [void](Resolve-Owned $path 'file path')
        $action = Get-Field $f 'action'
        if ((Get-Field $f 'sha256') -notmatch '^[0-9a-f]{64}$') { throw "manifest entry '$path' has no sha256" }
        if ($action -eq 'created') {
            if ($path -notmatch $CreatedPattern) { throw "manifest entry '$path' is not a file this script creates" }
        } elseif ($action -eq 'replaced') {
            $replaced++
            if ($path -ne 'binkw32.dll') { throw "manifest replaced entry '$path' is not binkw32.dll" }
            if ((Get-Field $f 'original_sha256') -notmatch '^[0-9a-f]{64}$') { throw 'manifest binkw32.dll entry has no original_sha256' }
            $backup = Get-Field $f 'backup'
            [void](Resolve-Owned $backup 'backup file')
            $want = ($bd -replace '/', '\') + '\binkw32.dll'
            if (($backup -replace '/', '\') -ne $want) { throw "manifest backup file '$backup' is not inside backup_dir" }
        } else {
            throw "manifest entry '$path' has unknown action '$action'"
        }
    }
    if ($replaced -gt 1) { throw 'manifest replaces binkw32.dll more than once' }
}

function Read-Manifest([string]$Path) {
    $m = Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json
    if ((Get-Field $m 'schema') -ne $ManifestSchema) { throw "unknown manifest schema '$(Get-Field $m 'schema')' in $Path" }
    Assert-Manifest $m
    return $m
}

$GameDir = [System.IO.Path]::GetFullPath((Resolve-Path -LiteralPath $GameDir).Path)
# Every path this script deletes must start with this, compared ignoring case.
$GameRoot = $GameDir.TrimEnd('\', '/') + [System.IO.Path]::DirectorySeparatorChar
$Proxy = Join-Path $GameDir 'binkw32.dll'
$Real = Join-Path $GameDir 'binkw32_real.dll'
$OwnDir = Join-Path $GameDir 'kotorphasor'
$ManifestPath = Join-Path $OwnDir 'install-manifest.json'

if ($TrustBinkSha256 -and ($TrustBinkSha256 -notmatch '^[0-9a-fA-F]{64}$')) {
    throw '-TrustBinkSha256 must be a 64-character SHA-256 hex string'
}

# --------------------------------------------------------------------------
if ($Action -eq 'Status') {
    if (Test-Path -LiteralPath $ManifestPath) {
        $m = Read-Manifest $ManifestPath
        # pwsh 7 turns ISO strings into DateTime on the way in; print the string.
        $at = $m.installed_at
        if ($at -is [DateTime]) { $at = $at.ToUniversalTime().ToString('o') }
        Write-Output "installed ($($m.game.build), since $at)"
        foreach ($f in $m.files) {
            $p = Resolve-Owned $f.path 'file path'
            $state = 'missing'
            if (Test-Path -LiteralPath $p -PathType Leaf) {
                if ((Get-Sha256 $p) -eq $f.sha256) { $state = 'ok' } else { $state = 'changed' }
            }
            Write-Output ("  {0,-8} {1}" -f $state, $f.path)
        }
    } elseif ((Test-Path -LiteralPath $Proxy) -and (Test-OurProxy $Proxy)) {
        Write-Output 'proxy present but no manifest: installed by another tool; not managed here'
    } else {
        Write-Output 'not installed'
    }
    return
}

# --------------------------------------------------------------------------
if ($Action -eq 'Uninstall') {
    if (-not (Test-Path -LiteralPath $ManifestPath)) {
        throw "no $ManifestPath; nothing this script installed is here, so nothing is removed"
    }
    try { $m = Read-Manifest $ManifestPath }
    catch { throw "uninstall refused, nothing removed; manifest kept: $($_.Exception.Message)" }
    $files = @($m.files)
    [array]::Reverse($files)

    # Pass 1 decides everything and touches nothing. One changed file means
    # nothing is removed, so a refused uninstall leaves a coherent install.
    # Read-Manifest has already refused any path that is rooted, has a '.' or
    # '..' segment, or resolves outside the game folder.
    $kept = New-Object System.Collections.ArrayList
    $plan = New-Object System.Collections.ArrayList
    foreach ($f in $files) {
        $p = Resolve-Owned $f.path 'file path'
        $replaced = ($f.action -eq 'replaced')
        if (-not (Test-Path -LiteralPath $p -PathType Leaf)) {
            if ($replaced) {
                Write-Warning "$($f.path) is missing; restore it from $($f.backup)"
                [void]$kept.Add($f.path)
            }
            continue
        }
        $sha = Get-Sha256 $p
        if ($replaced -and ($sha -eq $f.original_sha256)) { continue }  # already restored
        if ($sha -ne $f.sha256) {
            Write-Warning "$($f.path) changed since install; left in place"
            [void]$kept.Add($f.path)
            continue
        }
        $source = $null
        if ($replaced) {
            # The backup first; binkw32_real.dll is the same original, so it
            # serves when the backup is gone, if its hash still matches.
            $backup = Resolve-Owned $f.backup 'backup file'
            if ((Test-Path -LiteralPath $backup -PathType Leaf) -and ((Get-Sha256 $backup) -eq $f.original_sha256)) {
                $source = $backup
            } elseif ((Test-Path -LiteralPath $Real -PathType Leaf) -and ((Get-Sha256 $Real) -eq $f.original_sha256)) {
                Write-Warning "backup $($f.backup) missing or changed; restoring $($f.path) from binkw32_real.dll, which matches the recorded original"
                $source = $Real
            } else {
                Write-Warning "neither backup $($f.backup) nor binkw32_real.dll matches the recorded original; $($f.path) left in place"
                [void]$kept.Add($f.path)
                continue
            }
        }
        [void]$plan.Add(@{ entry = $f; full = $p; source = $source })
    }
    if ($kept.Count -gt 0) {
        throw "uninstall refused, nothing removed; manifest kept. Files: $($kept -join ', ')"
    }

    # Pass 2 acts on exactly what pass 1 verified.
    # Files are in reverse install order, so binkw32.dll is restored before
    # binkw32_real.dll (the fallback source) is removed.
    foreach ($step in $plan) {
        if ($step.entry.action -eq 'replaced') {
            Copy-Item -LiteralPath $step.source -Destination $step.full -Force
            Write-Output "restored original $($step.entry.path)"
        } else {
            Remove-Item -LiteralPath $step.full -Force
        }
    }
    # Our own bookkeeping, only once every game file is back. backup_dir was
    # checked against kotorphasor\backup\<timestamp> and resolved inside the
    # game folder before pass 1.
    $backupDir = Resolve-Owned $m.backup_dir 'backup_dir'
    if (Test-Path -LiteralPath $backupDir -PathType Container) { Remove-Item -LiteralPath $backupDir -Recurse -Force }
    $backupParent = Join-Path $OwnDir 'backup'
    if ((Test-Path -LiteralPath $backupParent) -and -not (Get-ChildItem -LiteralPath $backupParent -Force)) {
        Remove-Item -LiteralPath $backupParent -Force
    }
    $addr = Join-Path $OwnDir 'addresses'
    if ((Test-Path -LiteralPath $addr) -and -not (Get-ChildItem -LiteralPath $addr -Force)) {
        Remove-Item -LiteralPath $addr -Force
    }
    Remove-Item -LiteralPath $ManifestPath -Force
    Write-Output 'uninstalled (scripts and logs left in place)'
<#
.SYNOPSIS
Write a native-Windows KotorPhasor receipt after one physical F12 test.

.DESCRIPTION
Run this on the Windows PC where you just played, after you:
  1. installed with scripts\install\windows\Install-KotorPhasor.ps1,
  2. started the game from its own launcher or exe (not Wine, not a VM),
  3. pressed F12 on the physical keyboard in game and saw the Lua console or not,
  4. quit the game.

The script reads the game folder and kotorphasor.log. It records the OS build,
the CPU and any x86 translation, the exe sha, the proxy and DLL shas, the log
hash, the runtime's own host and GL lines, and the F12 result you report.

The F12 result is your word: the script cannot see the screen.

What the log lines are worth. KotorPhasor appends one block per game start
to kotorphasor.log. The receipt reads only the newest block, which starts
at the last "KotorPhasor <version> starting" line. In that block, the runtime
writes one "kp-session=<id> start" line when its overlay attaches. On the first
rendered frame it adds one host line and one gl line with the same random id.
These lines skip the log sink that scripts write through. So a script's
print or kp.diagnostic output cannot take their exact shape, and it is not
matched. A block with a second host or gl line, a line from another run, or a
line in any other shape is refused.

This is supporting evidence, not proof:
  - A script can still write to kotorphasor.log with Lua's io library, or
    split a line with an embedded newline. The runtime does not stop that yet.
  - Wine is detected by one signal: ntdll exports wine_get_version only under
    Wine. Some patched Wine builds hide that export. The OS build cannot help,
    because Wine reports whatever Windows version its prefix is set to. The
    receipt also records whether HKLM\Software\Wine exists. The validator
    refuses Mesa, Linux driver and macOS GL names. A Wine run on a vendor
    driver whose GL strings match Windows can still pass.
  - tools\platform_receipt_test.py --validate checks the receipt against the
    lines it quotes. Add --log kotorphasor.log to re-check against the log.

RUNNING IT
Windows blocks unsigned scripts by default. Allow this one PowerShell window
to run scripts, then unblock the downloaded file:

    Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
    Unblock-File .\scripts\receipts\windows-native-receipt.ps1

-Scope Process lasts only until you close that window. It changes no system
setting. The receipt is written under %LOCALAPPDATA%\KotorPhasor\receipts
unless you pass -OutFile. That folder needs no admin rights, even when the
game is in Program Files.

Targets Windows PowerShell 5.1.

.EXAMPLE
.\windows-native-receipt.ps1 -GameDir 'C:\GOG Games\Star Wars - KotOR' -F12Result pass
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)][string]$GameDir,
    [Parameter(Mandatory = $true)][ValidateSet('pass', 'fail', 'not-run')][string]$F12Result,
    [string]$OutFile = ''
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

function Get-Sha256OrNull([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
}

# --- BEGIN session parser ------------------------------------------------------
# tools\platform_receipt_test.py session_evidence() is the same logic in
# Python; its parity test dot-sources this block and compares the two on the
# fixture logs. Change both or neither.
# Line shapes: src\devtools\overlay.cpp writes the kp-session lines through
# Runtime::log ("[<phase>] <body>"); script output always carries
# "[<phase>] <level>: ". -cmatch: case-sensitive, whole line.
$BannerPattern = '^\[[a-z-]+\] KotorPhasor \S+ starting \([a-z-]+ role\)$'
$SessionPattern = '^\[[a-z-]+\] kp-session=([0-9a-f]{32}) start$'
$HostPattern = '^\[[a-z-]+\] kp-session=([0-9a-f]{32}) host: wine=(yes|no) wine_version=(\S+) os=(\d+)\.(\d+)\.(\d+) overlays=(\S+)$'
$GlPattern = '^\[[a-z-]+\] kp-session=([0-9a-f]{32}) gl: vendor="([^"]*)" renderer="([^"]*)" version="([^"]*)"$'

function Get-SessionEvidence([string[]]$Lines) {
    $ev = [ordered]@{
        session_start_line = $null; session_id = $null; host_line = $null; gl_line = $null
        session_marker_lines = 0; host_like_lines = 0; gl_like_lines = 0; problems = @()
    }
    $problems = New-Object System.Collections.ArrayList
    $all = @($Lines | Where-Object { $null -ne $_ })
    $start = -1
    for ($i = 0; $i -lt $all.Count; $i++) { if ($all[$i] -cmatch $BannerPattern) { $start = $i } }
    if ($start -lt 0) {
        [void]$problems.Add('no KotorPhasor start banner in the log')
        $ev.problems = $problems.ToArray()
        return $ev
    }
    $ev.session_start_line = $all[$start]
    $starts = New-Object System.Collections.ArrayList
    $hosts = New-Object System.Collections.ArrayList
    $gls = New-Object System.Collections.ArrayList
    $ids = New-Object System.Collections.ArrayList
    $n = 0
    for ($i = $start + 1; $i -lt $all.Count; $i++) {
        $n++
        $line = $all[$i]
        if ($line.Contains('kp-session=')) {
            $ev.session_marker_lines++
            $id = $null
            if ($line -cmatch $SessionPattern) { $id = $Matches[1]; [void]$starts.Add(@{ n = $n; line = $line }) }
            elseif ($line -cmatch $HostPattern) { $id = $Matches[1] }
            elseif ($line -cmatch $GlPattern) { $id = $Matches[1] }
            if ($null -eq $id) { [void]$problems.Add("session line $n mentions kp-session= but is not a runtime line") }
            elseif (-not $ids.Contains($id)) { [void]$ids.Add($id) }
        }
        if ($line.Contains('host: wine=')) { $ev.host_like_lines++; [void]$hosts.Add(@{ n = $n; line = $line }) }
        if ($line.Contains('gl: vendor=')) { $ev.gl_like_lines++; [void]$gls.Add(@{ n = $n; line = $line }) }
    }
    if ($starts.Count -ne 1) { [void]$problems.Add("$($starts.Count) kp-session start lines in the current session, want 1") }
    if ($ids.Count -gt 1) { [void]$problems.Add("$($ids.Count) different session ids in the current session") }
    if ($hosts.Count -ne 1) { [void]$problems.Add("$($hosts.Count) host lines in the current session, want 1") }
    if ($gls.Count -ne 1) { [void]$problems.Add("$($gls.Count) gl lines in the current session, want 1") }
    if ($problems.Count -eq 0) {
        if (-not ($hosts[0].line -cmatch $HostPattern)) { [void]$problems.Add("the host line is not in the runtime's anchored format") }
        if (-not ($gls[0].line -cmatch $GlPattern)) { [void]$problems.Add("the gl line is not in the runtime's anchored format") }
        if (-not (($starts[0].n -lt $hosts[0].n) -and ($starts[0].n -lt $gls[0].n))) {
            [void]$problems.Add('host or gl line comes before the session start line')
        }
    }
    if ($problems.Count -eq 0) {
        [void]($starts[0].line -cmatch $SessionPattern)
