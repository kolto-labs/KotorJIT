+    // ",+<n>_more" instead of a truncated name. Room for that suffix is kept.
+    constexpr std::size_t kSuffixRoom = 24;   // ",+4294967295_more" and NUL
+    const std::size_t limit = sizeof id.overlays - kSuffixRoom;
+    std::size_t used = 0;
+    unsigned omitted = 0;
+    MODULEENTRY32W entry{};
