+# --- kp.camera Stage 1: client chase camera (read-only, K1 GOG only) ----------
+# Evidence: data/adjudication/k1_gog_103_camera_bindings.json. Every row is
+# optional so builds without a camera receipt never gain a required site.
+[[site]]
+name   = "client.module"
+class  = "CClientExoAppInternal"
+method = "module"
+kind   = "field"
+required = false
+purpose = "CSWCModule* (client module). GetModule 0x5ed530 -> 0x644760 reads it."
+
+[[site]]
+name   = "client.options"
+class  = "CClientExoAppInternal"
+method = "options"
+kind   = "field"
+required = false
+purpose = "CClientOptions*, as GetClientOptions returns it."
+
+[[site]]
+name   = "client_options.camera_mode"
+class  = "CClientOptions"
+method = "camera_mode"
+kind   = "field"
+required = false
+purpose = "u8 camera mode that SetCameraMode stores. Raw byte."
+
+[[site]]
+name   = "client_module.vtable"
+class  = "CSWCModule"
+method = "vtable"
+kind   = "reference"
+required = false
+purpose = "Exact identity of the client module object. Compared as a pointer."
+
+[[site]]
+name   = "client_module.camera"
+class  = "CSWCModule"
+method = "camera"
+kind   = "field"
+required = false
+purpose = "CAurCamera* the camera messages go to."
+
+[[site]]
+name   = "camera.vtable"
+class  = "CAurCamera"
+method = "vtable"
+kind   = "reference"
+required = false
+purpose = "Exact identity of the client camera. Compared as a pointer."
+
+[[site]]
+name   = "camera.active_behavior"
+class  = "CAurCamera"
+method = "active_behavior"
+kind   = "field"
+required = false
+purpose = "Current camera behaviour object (embedded Gob at +4, its +0x188)."
+
+[[site]]
+name   = "camera_chase.vtable"
+class  = "CSWCameraOnAStick"
+method = "vtable"
+kind   = "reference"
+required = false
+purpose = "Chase behaviour identity (type id 0x106a). Any other vtable is not a chase camera."
+
+[[site]]
+name   = "camera_chase.distance"
+class  = "CSWCameraOnAStick"
+method = "m_fDist"
+kind   = "field"
+required = false
+purpose = "f32 target distance. Recomputed every tick while camera_chase.dolly is nonzero."
+
+[[site]]
+name   = "camera_chase.speed"
+class  = "CSWCameraOnAStick"
+method = "m_fSpeed"
+kind   = "field"
+required = false
+
+[[site]]
