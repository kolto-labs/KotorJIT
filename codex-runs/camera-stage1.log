#!/usr/bin/env bash
# Run a command on the Fedora host from inside a distrobox/podman container.
# On the host, resolves the real binary under /usr/bin, /bin, brew, or cargo —
# never re-enters ~/.local/bin wrappers.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: host-cmd <command> [args...]

Inside distrobox/podman: exec via host-spawn.
On the Fedora host: exec the real binary (not a ~/.local/bin host wrapper).

See also: docs/ubuntu-dev-host-parity.md in system-bootstrap/dotfiles.
EOF
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

cmd="$1"
shift

in_container=0
if [[ -f /run/.containerenv ]] || [[ -n "${container:-}" ]]; then
  in_container=1
fi

if [[ "$in_container" -eq 1 ]]; then
  if ! command -v host-spawn >/dev/null 2>&1; then
    echo "host-cmd: host-spawn not found (are you in distrobox?)" >&2
    exit 127
  fi
  exec host-spawn "$cmd" "$@"
fi

# Host path: prefer system / brew / cargo locations; skip this script's dir.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
candidates=(
  "/usr/bin/$cmd"
  "/bin/$cmd"
  "/usr/local/bin/$cmd"
  "/home/linuxbrew/.linuxbrew/bin/$cmd"
  "${HOME}/.cargo/bin/$cmd"
  "${HOME}/.local/share/../bin/$cmd"
)

for path in "${candidates[@]}"; do
  if [[ -x "$path" ]]; then
    # Avoid looping into another wrapper in the same directory.
    if [[ "$(cd "$(dirname "$path")" && pwd)" == "$self_dir" ]]; then
      continue
    fi
    exec "$path" "$@"
  fi
done

# Last resort: PATH lookup excluding self_dir
IFS=':' read -r -a path_dirs <<< "${PATH:-}"
for dir in "${path_dirs[@]}"; do
  [[ -z "$dir" ]] && continue
  [[ "$(cd "$dir" 2>/dev/null && pwd)" == "$self_dir" ]] && continue
  if [[ -x "$dir/$cmd" ]]; then
    exec "$dir/$cmd" "$@"
  fi
done

echo "host-cmd: '$cmd' not found on host" >&2
exit 127
