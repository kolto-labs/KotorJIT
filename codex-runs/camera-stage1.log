+class  = "CSWCameraOnAStick"
+method = "m_fPresetPitch"
+kind   = "field"
+required = false
+purpose = "f32, units unverified."
+
+[[site]]
+name   = "camera_chase.height"
+class  = "CSWCameraOnAStic
