   808	        report['note'] = 'no owner journal; nothing recorded about speed'
   809	        return report
   810	    prior = record.get('speed_before_job')
   811	    owed = record.get('speed_restore_owed') is True
   812	    report.update(speed_before_job=prior, speed_restore_owed=owed,
   813	                  recorded_speed_after_job=record.get('speed_after_job'))
   814	    updates = dict(detached=True, operation_state='execution_stopped', active_step=None,
   815	                   stop_reason='reclaimed after the owner died')
   816	    if record.get('active_step') is not None or record.get('operation_state') in {'running', 'verifying'}:
   817	        updates.update(world_uncertain=True,
   818	                       last_error='owner died during a job; reclaimed without its cleanup')
   819	    if owed and type(prior) in (int, float) and math.isfinite(prior) and 0 < prior <= 16:
   820	        recorded = {'identity': record.get('runtime_identity'), 'uptime_ms': record.get('runtime_uptime_ms')}
   821	        with Channel('127.0.0.1', info.port, timeout=channel_timeout()) as channel:
