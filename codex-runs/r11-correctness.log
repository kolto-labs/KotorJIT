   736	class _SupervisorSignals:
   737	    """Forward the first SIGINT/SIGHUP/SIGTERM to the child's session; never abort its cleanup."""
   738	    def __init__(self):
   739	        self.received: list[str] = []
   740	        self.child = None
   741	        self.forwarded = False
   742	        self.previous = {}
   743	
   744	    def handler(self, signum, frame):
   745	        self.received.append(signal.Signals(signum).name)
   746	        if self.child is None:
   747	            raise DiagnosticInterrupted(signal.Signals(signum).name)
   748	        self.forward()
   749	
   750	    def forward(self):
   751	        if not self.forwarded and self.child.poll() is None:
   752	            self.forwarded = True
   753	            try:
   754	                self.child.send_signal(signal.SIGINT)
   755	            except ProcessLookupError:
   756	                pass
   757	
   758	    def install(self):
   759	        for number in INTERRUPT_SIGNALS:
   760	            self.previous[number] = signal.signal(number, self.handler)
   761	
   762	    def restore(self):
   763	        for number, previous in self.previous.items():
   764	            signal.signal(number, previous)
