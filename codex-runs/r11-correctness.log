   496	def _fd_identity_and_sha(descriptor: int) -> tuple[tuple[int, int, int, int, int, int], str]:
   497	    before = os.fstat(descriptor)
   498	    if not stat.S_ISREG(before.st_mode):
   499	        raise ValueError('accepted master is not a regular file')
   500	    os.lseek(descriptor, 0, os.SEEK_SET)
   501	    digest = hashlib.sha256()
   502	    while block := os.read(descriptor, 1024 * 1024):
   503	        digest.update(block)
   504	    after = os.fstat(descriptor)
   505	    if _stat_identity(before) != _stat_identity(after):
   506	        raise ValueError('accepted master changed while hashing')
   507	    return _stat_identity(after), digest.hexdigest()
   508	
