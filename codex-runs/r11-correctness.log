   441	def _append_cleanup_record(run_dir: Path, record_type: str, payload: dict, *, expected_head: str,
   442	                           commitment_log: object, event: str,
   443	                           identifier: str | None = None, survivor: bool = False) -> tuple[dict, str]:
   444	    """Append one record under the ledger lock, then emit its head.
   445	
   446	    A survivor (``failure``) record is written before, and independently of,
   447	    commitment-log validation, and even when another transition moved the head
   448	    during the probe: recording a failure can only block. If the head cannot
   449	    reach the log afterwards, CommitmentLogFailed carries the new head, which
   450	    is already on stderr.
   451	    """
   452	    run_dir = Path(run_dir)
   453	    if not survivor:
   454	        validate_commitment_log(commitment_log, run_dir)
   455	    lock = _ledger_lock(run_dir)
   456	    head_changed = False
   457	    try:
   458	        ledger, raw, _, _ = _load_cleanup_ledger(run_dir)
   459	        # Re-verify the caller's independently supplied head under the lock.
   460	        if not _hex(expected_head, 64) or hashlib.sha256(raw).hexdigest() != expected_head:
   461	            if not survivor:
   462	                raise ValueError('cleanup ledger head changed; refusing to extend an unanchored chain')
   463	            head_changed = True
   464	        records = ledger['records']
   465	        previous = (records[-1]['record_digest'] if records
   466	                    else hashlib.sha256(_launch_bytes(ledger['nonce'])).hexdigest())
   467	        record = {'schema': RECORD_SCHEMA, 'type': record_type, 'sequence': len(records) + 1,
   468	            'id': identifier or uuid.uuid4().hex, 'prev_digest': previous,
   469	            'timestamp_utc': _utc_now(), 'payload': copy.deepcopy(payload)}
   470	        record['record_digest'] = _record_digest(record)
   471	        records.append(record)
   472	        encoded = _canonical_bytes(ledger)
   473	        _atomic_regular_write(run_dir / CLEANUP_LEDGER, encoded)
   474	        _, published, _, _ = _load_cleanup_ledger(run_dir)
   475	        if published != encoded:
   476	            raise ValueError('published FFprobe cleanup ledger differs from the validated chain')
   477	    finally:
   478	        os.close(lock)
   479	    head = hashlib.sha256(encoded).hexdigest()
   480	    try:
   481	        _emit_head(run_dir, commitment_log, event=event, nonce=ledger['nonce'], sequence=len(records),
   482	                   head=head, failure_id=record['id'] if record_type == 'failure' else payload['failure_id'])
   483	    except (OSError, ValueError) as error:
   484	        raise CommitmentLogFailed(f'{error}', record=record, cleanup_ledger_sha256=head,
   485	                                  head_changed=head_changed) from error
   486	    if head_changed:
   487	        raise CommitmentLogFailed('', record=record, cleanup_ledger_sha256=head, head_changed=True)
   488	    return record, head
