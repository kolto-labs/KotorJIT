   481	
   482	class _ChildSignals:
   483	    """First interrupt aborts the run; later ones never abort the ordered cleanup."""
   484	    def __init__(self):
   485	        self.received: list[str] = []
   486	        self.cleaning = False
   487	        self.previous = {}
   488	
   489	    def handler(self, signum, frame):
   490	        self.received.append(signal.Signals(signum).name)
   491	        if not self.cleaning and len(self.received) == 1:
   492	            raise DiagnosticInterrupted(signal.Signals(signum).name)
   493	
   494	    def install(self):
   495	        for number in INTERRUPT_SIGNALS:
   496	            self.previous[number] = signal.signal(number, self.handler)
   497	
   498	    def restore(self):
   499	        for number, previous in self.previous.items():
   500	            signal.signal(number, previous)
   501	
   502	
   503	def _append_marker(path: Path, name: str) -> None:
   504	    with path.open('a') as stream:
   505	        stream.write(MARKER_LINES[name] + '\n'); stream.flush(); os.fsync(stream.fileno())
   506	
   507	
   508	def _wait_for_window(lease, pid: int, discover, run, monotonic, sleep):
   509	    deadline = monotonic() + WINDOW_DISCOVERY_SECONDS
   510	    while True:
   511	        try:
   512	            return discover(lease, [pid], run=run, monotonic=monotonic)
   513	        except RuntimeError:
   514	            if monotonic() >= deadline:
   515	                raise
   516	            sleep(.25)
   517	
   518	
   519	def run_child(config: dict, *, lease_factory, popen, discover, verifier_factory, recorder_factory,
   520	              sleep, monotonic, start_reader, run=subprocess.run) -> dict:
   521	    run_dir = Path(config['run_dir'])
   522	    # Every child of this process inherits the lock: lease, client, FFmpeg,
   523	    # both FFprobe probes, and every xwininfo query.
   524	    locked = with_inherited_descriptor(popen, config['lock_fd'])
   525	    locked_run = with_inherited_descriptor(run, config['lock_fd'])
   526	    native_log = Path(config['native_log'])
   527	    native_log.write_text('')
   528	    evidence = {'utc_started': _utc(), 'config': dict(config), 'error': None, 'client': None,
   529	                'window': None, 'lease': None, 'recorder': None, 'cleanup': None, 'interrupts': []}
   530	    lease = recorder = client = client_log = None
   531	    signals = _ChildSignals()
   532	    signals.install()
   533	    try:
   534	        try:
   535	            lease = lease_factory(run_dir, WIDTH, HEIGHT, popen=locked)
   536	            lease.start()
   537	            _record_lease_owned(run_dir, lease)
   538	            client_log = (run_dir / 'client.log').open('xb')
   539	            client = locked(client_command(), env=dict(lease.game_environment({'PATH': '/usr/bin:/bin'})),
   540	                            stdout=client_log, stderr=subprocess.STDOUT, start_new_session=True)
   541	            evidence['client'] = {'pid': client.pid, 'start': start_reader(client.pid)}
   542	            record_owned(run_dir, 'client', client.pid, evidence['client']['start'])
   543	            window = _wait_for_window(lease, client.pid, discover, locked_run, monotonic, sleep)
   544	            evidence['window'] = window.receipt()
   545	            verifier = verifier_factory(lease, run=locked_run)
   546	            recorder = recorder_factory(run_dir, verifier=verifier, lease=lease, ffmpeg=config['ffmpeg'],
   547	                ffprobe=config['ffprobe'], named_markers=dict(MARKERS),
   548	                cadence_start_marker='pattern_start', cadence_end_marker='pattern_end',
   549	                content_policy=CONTENT_POLICY, popen=locked, run=locked_run,
   550	                inherited_fds=(config['lock_fd'],))
   551	            recorder.start(window, native_log)
   552	            process = getattr(recorder, 'process', None)
