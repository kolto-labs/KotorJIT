   204	def evaluate_content(frames, canonical_pts, interval_start, interval_end, policy) -> dict:
   205	    """Content gate: a non-black first acceptance frame and distinct frames in the interval.
   206	
   207	    The black check applies to the first frame at or after the acceptance-start
   208	    marker. Black startup frames before the marker are evidence only.
   209	    """
