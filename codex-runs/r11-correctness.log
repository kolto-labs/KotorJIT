T.fixture_pts_probe = lambda path, exe, *, pass_fds=(), deadline_seconds=None: _fp(path, exe, pass_fds=pass_fds)
T.fixture_content_probe = lambda path, exe, *, pass_fds=(), deadline_seconds=None: _fc(path, exe, pass_fds=pass_fds)
