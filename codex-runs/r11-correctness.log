   787	def _kill_owned_after_budget(process, owned: list[dict], deps: 'Dependencies') -> dict:
   788	    """Only after the cleanup budget: kill the child's own session group and each recorded identity."""
   789	    evidence = {'child_group_killed': False, 'identities_signalled': [], 'kill_failures': []}
   790	    try:
   791	        os.killpg(process.pid, signal.SIGKILL)  # the child leads its own session
   792	        evidence['child_group_killed'] = True
   793	    except ProcessLookupError:
   794	        pass
   795	    except OSError as error:
   796	        evidence['kill_failures'].append({'role': 'child_group', 'error': f'{type(error).__name__}: {error}'})
   797	    for identity in owned:
   798	        if deps.alive(identity['pid'], identity['start']):
   799	            if deps.kill_owned(identity):
   800	                evidence['identities_signalled'].append(identity)
   801	            else:
