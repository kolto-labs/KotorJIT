   409	def create_child_token() -> tuple[int, str]:
   410	    """A nonce only the supervisor holds, delivered to the child on an inherited pipe."""
   411	    token = secrets.token_hex(32)
   412	    read_fd, write_fd = os.pipe()
   413	    try:
   414	        os.write(write_fd, token.encode())
   415	    finally:
   416	        os.close(write_fd)
   417	    return read_fd, hashlib.sha256(token.encode()).hexdigest()
   418	
   419	
   420	def verify_child_authority(config: dict, *, lock_guard=None) -> dict:
   421	    """Refuse a ``--child`` start that did not come from the supervisor holding the lock."""
   422	    token_fd, expected = config.get('token_fd'), config.get('token_sha256')
   423	    if type(token_fd) is not int or token_fd < 3 or not isinstance(expected, str) \
   424	            or re.fullmatch(r'[0-9a-f]{64}', expected) is None:
   425	        raise DiagnosticRefused('child start lacks the supervisor token descriptor')
   426	    try:
   427	        if not stat.S_ISFIFO(os.fstat(token_fd).st_mode):
   428	            raise DiagnosticRefused('child token descriptor is not the supervisor pipe')
   429	        token = b''
   430	        while len(token) <= 64 and (block := os.read(token_fd, 65 - len(token))):
   431	            token += block
   432	    except OSError as error:
   433	        raise DiagnosticRefused('child token descriptor is unreadable') from error
   434	    finally:
   435	        try:
   436	            os.close(token_fd)
   437	        except OSError:
   438	            pass
   439	    run_dir = Path(config['run_dir'])
   440	    try:
   441	        committed = json.loads((run_dir / 'commitments.json').read_text()).get('child_token_sha256')
   442	    except (OSError, ValueError, AttributeError) as error:
   443	        raise DiagnosticRefused('child start has no supervisor commitments') from error
   444	    digest = hashlib.sha256(token).hexdigest()
   445	    if len(token) != 64 or digest != expected or digest != committed:
   446	        raise DiagnosticRefused('child token does not match the supervisor commitment')
   447	    if lock_guard is None:
   448	        from .gamescope_socket import canonical_lock_guard as lock_guard
   449	    try:
   450	        held = lock_guard()
   451	    except (OSError, RuntimeError) as error:
   452	        raise DiagnosticRefused(f'child does not hold the canonical lock: {error}') from error
   453	    if not isinstance(held, dict) or held.get('fd') != config.get('lock_fd'):
   454	        raise DiagnosticRefused('child lock descriptor is not the held canonical lock')
   455	    return held
   456	
