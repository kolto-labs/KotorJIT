   473	def _record_lease_owned(run_dir: Path, lease) -> None:
   474	    try:
   475	        receipt = lease.receipt()
   476	    except Exception:  # evidence only; cleanup never depends on it
   477	        return
   478	    for identity in _owned_identities({'lease': receipt}):
   479	        record_owned(run_dir, identity.get('role', 'display'), identity.get('pid'), identity.get('start'))
