   212	    result = {"status": "failed", "method": CONTENT_METHOD, "policy": policy,
   213	              "frame_count": len(frames) if isinstance(frames, list) else None,
   214	              "first_frame": None, "startup": None, "acceptance": None, "failures": failures}
   215	    if not _content_rows_valid(frames) or not frames:
   216	        failures.append("capture_content_failed: malformed signalstats rows")
   217	        return result
   218	    if len(frames) != len(canonical_pts):
   219	        failures.append("capture_content_failed: content frame count differs from canonical PTS")
   220	        return result
   221	    floor = policy["distinct_noise_floor"]
   222	    selected = [index for index, value in enumerate(canonical_pts) if interval_start <= value <= interval_end]
   223	    before = [index for index, value in enumerate(canonical_pts) if value < interval_start]
   224	    result["startup"] = {"frames_before_acceptance": len(before),
   225	                         "black_frames_before_acceptance": sum(1 for index in before
   226	                                                               if _black(frames[index], policy)),
   227	                         "capture_first_frame": {"ymin": frames[0]["ymin"], "ymax": frames[0]["ymax"]}}
   228	    if selected:
   229	        first_index = selected[0]
   230	        first = frames[first_index]
   231	        result["first_frame"] = {"index": first_index, "pts_seconds": canonical_pts[first_index],
   232	                                 "ymin": first["ymin"], "ymax": first["ymax"]}
   233	        if _black(first, policy):
   234	            failures.append("capture_content_black: first acceptance frame luma max is at or below "
   235	                            "the black threshold or has zero variance")
   236	    else:
   237	        failures.append("capture_content_black: no frame at or after the acceptance start marker")
   238	    expected = max(0, len(selected) - 1)
   239	    changed = sum(1 for index in selected[1:]
   240	                  if max(frames[index][key] for key in ("ydif", "udif", "vdif")) > floor)
   241	    ratio = changed / expected if expected else 0.0
   242	    result["acceptance"] = {"start_capture_seconds": interval_start, "end_capture_seconds": interval_end,
   243	                            "frame_count": len(selected), "expected_changes": expected,
   244	                            "changed_frames": changed, "distinct_noise_floor": floor,
   245	                            "distinct_ratio": ratio}
   246	    if expected == 0 or changed == 0 or ratio < policy["minimum_distinct_ratio"]:
   247	        failures.append("capture_content_static: distinct-frame ratio is below the policy minimum")
   248	    result["status"] = "passed" if not failures else "failed"
   249	    return result
