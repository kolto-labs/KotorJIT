   767	def _wait_for_child(process, signals: _SupervisorSignals, deps: 'Dependencies', monotonic=time.monotonic,
   768	                    sleep=time.sleep) -> dict:
   769	    """Wait for the child; after an interrupt or overrun, allow the full cleanup budget."""
   770	    run_deadline = monotonic() + deps.child_run_seconds
   771	    cleanup_deadline = None
   772	    while True:
   773	        code = process.poll()
   774	        if code is not None:
   775	            return {'returncode': code, 'budget_exhausted': False}
   776	        now = monotonic()
   777	        if not signals.forwarded and now >= run_deadline:
   778	            signals.received.append('run_deadline')
   779	            signals.forward()
   780	        if signals.forwarded and cleanup_deadline is None:
   781	            cleanup_deadline = now + deps.cleanup_budget
   782	        if cleanup_deadline is not None and now >= cleanup_deadline:
   783	            return {'returncode': None, 'budget_exhausted': True}
   784	        sleep(.1)
