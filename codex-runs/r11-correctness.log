   144	# -- process preflight --------------------------------------------------------
   145	
   146	def process_inventory(proc_root: Path = Path('/proc'), *, uid: int | None = None) -> list[dict]:
   147	    """Inventory every /proc row. A row whose comm, stat, or cmdline cannot be read is kept as unreadable."""
   148	    uid = os.getuid() if uid is None else uid
   149	    rows = []
   150	    for entry in Path(proc_root).iterdir():
   151	        if not entry.name.isdecimal():
   152	            continue
   153	        try:
   154	            owner = os.stat(entry).st_uid
   155	        except (FileNotFoundError, ProcessLookupError):
   156	            continue  # exited during the scan
   157	        except OSError as error:
   158	            rows.append({'pid': int(entry.name), 'uid': None, 'unreadable': f'{type(error).__name__}: {error}'})
   159	            continue
   160	        row = {'pid': int(entry.name), 'uid': owner}
   161	        try:
   162	            row['comm'] = (entry / 'comm').read_text().strip()
   163	            raw = (entry / 'stat').read_text()
   164	            row['start'] = raw[raw.rindex(')') + 1:].split()[19]
   165	            argv = (entry / 'cmdline').read_bytes().decode(errors='replace').rstrip('\0').split('\0')
   166	        except (FileNotFoundError, ProcessLookupError):
   167	            if not entry.exists():
   168	                continue  # exited during the scan
   169	            row['unreadable'] = 'FileNotFoundError: /proc entry file missing'
   170	            rows.append(row)
   171	            continue
   172	        except (OSError, ValueError, IndexError) as error:
   173	            row['unreadable'] = f'{type(error).__name__}: {error}'
   174	            rows.append(row)
   175	            continue
   176	        try:
   177	            exe = os.readlink(entry / 'exe')
   178	            row['exe'] = exe[:-len(' (deleted)')] if exe.endswith(' (deleted)') else exe
   179	        except (FileNotFoundError, ProcessLookupError):
   180	            row['exe'] = None  # zombie, kernel thread, or exited
   181	        except OSError as error:
   182	            # The kernel hides exe of non-dumpable processes (kwin_wayland, ssh-agent)
   183	            # even from their own user. comm and argv still classify the row.
   184	            row['exe'] = None
   185	            row['exe_unreadable'] = f'{type(error).__name__}: {error}'
   186	        # Never retain an authority path.
   187	        row['argv'] = ['<authority-path-redacted>' if index and argv[index - 1] == '-auth' else item
   188	                       for index, item in enumerate(argv)]
   189	        rows.append(row)
   190	    return sorted(rows, key=lambda row: row['pid'])
   191	
   192	
   193	def _target_names(row: dict) -> set[str]:
   194	    argv = row.get('argv') or []
   195	    names = {str(row.get('comm', '')).lower()}
   196	    if row.get('exe'):
   197	        names.add(Path(row['exe']).name.lower())
   198	    if argv:
   199	        names.add(Path(argv[0]).name.lower())
   200	        launcher = Path(argv[0]).name.lower()
   201	        if launcher in WRAPPER_NAMES or re.fullmatch(r'python3(\.[0-9]+)?', launcher):
   202	            script = next((item for item in argv[1:] if item and not item.startswith('-') and '=' not in item),
   203	                          None)
   204	            if script is not None:
   205	                names.add(Path(script).name.lower())
   206	    return names
   207	
   208	
   209	def _launch_chain(proc_root: Path, pid: int) -> set[int]:
   210	    """This process and its ancestors: the operator's own launch, never a target."""
   211	    chain = set()
   212	    while pid > 1 and pid not in chain:
   213	        chain.add(pid)
   214	        try:
   215	            raw = (Path(proc_root) / str(pid) / 'stat').read_text()
   216	            pid = int(raw[raw.rindex(')') + 1:].split()[1])
   217	        except (OSError, ValueError, IndexError):
   218	            break
   219	    return chain
   220	
   221	
   222	def forbidden_processes(rows: list[dict], owned: frozenset | set = frozenset(), *,
   223	                        exclude: frozenset | set = frozenset()) -> list[dict]:
   224	    blocked = []
   225	    for row in rows:
   226	        if row['pid'] in exclude or 'unreadable' in row:
   227	            continue
   228	        if (any(name.startswith(prefix) for name in _target_names(row) for prefix in FORBIDDEN_NAMES)
   229	                and (row['pid'], row['start']) not in owned):
   230	            blocked.append(row)
   231	    return blocked
   232	
   233	
   234	def unreadable_processes(rows: list[dict], *, uid: int | None = None,
   235	                         exclude: frozenset | set = frozenset()) -> list[dict]:
   236	    uid = os.getuid() if uid is None else uid
   237	    return [row for row in rows if 'unreadable' in row and row['pid'] not in exclude
   238	            and row.get('uid') in (uid, None)]
   239	
   240	
   241	def preflight(proc_root: Path, run_dir: Path, *, self_pid: int | None = None) -> dict:
   242	    """Refuse on any target process or any unreadable row of this uid. Nothing is ever signalled."""
   243	    rows = process_inventory(proc_root)
   244	    exclude = _launch_chain(proc_root, os.getpid() if self_pid is None else self_pid)
   245	    forbidden = forbidden_processes(rows, exclude=exclude)
   246	    unreadable = unreadable_processes(rows, exclude=exclude)
   247	    evidence = {'utc': _utc(), 'forbidden_names': list(FORBIDDEN_NAMES), 'forbidden': forbidden,
   248	                'unreadable': unreadable, 'launch_chain_excluded': sorted(exclude),
   249	                'refused': bool(forbidden or unreadable)}
   250	    _write(Path(run_dir) / 'preflight.json', evidence)
   251	    if forbidden:
   252	        raise DiagnosticRefused('preflight found existing Wine, game, Gamescope, or FFmpeg processes')
   253	    if unreadable:
   254	        raise DiagnosticRefused('preflight could not read every /proc entry of this user')
   255	    return evidence
   256	
   257	
   258	def protected_displays(root: Path = Path('/tmp')) -> dict:
   259	    result = {}
   260	    for number in PROTECTED_DISPLAYS:
   261	        entry = {}
   262	        for name, path in (('socket', root / '.X11-unix' / f'X{number}'), ('lock', root / f'.X{number}-lock')):
   263	            try:
   264	                info = os.lstat(path)
   265	                entry[name] = {'exists': True, 'dev': info.st_dev, 'ino': info.st_ino,
   266	                               'mode': info.st_mode, 'uid': info.st_uid, 'mtime_ns': info.st_mtime_ns}
   267	            except FileNotFoundError:
   268	                entry[name] = {'exists': False}
   269	        result[str(number)] = entry
   270	    return result
