   623	def _persist_probe_cleanup_failure(run_dir: Path, error: ProbeCleanupError, tool: dict, *,
   624	                                   expected_head: str, commitment_log: object,
   625	                                   host_reader=_host_identity, survivor: bool = False) -> tuple[dict, str]:
   626	    """Durably record a surviving child; missing start identity is permanently blocking."""
   627	    exact = (type(error.pid) is int and error.pid > 0
   628	             and isinstance(error.pid_start, str) and bool(error.pid_start))
   629	    host = host_reader()
   630	    payload = {'failure_type': 'ffprobe_cleanup_failed',
   631	        'identity': 'exact' if exact else 'unavailable',
   632	        'pid': error.pid if type(error.pid) is int and error.pid > 0 else 0,
   633	        'pid_start': error.pid_start if exact else '',
   634	        'boot_id': host.get('boot_id', '') if isinstance(host, dict) else '',
   635	        'pid_namespace': host.get('pid_namespace', '') if isinstance(host, dict) else '',
   636	        'command': [str(item) for item in error.command] or ['ffprobe'], 'tool': copy.deepcopy(tool),
   637	        'bounded_wait_seconds': [2, 2], 'signal_errors': list(error.signal_errors),
   638	        'recovery': RECOVERY_REQUIREMENT if exact else UNRECOVERABLE_REQUIREMENT}
   639	    return _append_cleanup_record(run_dir, 'failure', payload, expected_head=expected_head,
   640	                                  commitment_log=commitment_log, event='acceptance_failure',
   641	                                  survivor=survivor)
