   273	def process_alive(pid: int, start: str) -> bool:
   274	    try:
   275	        raw = Path(f'/proc/{pid}/stat').read_text()
   276	        fields = raw[raw.rindex(')') + 1:].split()
   277	        # A zombie is exited; only its parent's reap remains.
   278	        return fields[19] == start and fields[0] != 'Z'
   279	    except (OSError, ValueError, IndexError):
   280	        return False
