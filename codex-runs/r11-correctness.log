   283	def kill_owned_identity(identity: dict) -> bool:
   284	    """SIGKILL one recorded owned process through a pidfd, only if its start still matches."""
   285	    pid, start = identity.get('pid'), identity.get('start')
   286	    if type(pid) is not int or pid <= 1 or not isinstance(start, str) or not start:
   287	        return False
   288	    open_pidfd = getattr(os, 'pidfd_open', None)
   289	    send = getattr(signal, 'pidfd_send_signal', None)
   290	    if open_pidfd is None or send is None:
   390	        process.wait(timeout=2)
   391	    except subprocess.TimeoutExpired:
   392	        process.kill()
   393	        try:
   394	            process.wait(timeout=2)
   395	        except subprocess.TimeoutExpired as error:
   396	            raise RuntimeError('diagnostic client survived SIGKILL wait') from error
