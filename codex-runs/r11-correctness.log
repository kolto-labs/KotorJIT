   407	def initialize_cleanup_ledger(run_dir: Path, *, commitment_log: object) -> str:
   408	    run_dir = Path(run_dir)
   409	    validate_commitment_log(commitment_log, run_dir)
   410	    nonce = uuid.uuid4().hex
   411	    payload = _launch_bytes(nonce)
   412	    _exclusive_regular_write(run_dir / CLEANUP_LEDGER, payload)
   413	    head = hashlib.sha256(payload).hexdigest()
   414	    _emit_head(run_dir, commitment_log, event='run_initialized', nonce=nonce, sequence=0,
   415	               head=head, failure_id=None)
   416	    return head
