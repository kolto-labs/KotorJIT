   311	def validate_commitment_log(path: object, run_dir: Path) -> tuple[Path, tuple[int, int]]:
   312	    """Admit only an existing, unique, regular operator file outside the run directory."""
   313	    if path is None or (isinstance(path, str) and not path):
   314	        raise ValueError('cleanup commitment log is required and must be outside the run directory')
   315	    candidate = Path(os.path.abspath(Path(path).expanduser()))
   316	    try:
   317	        info = os.lstat(candidate)
   318	    except FileNotFoundError as error:
   319	        raise ValueError('cleanup commitment log is missing; create it outside the run directory') from error
   320	    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
   321	        raise ValueError('cleanup commitment log must be a unique regular non-symlink file')
   322	    resolved = candidate.resolve(strict=True)
   323	    run = Path(os.path.abspath(Path(run_dir))).resolve()
   324	    if resolved == run or resolved.is_relative_to(run):
   325	        raise ValueError('cleanup commitment log must be outside the run directory')
   326	    if _aliases_run_tree(resolved, (info.st_dev, info.st_ino), run):
   327	        raise ValueError('cleanup commitment log must be outside the run directory '
   328	                         '(it aliases the run tree by device and inode, for example a bind mount)')
   329	    return resolved, (info.st_dev, info.st_ino)
   330	
   331	
   332	def _aliases_run_tree(log: Path, log_identity: tuple[int, int], run: Path) -> bool:
   333	    """Compare the log and its parent chain with every run-tree inode (catches bind mounts)."""
   334	    try:
   335	        run_info = os.stat(run)
   336	    except FileNotFoundError:
   337	        return False  # No run directory yet, so nothing can alias it.
   338	    tree = {(run_info.st_dev, run_info.st_ino)}
   339	    for directory, names, files in os.walk(run, followlinks=False):
   340	        for name in (*names, *files):
   341	            try:
   342	                entry = os.lstat(os.path.join(directory, name))
   343	            except FileNotFoundError:
   344	                continue
   345	            tree.add((entry.st_dev, entry.st_ino))
   346	    chain = {log_identity}
   347	    for parent in log.parents:
   348	        try:
   349	            entry = os.stat(parent)
   350	        except OSError:
   351	            continue
   352	        chain.add((entry.st_dev, entry.st_ino))
   353	    return bool(chain & tree)
