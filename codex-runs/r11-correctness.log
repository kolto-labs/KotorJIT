   644	def _record_surviving_probe(run_dir: Path, error: ProbeCleanupError, tool: dict, *,
   645	                            expected_head: str, commitment_log: object) -> CleanupLedgerChanged:
   646	    """Always leave a blocking record for a surviving FFprobe child, and always say so on stderr."""
   647	    pid = error.pid if type(error.pid) is int and error.pid > 0 else 0
   648	    start = error.pid_start if isinstance(error.pid_start, str) else ''
   649	    command = [str(item) for item in error.command] or ['ffprobe']
   650	    survivor = {'kind': SURVIVOR_KIND, 'run_dir': str(Path(run_dir).resolve()), 'pid': pid,
   651	                'pid_start': start, 'command': command, 'recorded_in_ledger': False,
   652	                'failure_id': None, 'cleanup_ledger_sha256': None, 'head_changed_during_probe': False,
   653	                'ledger_error': None, 'commitment_log_error': None,
   654	                'instruction': SURVIVOR_INSTRUCTION}
   655	    failure = head = None
   656	    try:
   657	        failure, head = _persist_probe_cleanup_failure(run_dir, error, tool, expected_head=expected_head,
   658	                                                       commitment_log=commitment_log, survivor=True)
   659	    except CommitmentLogFailed as log_error:
   660	        failure, head = log_error.record, log_error.cleanup_ledger_sha256
   661	        survivor['head_changed_during_probe'] = log_error.head_changed
   662	        if str(log_error):
   663	            survivor['commitment_log_error'] = str(log_error)
   664	    except (OSError, ValueError) as ledger_error:
   665	        survivor['ledger_error'] = f'{type(ledger_error).__name__}: {ledger_error}'
   666	    if failure is not None:
   667	        survivor.update(recorded_in_ledger=True, failure_id=failure['id'], cleanup_ledger_sha256=head)
   668	        if (error.reaped and failure['payload']['identity'] == 'exact'
   669	                and survivor['commitment_log_error'] is None and not survivor['head_changed_during_probe']):
   670	            payload = {'failure_id': failure['id'], 'failure_digest': failure['record_digest'],
   671	                'pid': failure['payload']['pid'], 'pid_start': failure['payload']['pid_start'],
   672	                'outcome': 'signal_error_reaped', 'pidfd': 'not_needed', 'signal': 'SIGKILL_error',
   673	                'wait': 'confirmed_absent'}
   674	            try:
   675	                _, head = _append_cleanup_record(run_dir, 'resolution', payload, expected_head=head,
   676	                    commitment_log=commitment_log, event='signal_error_reaped', identifier=failure['id'])
   677	            except CommitmentLogFailed as log_error:
   678	                head = log_error.cleanup_ledger_sha256
   679	                survivor['commitment_log_error'] = str(log_error)
   680	            except (OSError, ValueError) as resolution_error:
   681	                # The failure stays unresolved, which keeps the gate blocked.
   682	                survivor['ledger_error'] = f'resolution: {type(resolution_error).__name__}: {resolution_error}'
   683	            survivor['cleanup_ledger_sha256'] = head
   684	    else:
   685	        # The ledger could not take the record: leave an exclusive blocking sidecar.
   686	        try:
   687	            sidecar = Path(run_dir) / f'ffprobe-cleanup-unrecorded-{uuid.uuid4().hex}.json'
   688	            _exclusive_regular_write(sidecar, _canonical_bytes({key: value for key, value in survivor.items()
   689	                                                                if key != 'kind'} | {'utc': _utc_now()}))
   690	            survivor['unrecorded_sidecar'] = sidecar.name
   691	        except OSError as sidecar_error:
   692	            survivor['unrecorded_sidecar_error'] = f'{type(sidecar_error).__name__}: {sidecar_error}'
   693	    print(json.dumps(survivor, sort_keys=True, separators=(',', ':')), file=sys.stderr, flush=True)
   694	    line = {'kind': LEDGER_HEAD_KIND, 'run_dir': survivor['run_dir'], 'failure_id': survivor['failure_id'],
   695	            'cleanup_ledger_sha256': survivor['cleanup_ledger_sha256']}
   696	    return CleanupLedgerChanged(
   697	        f'canonical PTS re-probe cleanup failed: {error}; surviving ffprobe pid={pid} start={start or "unavailable"}; '
   698	        f'failure_id={survivor["failure_id"]}; cleanup_ledger_sha256={survivor["cleanup_ledger_sha256"]}; '
   699	        f'{SURVIVOR_INSTRUCTION}',
   700	        failure_id=survivor['failure_id'], cleanup_ledger_sha256=survivor['cleanup_ledger_sha256'],
   701	        head_line=line, survivor=survivor)
