   429	def cleanup_state_clear(run_dir: Path, expected_sha256: str | None = None) -> bool:
   430	    try:
   431	        if unrecorded_survivors(run_dir):
   432	            return False
   433	        _, raw, failures, resolutions = _load_cleanup_ledger(run_dir)
   434	        return bool((expected_sha256 is None or (_hex(expected_sha256, 64)
   435	                    and hashlib.sha256(raw).hexdigest() == expected_sha256))
   436	                    and set(failures) == set(resolutions))
   437	    except (OSError, ValueError, TypeError, json.JSONDecodeError):
