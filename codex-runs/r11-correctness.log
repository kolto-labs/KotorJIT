   372	def append_commitment_line(commitment_log: object, run_dir: Path, encoded: str) -> None:
   373	    """Re-validate the operator log, then append one line with a single O_APPEND write."""
   374	    path, identity = validate_commitment_log(commitment_log, run_dir)
   375	    descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
   376	    try:
   377	        info = os.fstat(descriptor)
   378	        if (info.st_dev, info.st_ino) != identity or info.st_nlink != 1 or not stat.S_ISREG(info.st_mode):
   379	            raise ValueError('cleanup commitment log identity changed while opening')
   380	        # One O_APPEND write per line keeps concurrent writers from interleaving.
   381	        payload = (encoded + '\n').encode()
   382	        if os.write(descriptor, payload) != len(payload):
   383	            raise OSError('short cleanup commitment log write')
   384	        os.fsync(descriptor)
   385	    finally:
   386	        os.close(descriptor)
