   356	def _emit_head(run_dir: Path, commitment_log: object, *, event: str, nonce: str, sequence: int,
   357	               head: str, failure_id: str | None) -> dict:
   358	    """Write one machine-readable head line to stderr and the operator commitment log."""
   359	    if event not in LEDGER_EVENTS:
   360	        raise ValueError('unknown cleanup ledger event')
   361	    line = {'kind': LEDGER_HEAD_KIND, 'event': event,
   362	            'run_dir': str(Path(os.path.abspath(Path(run_dir))).resolve()), 'nonce': nonce,
   363	            'sequence': sequence, 'cleanup_ledger_sha256': head, 'failure_id': failure_id,
   364	            'utc': _utc_now()}
   365	    encoded = json.dumps(line, sort_keys=True, separators=(',', ':'))
   366	    # stderr is written first so a failing log append still leaves the head visible.
   367	    print(encoded, file=sys.stderr, flush=True)
   368	    append_commitment_line(commitment_log, run_dir, encoded)
   369	    return line
