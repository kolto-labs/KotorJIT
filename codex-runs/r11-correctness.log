   389	def _ledger_lock(run_dir: Path) -> int:
   390	    """Hold an exclusive lock on the run directory for one ledger transition."""
   391	    descriptor = os.open(run_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
   392	    deadline = time.monotonic() + LEDGER_LOCK_TIMEOUT_SECONDS
   393	    try:
   394	        while True:
   395	            try:
   396	                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
   397	                return descriptor
   398	            except BlockingIOError:
   399	                if time.monotonic() >= deadline:
   400	                    raise ValueError('FFprobe cleanup ledger lock is held by another transition')
   401	                time.sleep(.05)
   402	    except BaseException:
   403	        os.close(descriptor)
   404	        raise
