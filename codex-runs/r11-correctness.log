    85	def parse_progress_blocks(raw: bytes) -> tuple[list[FFmpegProgress], bytes]:
    86	    """Parse complete ``-progress`` blocks, retaining an incomplete byte suffix."""
    87	    if not isinstance(raw, bytes):
    88	        raise TypeError('FFmpeg progress input must be bytes')
    89	    complete_lines = raw.split(b'\n')
    90	    suffix_line = complete_lines.pop() if not raw.endswith(b'\n') else b''
    91	    current: dict[bytes, bytes] = {}
    92	    blocks: list[FFmpegProgress] = []
    93	    terminal = False
    94	    consumed_incomplete: list[bytes] = []
    95	    for line in complete_lines:
    96	        if not line:
    97	            continue
    98	        if terminal:
    99	            raise ValueError('FFmpeg progress data follows terminal block')
   100	        if b'=' not in line:
   101	            raise ValueError('malformed FFmpeg progress line')
   102	        key, value = line.split(b'=', 1)
   103	        if not key or key in current:
   104	            raise ValueError('duplicate or empty FFmpeg progress key')
   105	        current[key] = value
   106	        if key != b'progress':
   107	            continue
   108	        if value not in (b'continue', b'end'):
   109	            raise ValueError('unknown FFmpeg progress state')
   110	        for required in (b'frame', b'dup_frames', b'drop_frames'):
   111	            if required not in current:
   112	                raise ValueError('incomplete FFmpeg progress block')
   113	        block = FFmpegProgress(
   114	            _progress_counter(current[b'frame'], 'frame'),
   115	            _progress_counter(current.get(b'out_time_us', b'0'), 'out_time_us'),
   290	        raise ValueError('FFprobe cleanup ledger changed while reading')
   291	    try:
   292	        ledger = json.loads(raw, object_pairs_hook=_unique_object, parse_constant=_reject_constant)
   293	        if raw != _canonical_bytes(ledger):
   294	            raise ValueError('FFprobe cleanup ledger is not canonically encoded')
   295	        if (not isinstance(ledger, dict) or set(ledger) != {'schema', 'nonce', 'records'}
   296	                or not _exact_int(ledger['schema']) or ledger['schema'] != CLEANUP_LEDGER_SCHEMA
   297	                or not _hex(ledger['nonce'], 32) or not isinstance(ledger['records'], list)):
   298	            raise ValueError('malformed FFprobe cleanup ledger')
   299	        # The chain starts at the nonce-bound launch head, so records never
   300	        # transplant between runs.
   301	        previous = hashlib.sha256(_launch_bytes(ledger['nonce'])).hexdigest()
   302	        failures: dict[str, dict] = {}; resolutions: dict[str, dict] = {}
   303	        for sequence, record in enumerate(ledger['records'], 1):
   304	            checked = _validate_cleanup_record(record, sequence, previous, failures, resolutions)
   305	            previous = checked['record_digest']
   306	    except (TypeError, KeyError, AttributeError, IndexError, RecursionError, UnicodeDecodeError) as error:
   307	        raise ValueError(f'malformed FFprobe cleanup ledger: {type(error).__name__}') from error
   308	    return ledger, raw, failures, resolutions
