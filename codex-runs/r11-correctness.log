   458	def record_owned(run_dir: Path, role: str, pid: object, start: object) -> None:
   459	    """Keep the owned-process list current on disk, so a killed child still names its processes."""
   460	    if type(pid) is not int or not isinstance(start, str) or not start:
   461	        return
   462	    path = Path(run_dir) / OWNED_FILE
   463	    try:
   464	        owned = json.loads(path.read_text()) if path.exists() else []
   465	    except (OSError, ValueError):
   466	        owned = []
   467	    owned.append({'role': role, 'pid': pid, 'start': start})
   468	    temporary = path.with_name('.' + path.name + '.tmp')
   469	    temporary.write_text(json.dumps(owned, sort_keys=True) + '\n')
   470	    os.replace(temporary, path)
