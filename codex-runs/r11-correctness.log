   767	def _wait_for_child(process, signals: _SupervisorSignals, deps: 'Dependencies', monotonic=time.monotonic,
   768	                    sleep=time.sleep) -> dict:
   769	    """Wait for the child; after an interrupt or overrun, allow the full cleanup budget."""
   770	    run_deadline = monotonic() + deps.child_run_seconds
   771	    cleanup_deadline = None
   772	    while True:
   773	        code = process.poll()
   774	        if code is not None:
   775	            return {'returncode': code, 'budget_exhausted': False}
   776	        now = monotonic()
   777	        if not signals.forwarded and now >= run_deadline:
   778	            signals.received.append('run_deadline')
   779	            signals.forward()
   780	        if signals.forwarded and cleanup_deadline is None:
   781	            cleanup_deadline = now + deps.cleanup_budget
   782	        if cleanup_deadline is not None and now >= cleanup_deadline:
   783	            return {'returncode': None, 'budget_exhausted': True}
   784	        sleep(.1)
   785	
   786	
   787	def _kill_owned_after_budget(process, owned: list[dict], deps: 'Dependencies') -> dict:
   788	    """Only after the cleanup budget: kill the child's own session group and each recorded identity."""
   789	    evidence = {'child_group_killed': False, 'identities_signalled': [], 'kill_failures': []}
   790	    try:
   791	        os.killpg(process.pid, signal.SIGKILL)  # the child leads its own session
   792	        evidence['child_group_killed'] = True
   793	    except ProcessLookupError:
   794	        pass
   795	    except OSError as error:
   796	        evidence['kill_failures'].append({'role': 'child_group', 'error': f'{type(error).__name__}: {error}'})
   797	    for identity in owned:
   798	        if deps.alive(identity['pid'], identity['start']):
   799	            if deps.kill_owned(identity):
   800	                evidence['identities_signalled'].append(identity)
   801	            else:
   802	                evidence['kill_failures'].append({**identity, 'error': 'kill refused or failed'})
   803	    try:
   804	        process.wait(timeout=2)
   805	    except subprocess.TimeoutExpired:
   806	        evidence['kill_failures'].append({'role': 'child', 'error': 'child not reaped after SIGKILL'})
   807	    time.sleep(.2)
   808	    return evidence
